+    calls,
+    hooks,
+    run,
+    index,
+    snapshot,
+    exposeResult,
+    addPending,
+    append,
+    corruptIndex,
+    indexHead: () => git(root, ["ls-remote", remoteUrl, MAINTENANCE_INDEX_REF]),
