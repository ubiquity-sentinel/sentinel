index 0000000000..0b13845723
--- /dev/null
+++ b/ops/hosted-autonomy-train-land.ts
@@ -0,0 +1,359 @@
+/**
+ * Delivery-train landing and booking (redesign 2026-10-25 C12, WP3.3). The
+ * default branch only ever moves to a train commit whose exact tree passed
+ * the target's complete CI, by a fast-forward-only ref update; the merge
+ * API is never called.
+ *
+ * Landing, in order:
+ * 1. every member passes `trainMemberGate` again (the final task re-read
+ *    and opt-out included) as exactly the manifest's member tuple;
+ * 2. the overlay is re-verified (every member still included on T, C's
+ *    parents are `[T, H_1..H_k]`, its message is this train's manifest and
+ *    `treeChanges(T, C)` is exactly the union of the reviewed patches) and
+ *    the evidence is re-read green;
+ * 3. the tip, read uncached, must be T;
+ * 4. `PATCH refs/heads/<branch> {sha: C, force: false}` (GitHub refuses a
+ *    non-fast-forward);
+ * 5. the tip is read back;
+ * 6. C at (or behind) the tip is landed, whoever's response was lost; a
+ *    moved tip abandons the train (`base_moved`, rebuilt next pass); a
+ *    refused update on an unmoved tip is `landing_refused`, after which the
+ *    target stays on the legacy path, never a racing merge.
+ *
+ * Booking is level-triggered from the landed train commit: each member's
+ * delivery is proven by `resolveTrainDelivery`, a foreign member's proof is
+ * handed to the closure pass, and every member that needs its record moved
+ * to `delivery` (its bound merge intent cleared only by `intentClosable`
+ * with the member) is booked in the pass's one batch write. A Gateway member
+ * also gets its release request (revision C, head H_i, base B0_i).
+ */
+import type { GitSha } from "../src/contracts/brands.ts";
+import {
+  type DeliveryTrainMemberV1,
+  type DeliveryTrainV1,
+  sameDeliveryTrainMemberV1,
+} from "../src/contracts/delivery-train.ts";
+import {
+  gatewayRequestBindsDelivery,
+  isGatewayVpsRepository,
+} from "../src/repair/vps-delivery.ts";
+import { releaseRequestMatchesDelivery } from "../src/repair/loop-records.ts";
+import {
+  computeTrainOverlayV1,
+  type TrainBaseTreeV1,
+  type TrainTreeChangeV1,
+  verifyTrainLandingTreeV1,
+} from "../src/repair/train-overlay.ts";
+import { verifyTrainLandingV1 } from "../src/repair/train-proof.ts";
+import { advanceToDelivery } from "../src/repair/transitions.ts";
+import type { DeliveryBatchV1 } from "./hosted-autonomy-delivery-batch.ts";
+import { buildHostedReleaseRequest } from "./hosted-autonomy-delivery.ts";
+import { resolveTrainDelivery } from "./hosted-autonomy-delivery-proof.ts";
+import { treeChanges } from "./hosted-autonomy-github-trees.ts";
+import { hostedDeliveryKey } from "./hosted-autonomy-policy.ts";
+import { intentClosable } from "./hosted-autonomy-retries.ts";
+import type {
+  HostedAutonomyPassContextV1,
+  HostedAutonomyScopeV1,
+} from "./hosted-autonomy-scopes.ts";
+import {
+  type HostedTrainCommitV1,
+  type HostedTrainGitHubV1,
+  verifyTrainCommitV1,
+} from "./hosted-autonomy-train-build.ts";
+import { trainMemberGate } from "./hosted-autonomy-train-gates.ts";
+import type { HostedAutonomyRecordV1 } from "./hosted-autonomy-types.ts";
+
+export type TrainLandOutcomeV1 =
+  | {
+    readonly kind: "landed";
+    readonly commit: GitSha;
+    readonly tip: GitSha;
+    /** True when GitHub's answer was lost or refused but C is landed. */
+    readonly adopted: boolean;
+  }
+  | { readonly kind: "refused"; readonly reason: string };
+
+async function safely<T>(read: () => Promise<T>): Promise<T | null> {
+  try {
+    return await read();
+  } catch {
+    return null;
+  }
+}
+
+/** Landing steps 1-6 for one train whose commit is `commit`. */
+export async function landTrainV1(input: {
+  readonly context: HostedAutonomyPassContextV1;
+  readonly scope: HostedAutonomyScopeV1;
+  readonly git: HostedTrainGitHubV1;
+  readonly train: DeliveryTrainV1;
+  readonly commit: string;
+  /** T's tree, read this pass. */
+  readonly tree: TrainBaseTreeV1;
+  readonly baseEntries: ReadonlyMap<string, { mode: string; sha: string }>;
+  readonly protectedPaths: readonly string[];
+  /** R_m by record id, read this pass. */
+  readonly patches: ReadonlyMap<string, readonly TrainTreeChangeV1[] | null>;
+  /** Re-reads the evidence; true only for C's complete green CI. */
+  readonly evidence: () => Promise<boolean>;
+}): Promise<TrainLandOutcomeV1> {
+  const { context, scope, git, train, commit } = input;
+  const refuse = (reason: string): TrainLandOutcomeV1 => ({
+    kind: "refused",
+    reason,
+  });
+  const { manifest } = train;
+  // 1. Every member passes the whole member gate again, as its tuple.
+  for (const member of manifest.members) {
+    const record = context.snapshot.work.find((row) =>
+      row.id === member.recordId
+    );
+    if (record === undefined) return refuse(`member_missing:${member.pr}`);
+    const verdict = await trainMemberGate({ context, scope, record });
+    if (!verdict.ok) return refuse(`member:${member.pr}:${verdict.refusal}`);
+    if (!sameDeliveryTrainMemberV1(verdict.admission.member, member)) {
+      return refuse(`member:${member.pr}:changed`);
+    }
+  }
+  // 2. The overlay on T and the built commit, then the evidence.
+  const patches = manifest.members.map((member) =>
+    input.patches.get(member.recordId) ?? null
+  );
+  if (patches.some((patch) => patch === null)) return refuse("overlay_facts");
+  const overlay = computeTrainOverlayV1({
+    base: manifest.base,
+    tree: input.tree,
+    protectedPaths: input.protectedPaths,
+    candidates: manifest.members.map((member, index) => ({
+      member,
+      changes: patches[index],
+    })),
+  });
+  if (overlay.members.length !== manifest.members.length) {
+    return refuse("overlay_changed");
+  }
+  const built = await verifyTrainCommitV1(git, train, commit);
+  if (!built.ok) return refuse(`commit_${built.reason}`);
+  const landedTree = await safely(() => git.readTree(built.commit.tree));
+  if (landedTree === null) return refuse("tree_unreadable");
+  const tree = verifyTrainLandingTreeV1({
+    manifest,
+    parents: built.commit.parents,
+    landed: treeChanges(input.baseEntries, landedTree),
+    members: patches as (readonly TrainTreeChangeV1[])[],
+  });
+  if (!tree.ok) return refuse(`tree_${tree.reason}`);
+  if (!await input.evidence()) return refuse("evidence");
+  // 3. The tip, uncached, is still T.
+  const tip = await context.readTip(scope);
+  if (tip === null) return refuse("tip_unreadable");
+  if (tip !== manifest.base) return refuse("base_moved");
+  // 4-5. Fast-forward only, then read the tip back.
+  const accepted =
+    await safely(() => git.fastForward(manifest.branch, commit)) === true;
+  const after = await context.readTip(scope);
+  // 6. Decide from the tip, never from the lost or refused answer alone.
+  if (after === commit) {
+    return {
+      kind: "landed",
+      commit: commit as GitSha,
+      tip: after as GitSha,
+      adopted: !accepted,
+    };
+  }
+  if (after === null) return refuse("landing_unknown");
+  if (after !== manifest.base) {
+    const reached = await safely(() => git.isAncestor(commit, after));
+    if (reached === true) {
+      return {
+        kind: "landed",
+        commit: commit as GitSha,
+        tip: after as GitSha,
+        adopted: true,
+      };
+    }
+    return refuse(reached === null ? "landing_unknown" : "base_moved");
+  }
+  return refuse(accepted ? "landing_unknown" : "landing_refused");
+}
+
+/** Whether a record still names exactly this member's delivery. */
+function namesMember(
+  record: HostedAutonomyRecordV1,
+  member: DeliveryTrainMemberV1,
+): boolean {
+  return record.id === member.recordId && record.target.pr === member.pr &&
+    record.target.head === member.head &&
+    record.target.base === member.reviewedBase;
+}
+
+/**
+ * Books every member of a landed train (`commit` at or behind `tip`) that is
+ * not done yet: proven by `resolveTrainDelivery`, handed to the closure pass
+ * (foreign) and, when its record must move to `delivery`, added to the
+ * pass's one batch. A member pull request still open after its booking was
+ * written is closed with the delivery comment. Returns the action lines.
+ */
+export async function bookLandedTrainV1(input: {
+  readonly context: HostedAutonomyPassContextV1;
+  readonly scope: HostedAutonomyScopeV1;
+  readonly git: HostedTrainGitHubV1;
+  readonly train: DeliveryTrainV1;
+  readonly commit: HostedTrainCommitV1;
+  readonly tip: string;
+  readonly batch: DeliveryBatchV1;
+}): Promise<{ readonly lines: string[]; readonly pending: number }> {
+  const { context, scope, git, train, commit, tip, batch } = input;
+  const { manifest, trainId } = train;
+  const label =
+    `train:${manifest.repository.owner}/${manifest.repository.name}:${
+      trainId.slice(0, 12)
+    }`;
+  const lines: string[] = [];
+  let pending = 0;
+  for (const member of manifest.members) {
+    const record = context.snapshot.work.find((row) =>
+      row.id === member.recordId
+    );
+    if (record === undefined || record.nextStep === "done") continue;
+    if (!namesMember(record, member)) {
+      lines.push(`${label}:${member.recordId}:record_moved`);
+      continue;
+    }
+    pending++;
+    if (context.settled?.has(record.id) === true) continue;
+    const pull = await context.readPull(scope, member.pr);
+    const landing = await verifyTrainLandingV1({
+      repository: manifest.repository,
+      branch: manifest.branch,
+      recordId: member.recordId,
+      pr: member.pr,
+      head: member.head,
+      commit: {
+        sha: commit.sha as GitSha,
+        parents: commit.parents,
+        message: commit.message,
+      },
+      tip: tip as GitSha,
+      commitReachable: true,
+    });
+    const proof = await resolveTrainDelivery(
+      context,
+      record,
+      scope,
+      pull,
+      landing,
+    );
+    if (proof === null) {
+      lines.push(`${label}:${member.recordId}:booking_unverified`);
+      continue;
+    }
+    const now = context.deps.clock.now();
+    if (!Number.isSafeInteger(now) || now < context.snapshot.updatedAt) {
+      lines.push(`${label}:${member.recordId}:clock_invalid`);
+      continue;
+    }
+    const settledShape = record.nextStep === "delivery" &&
+      record.intent === null && record.wait === null && record.blocker === null;
+    if (
+      record.intent !== null &&
+      !intentClosable(record, context.snapshot.reservations, {
+        pr: member.pr,
+        head: member.head,
+      })
+    ) {
+      lines.push(`${label}:${member.recordId}:intent_open`);
+      continue;
+    }
+    let delivered: HostedAutonomyRecordV1;
+    try {
+      delivered = advanceToDelivery({ ...record, intent: null }, now);
+    } catch {
+      lines.push(`${label}:${member.recordId}:snapshot_invalid`);
+      continue;
+    }
+    if (isGatewayVpsRepository(record.repository)) {
+      const request = await buildHostedReleaseRequest(
+        record.repository,
+        commit.sha,
+        member.head,
+        member.reviewedBase,
+        member.pr,
+        proof.receipt,
+        now,
+      );
+      if (
+        request === null ||
+        !await gatewayRequestBindsDelivery(
+          request,
+          delivered,
+          proof.receipt,
+          commit.sha,
+        )
+      ) {
+        lines.push(`${label}:${member.recordId}:request_unbindable`);
+        continue;
+      }
+      if (
+        context.snapshot.releaseRequests.some((existing) =>
+          existing.id === request.id ||
+          releaseRequestMatchesDelivery(existing, record)
+        )
+      ) {
+        lines.push(`${label}:${member.recordId}:already_recorded`);
+        continue;
+      }
+      batch.add({
+        before: record,
+        after: delivered,
+        request,
+        done: `${label}:${member.recordId}:booked:sha=${commit.sha}`,
+        revision: commit.sha,
+        now,
+      });
+      continue;
+    }
+    // A foreign member closes through its own repository's closure pass,
+    // from exactly this proof.
+    context.foreignMerged.set(
+      hostedDeliveryKey(
+        record.repository,
+        member.pr,
+        member.head,
+        member.reviewedBase,
+      ),
+      proof,
+    );
+    if (!settledShape) {
+      batch.add({
+        before: record,
+        after: delivered,
+        request: null,
+        done: `${label}:${member.recordId}:booked:sha=${commit.sha}`,
+        revision: commit.sha,
+        now,
+      });
+      continue;
+    }
+    lines.push(`${label}:${member.recordId}:delivered`);
+    // Booked in an earlier pass and still open: GitHub did not mark it
+    // merged by the fast-forward, so the App closes it with the delivery.
+    if (pull !== null && pull.state === "open" && pull.merged === false) {
+      const closed = await safely(() =>
+        git.closePull(
+          member.pr,
+          `Delivered in ${commit.sha} (Sentinel delivery train ${
+            trainId.slice(0, 12)
+          })`,
+        )
+      );
+      lines.push(
+        `${label}:${member.recordId}:pull_${
+          closed === true ? "closed" : "close_refused"
+        }`,
+      );
+    }
+  }
+  return { lines, pending };
+}
diff --git a/ops/hosted-autonomy-train-pass.ts b/ops/hosted-autonomy-train-pass.ts
new file mode 100644
index 0000000000..661ad85d00
--- /dev/null
+++ b/ops/hosted-autonomy-train-pass.ts
@@ -0,0 +1,390 @@
+/**
+ * The launcher's `train` phase (redesign 2026-10-25 C12, WP3.3): after
+ * `retry`, before `delivery`, and only for targets whose
+ * `deliveryTrainModeV1` is not `off` (every target is `off`, so the runner
+ * does not even add the phase). Level-triggered and self-certifying: each
+ * pass re-derives everything from the tip T, the digest-named
+ * `sentinel-train/*` refs and their commits' manifests, the checks on those
+ * commits and the member gate; no state collection is added.
+ *
+ * Per target, in order: book every member of a landed train (its commit is
+ * T or behind it); gate the target's records into admissible members and
+ * read their reviewed patches; derive the ejected members from red
+ * singleton trains; select the active train. `plan_only` stops there with
+ * one sanitized plan line and writes nothing at all. `on` then deletes
+ * void, invalid and abandoned train refs, and either builds a new train
+ * (overlay on T, Git Data API, one CI request) or advances the active one
+ * by the bisection decision: land a green prefix (fast-forward only), name
+ * an ejection, wait, or do its CI work (probe builds, requests, reruns).
+ * Every booking of the pass lands in one batch write (C11).
+ */
+import type { GitSha } from "../src/contracts/brands.ts";
+import {
+  deliveryTrainIdV1,
+  deliveryTrainManifestV1,
+  type DeliveryTrainMemberV1,
+  deliveryTrainV1,
+  parseDeliveryTrainCommitMessageV1,
+} from "../src/contracts/delivery-train.ts";
+import type { RepositoryIdentityV1 } from "../src/contracts/shared.ts";
+import { RecordParseError } from "../src/contracts/validation.ts";
+import { createLocalRepositoryConfig } from "../src/host/local-config.ts";
+import { selectTrustedTargetPolicyV1 } from "../src/host/target-policy.ts";
+import {
+  type TrainCiFactV1,
+  trainEjectedMembersV1,
+} from "../src/repair/train-bisect.ts";
+import {
+  computeTrainOverlayV1,
+  trainBaseTreeFromEntries,
+  type TrainBaseTreeV1,
+  type TrainTreeChangeV1,
+} from "../src/repair/train-overlay.ts";
+import {
+  selectActiveTrainV1,
+  trainBuildCandidatesV1,
+} from "../src/repair/train-plan.ts";
+import {
+  DeliveryBatchV1,
+  writeDeliveryBatch,
+} from "./hosted-autonomy-delivery-batch.ts";
+import {
+  hostedRepositoryKey,
+  isHostedSelf,
+  sameRepository,
+} from "./hosted-autonomy-policy.ts";
+import {
+  type HostedAutonomyPassContextV1,
+  hostedPassDeadlineReached,
+} from "./hosted-autonomy-scopes.ts";
+import type { HostedTrainGitHubV1 } from "./hosted-autonomy-train-build.ts";
+import { trainBaseRedV1 } from "./hosted-autonomy-train-ci.ts";
+import {
+  hostedDeliveryTrainMode,
+  trainMemberGate,
+  trainMemberStaticRefusal,
+} from "./hosted-autonomy-train-gates.ts";
+import { bookLandedTrainV1 } from "./hosted-autonomy-train-land.ts";
+import {
+  advanceTrain,
+  buildAndRequest,
+  commitFact,
+  type TargetV1,
+  type TrainEntryV1,
+} from "./hosted-autonomy-train-advance.ts";
+import type { HostedAutonomyResultV1 } from "./hosted-autonomy-types.ts";
+
+async function safely<T>(read: () => Promise<T>): Promise<T | null> {
+  try {
+    return await read();
+  } catch {
+    return null;
+  }
+}
+
+/** The repositories of the snapshot whose train mode is not `off`. */
+function trainRepositories(
+  context: HostedAutonomyPassContextV1,
+): RepositoryIdentityV1[] {
+  const seen = new Map<string, RepositoryIdentityV1>();
+  for (const record of context.snapshot.work) {
+    const key = hostedRepositoryKey(record.repository);
+    if (
+      seen.has(key) || isHostedSelf(record.repository) ||
+      hostedDeliveryTrainMode(context.deps, record.repository) === "off"
+    ) continue;
+    seen.set(key, record.repository);
+  }
+  return [...seen.entries()].sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)
+    .map(([, repository]) => repository);
+}
+
+/** The phase entry: null when it wrote nothing (no booking). */
+export async function runHostedTrainPass(
+  context: HostedAutonomyPassContextV1,
+): Promise<HostedAutonomyResultV1 | null> {
+  if (context.deps.queueCustody?.ready === false) return null;
+  const batch = new DeliveryBatchV1();
+  for (const repository of trainRepositories(context)) {
+    if (hostedPassDeadlineReached(context)) {
+      context.actions.push("continuation:train:deferred_deadline");
+      break;
+    }
+    const mode = hostedDeliveryTrainMode(context.deps, repository);
+    await runTarget(context, repository, mode === "on", batch);
+  }
+  return await writeDeliveryBatch(context, batch);
+}
+
+/** Every `sentinel-train/*` ref with a readable commit, parsed. */
+async function readTrains(
+  git: HostedTrainGitHubV1,
+): Promise<{ entries: TrainEntryV1[]; invalid: string[] } | null> {
+  const refs = await safely(() => git.listTrainRefs());
+  if (refs === null) return null;
+  const entries: TrainEntryV1[] = [];
+  const invalid: string[] = [];
+  for (const { ref, sha } of [...refs].sort((a, b) => a.ref < b.ref ? -1 : 1)) {
+    const commit = await safely(() => git.readCommit(sha));
+    if (commit === null) continue;
+    try {
+      const train = await parseDeliveryTrainCommitMessageV1(commit.message);
+      entries.push({ ref, train, commit });
+    } catch (error) {
+      if (!(error instanceof RecordParseError)) throw error;
+      invalid.push(ref);
+    }
+  }
+  return { entries, invalid };
+}
+
+async function runTarget(
+  context: HostedAutonomyPassContextV1,
+  identity: RepositoryIdentityV1,
+  on: boolean,
+  batch: DeliveryBatchV1,
+): Promise<void> {
+  const { actions } = context;
+  const repository = { owner: identity.owner, name: identity.name };
+  const label = `train:${identity.owner}/${identity.name}`;
+  const scope = await context.scopeFor(identity);
+  const surface = scope.surface;
+  const git = surface?.train;
+  if (surface === null || git === undefined || scope.baseBranch === null) {
+    actions.push(`${label}:surface_incapable`);
+    return;
+  }
+  const tip = await context.readTip(scope);
+  if (tip === null || !/^[0-9a-f]{40}$/.test(tip)) {
+    actions.push(`${label}:tip_unreadable`);
+    return;
+  }
+  const read = await readTrains(git);
+  if (read === null) {
+    actions.push(`${label}:refs_unreadable`);
+    return;
+  }
+  const target: TargetV1 = {
+    context,
+    scope,
+    surface,
+    git,
+    repository,
+    branch: scope.baseBranch,
+    tip: tip as GitSha,
+    label,
+    batch,
+  };
+  const mine = read.entries.filter(({ train }) =>
+    train.manifest.repository.owner === identity.owner &&
+    train.manifest.repository.name === identity.name &&
+    train.manifest.branch === target.branch
+  );
+  // A landed train: its commit is T, or (built on an earlier base) T's
+  // ancestor. Its members are booked; its ref is kept until none is pending.
+  const landed: TrainEntryV1[] = [];
+  // Unproven ancestry is neither landed nor abandoned: such a ref is kept,
+  // because a landed train's ref is its members' booking evidence.
+  const unproven = new Set<string>();
+  for (const entry of mine) {
+    if (entry.train.manifest.base === tip) continue;
+    const reached = entry.commit.sha === tip ||
+      await safely(() => git.isAncestor(entry.commit.sha, tip));
+    if (reached === true) landed.push(entry);
+    else if (reached === null) unproven.add(entry.train.trainId);
+  }
+  const deletions = new Set<string>(read.invalid);
+  for (const entry of landed) {
+    if (!on) continue;
+    const booked = await bookLandedTrainV1({
+      context,
+      scope,
+      git,
+      train: entry.train,
+      commit: entry.commit,
+      tip,
+      batch,
+    });
+    actions.push(...booked.lines);
+    if (booked.pending === 0) deletions.add(entry.ref);
+  }
+  const admitted = await admitMembers(target);
+  const tree = await readBaseTree(git, tip);
+  const singles = await singletonFacts(target, read.entries, admitted.members);
+  const baseRed = await trainBaseRedV1(surface, tip);
+  const ejected = trainEjectedMembersV1(singles, baseRed);
+  const selection = selectActiveTrainV1({
+    repository,
+    branch: target.branch,
+    base: target.tip,
+    trains: mine.filter((entry) => !landed.includes(entry)),
+    admissible: admitted.members,
+    ejected,
+  });
+  const protectedPaths = targetProtectedPaths(identity);
+  const overlay = selection.active === null && tree !== null
+    ? computeTrainOverlayV1({
+      base: target.tip,
+      tree: tree.base,
+      protectedPaths,
+      candidates: trainBuildCandidatesV1(admitted.members, ejected).map(
+        (member) => ({
+          member,
+          changes: admitted.patches.get(member.recordId) ?? null,
+        }),
+      ),
+    })
+    : null;
+  const deferred =
+    overlay?.results.filter((result) => result.disposition !== "included")
+      .length ?? 0;
+  actions.push(
+    `${label}:plan:mode=${
+      on ? "on" : "plan_only"
+    }:admitted=${admitted.members.length}:members=${
+      selection.active?.train.manifest.members.length ??
+        overlay?.members.length ?? 0
+    }:ejected=${ejected.length}:deferred=${deferred}:landed=${landed.length}:active=${
+      selection.active?.train.trainId.slice(0, 12) ?? "none"
+    }`,
+  );
+  if (!on) return;
+  for (
+    const id of [
+      ...selection.void,
+      ...selection.obsolete.filter((id) =>
+        !landed.some((entry) => entry.train.trainId === id) &&
+        !unproven.has(id)
+      ),
+    ]
+  ) {
+    const entry = mine.find((row) => row.train.trainId === id);
+    if (entry !== undefined) deletions.add(entry.ref);
+  }
+  for (const ref of selection.invalid) deletions.add(ref);
+  for (const ref of [...deletions].sort()) {
+    const deleted = await safely(() => git.deleteRef(ref));
+    const id = ref.slice("refs/heads/sentinel-train/".length);
+    actions.push(
+      `${label}:ref_${deleted === true ? "deleted" : "delete_refused"}:${
+        /^[0-9a-f]{64}$/.test(id) ? id.slice(0, 12) : "invalid"
+      }`,
+    );
+  }
+  if (tree === null) {
+    actions.push(`${label}:base_tree_unreadable`);
+    return;
+  }
+  if (selection.active === null) {
+    await buildNew(target, overlay!.members, overlay!.changes, mine);
+    return;
+  }
+  await advanceTrain(target, selection.active.train, mine, {
+    tree,
+    protectedPaths,
+    patches: admitted.patches,
+    baseRed,
+  });
+}
+
+/** Gate every record of the target; read each admitted member's patch. */
+async function admitMembers(target: TargetV1): Promise<{
+  members: DeliveryTrainMemberV1[];
+  patches: Map<string, readonly TrainTreeChangeV1[] | null>;
+}> {
+  const { context, scope, surface } = target;
+  const members: DeliveryTrainMemberV1[] = [];
+  const patches = new Map<string, readonly TrainTreeChangeV1[] | null>();
+  for (const record of context.snapshot.work) {
+    if (
+      !sameRepository(record.repository, scope.repository) ||
+      context.settled?.has(record.id) === true ||
+      trainMemberStaticRefusal(
+          context.snapshot,
+          record,
+          context.deps.queueCustody,
+          context.closedIssues,
+        ) !== null
+    ) continue;
+    if (hostedPassDeadlineReached(context)) break;
+    const verdict = await trainMemberGate({ context, scope, record });
+    if (!verdict.ok) {
+      context.actions.push(
+        `${target.label}:gate:${record.id}:${verdict.refusal}`,
+      );
+      continue;
+    }
+    const { member } = verdict.admission;
+    members.push(member);
+    const read = surface.mergeBaseTreeChanges === undefined
+      ? null
+      : await safely(() =>
+        surface.mergeBaseTreeChanges!(member.reviewedBase, member.head)
+      );
+    patches.set(member.recordId, read?.changes ?? null);
+  }
+  return { members, patches };
+}
+
+async function readBaseTree(git: HostedTrainGitHubV1, tip: string): Promise<
+  {
+    base: TrainBaseTreeV1;
+    entries: ReadonlyMap<string, { mode: string; sha: string }>;
+  } | null
+> {
+  const commit = await safely(() => git.readCommit(tip));
+  if (commit === null) return null;
+  const entries = await safely(() => git.readTree(commit.tree));
+  return entries === null
+    ? null
+    : { base: trainBaseTreeFromEntries(entries), entries };
+}
+
+function targetProtectedPaths(repository: RepositoryIdentityV1): string[] {
+  return [
+    ...selectTrustedTargetPolicyV1(createLocalRepositoryConfig(), repository)
+      .protectedPaths,
+  ];
+}
+
+/** The singleton trains `(T, [m])` that exist for admitted members. */
+async function singletonFacts(
+  target: TargetV1,
+  entries: readonly TrainEntryV1[],
+  members: readonly DeliveryTrainMemberV1[],
+): Promise<{ member: DeliveryTrainMemberV1; ci: TrainCiFactV1 | null }[]> {
+  const facts = [];
+  for (const member of members) {
+    const id = await deliveryTrainIdV1(deliveryTrainManifestV1({
+      repository: target.repository,
+      branch: target.branch,
+      base: target.tip,
+      members: [member],
+    }));
+    const entry = entries.find((row) => row.train.trainId === id);
+    if (entry === undefined) continue;
+    facts.push({ member, ci: await commitFact(target, entry) });
+  }
+  return facts;
+}
+
+/** Build a new train from the overlay's included members; request its CI. */
+async function buildNew(
+  target: TargetV1,
+  members: readonly DeliveryTrainMemberV1[],
+  changes: readonly TrainTreeChangeV1[],
+  entries: readonly TrainEntryV1[],
+): Promise<void> {
+  const { context, label } = target;
+  if (members.length === 0) {
+    context.actions.push(`${label}:idle`);
+    return;
+  }
+  const train = await deliveryTrainV1(deliveryTrainManifestV1({
+    repository: target.repository,
+    branch: target.branch,
+    base: target.tip,
+    members,
+  }));
+  await buildAndRequest(target, train, changes, entries);
+}
