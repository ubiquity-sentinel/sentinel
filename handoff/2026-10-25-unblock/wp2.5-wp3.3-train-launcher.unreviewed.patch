new file mode 100644
index 0000000000..a1bcffad94
--- /dev/null
+++ b/ops/hosted-autonomy-train-ci.ts
@@ -0,0 +1,252 @@
+/**
+ * Delivery-train CI (redesign 2026-10-25 C12, WP3.3): the target's OWN
+ * complete CI on the exact train commit C, requested and read by the
+ * launcher; never a merge API run and never post-merge evidence.
+ *
+ * - Request (`trainCiPolicyV1`): Passport gets an App-authored train pull
+ *   request (head `sentinel-train/<id>`, base the default branch, a manifest
+ *   summary with no closing keyword) for its `pull_request` CI; its
+ *   never-started jobs are the backup-CI path's (C7) and read through the
+ *   same check listing. ai.ubq.fi gets the `train` dispatch kind of the
+ *   pre-merge workflow, suppressed while a run is bound to C.
+ * - Facts: `missing` (no run on C yet), `pending` (running, or completed
+ *   without a started failure: never-started jobs are pending, never red),
+ *   `green` (`hasAllChecksGreen(C, T)`: every check green and every check
+ *   T's suites expect present), `red` with the started failures' names and
+ *   whether they are already a rerun's.
+ * - Tree identity: a one-member train whose head H descends from T has
+ *   exactly H's tree, so H's own complete green CI against T is C's
+ *   evidence and no new CI is requested.
+ * Unreadable is null everywhere, which never lands anything.
+ */
+import {
+  deliveryTrainBranchV1,
+  type DeliveryTrainV1,
+} from "../src/contracts/delivery-train.ts";
+import {
+  trainPremergeCiRequestV1,
+  trainPremergeDispatchSuppressed,
+} from "../src/host/actions-premerge-ci.ts";
+import { trainCiPolicyV1 } from "../src/host/target-policy.ts";
+import {
+  CANDIDATE_CONCLUSIONS,
+  RED_BASE_CONCLUSIONS,
+} from "../src/repair/ci-rejection.ts";
+import type { TrainCiFactV1 } from "../src/repair/train-bisect.ts";
+import { HOSTED_AUTONOMY_TRUSTED_APP_AUTHOR } from "./hosted-autonomy-policy.ts";
+import type {
+  HostedTrainCommitV1,
+  HostedTrainGitHubV1,
+} from "./hosted-autonomy-train-build.ts";
+import type {
+  HostedAutonomyGitHubV1,
+  HostedAutonomyHeadRunV1,
+} from "./hosted-autonomy-types.ts";
+
+async function safely<T>(read: () => Promise<T>): Promise<T | null> {
+  try {
+    return await read();
+  } catch {
+    return null;
+  }
+}
+
+function failedRun(run: HostedAutonomyHeadRunV1): boolean {
+  return run.status === "completed" && run.conclusion !== null &&
+    CANDIDATE_CONCLUSIONS.includes(run.conclusion);
+}
+
+/**
+ * The required checks red on T itself (the base attribution input), or null
+ * when T's CI cannot be read. Never-started jobs are not red.
+ */
+export async function trainBaseRedV1(
+  surface: HostedAutonomyGitHubV1,
+  base: string,
+): Promise<readonly string[] | null> {
+  if (surface.failedChecks === undefined) return null;
+  return await safely(() => surface.failedChecks!(base, RED_BASE_CONCLUSIONS));
+}
+
+/**
+ * One-member tree identity: H descends from T and C's tree is H's tree, so
+ * H's complete green CI against T (every check T's suites expect) is C's.
+ */
+export async function trainTreeIdentityGreenV1(input: {
+  readonly git: HostedTrainGitHubV1;
+  readonly surface: HostedAutonomyGitHubV1;
+  readonly train: DeliveryTrainV1;
+  readonly commit: HostedTrainCommitV1;
+}): Promise<boolean> {
+  const { git, surface, train, commit } = input;
+  if (train.manifest.members.length !== 1) return false;
+  const head = train.manifest.members[0].head;
+  const base = train.manifest.base;
+  if (await safely(() => git.isAncestor(base, head)) !== true) return false;
+  const headCommit = await safely(() => git.readCommit(head));
+  if (headCommit === null || headCommit.tree !== commit.tree) return false;
+  return await safely(() => surface.hasAllChecksGreen(head, base)) === true;
+}
+
+/** The CI fact of one train commit C on base T (null: unreadable). */
+export async function readTrainCiFactV1(input: {
+  readonly surface: HostedAutonomyGitHubV1;
+  readonly commit: string;
+  readonly base: string;
+  readonly now: number;
+}): Promise<TrainCiFactV1 | null> {
+  const { surface, commit, base, now } = input;
+  if (surface.listHeadRuns === undefined) return null;
+  const runs = await safely(() => surface.listHeadRuns!(commit));
+  if (runs === null) return null;
+  if (runs.length === 0) return { state: "missing" };
+  const since = Math.min(...runs.map((run) => run.createdAt ?? now));
+  if (runs.some((run) => run.status !== "completed")) {
+    return { state: "pending", since };
+  }
+  const green = await safely(() => surface.hasAllChecksGreen(commit, base));
+  if (green === true) return { state: "green" };
+  if (surface.failedChecks === undefined) return null;
+  const failed = await safely(() =>
+    surface.failedChecks!(commit, CANDIDATE_CONCLUSIONS)
+  );
+  if (failed === null) return null;
+  // Completed but neither green nor red: a never-started job (backup CI
+  // stands in for it), a cancelled run or a missing expected check.
+  if (failed.length === 0) return { state: "pending", since };
+  const reds = runs.filter(failedRun);
+  return {
+    state: "red",
+    failed: [...new Set(failed)].sort(),
+    rerun: reds.length === 0 || reds.every((run) => run.runAttempt > 1),
+  };
+}
+
+/**
+ * Approve the workflow runs GitHub parked for approval on train commit C (a
+ * bot-pushed ref), at most three per pass, exactly as the delivery pass
+ * approves a candidate head's. Null when nothing is parked.
+ */
+export async function approveTrainRunsV1(
+  surface: HostedAutonomyGitHubV1,
+  commit: string,
+): Promise<string | null> {
+  const parked = await safely(() => surface.listParkedRuns(commit)) ?? [];
+  if (parked.length === 0) return null;
+  let approved = 0;
+  for (const id of parked.slice(0, 3)) {
+    if (await safely(() => surface.approveRun(id)) === true) approved++;
+  }
+  return `ci_approved:runs=${Math.min(parked.length, 3)}:approved=${approved}`;
+}
+
+/** The train pull request body: a manifest summary, no closing keyword. */
+export function trainPullBodyV1(
+  train: DeliveryTrainV1,
+  commit: string,
+): string {
+  const members = train.manifest.members.map((member) =>
+    `- #${member.pr} (issue ${member.issueNumber}, head ${member.head})`
+  );
+  return [
+    `Sentinel delivery train ${train.trainId}`,
+    "",
+    `Base: ${train.manifest.base}`,
+    `Commit: ${commit}`,
+    "",
+    "Members:",
+    ...members,
+    "",
+    `This pull request only runs CI on the exact train commit. Sentinel lands it by a fast-forward of ${train.manifest.branch} once that CI is green and never through the merge API.`,
+  ].join("\n");
+}
+
+/** Request the target's own CI for train commit C, once (idempotent). */
+export async function requestTrainCiV1(input: {
+  readonly git: HostedTrainGitHubV1;
+  readonly surface: HostedAutonomyGitHubV1;
+  readonly train: DeliveryTrainV1;
+  readonly commit: string;
+}): Promise<string> {
+  const { git, surface, train, commit } = input;
+  const { repository, branch } = train.manifest;
+  const policy = trainCiPolicyV1(repository);
+  const trainBranch = deliveryTrainBranchV1(train.trainId);
+  if (policy === null) return "ci_policy_absent";
+  if (policy.kind === "pull_request") {
+    const pulls = await safely(() => git.listBranchPulls(trainBranch));
+    if (pulls === null) return "ci_unreadable";
+    if (pulls.some((pull) => pull.state === "open")) return "ci_requested";
+    if (pulls.length > 0) return "ci_pull_closed";
+    const number = await safely(() =>
+      git.openPull({
+        head: trainBranch,
+        base: branch,
+        title: `Sentinel delivery train ${train.trainId.slice(0, 12)}`,
+        body: trainPullBodyV1(train, commit),
+      })
+    );
+    return number === null ? "ci_refused" : `ci_pull_opened:pr=${number}`;
+  }
+  const runs = surface.listHeadRuns === undefined
+    ? null
+    : await safely(() => surface.listHeadRuns!(commit));
+  if (trainPremergeDispatchSuppressed(runs === null ? null : runs.length)) {
+    return runs === null ? "ci_unreadable" : "ci_requested";
+  }
+  return await dispatchTrainCi(git, train);
+}
+
+async function dispatchTrainCi(
+  git: HostedTrainGitHubV1,
+  train: DeliveryTrainV1,
+): Promise<string> {
+  const request = trainPremergeCiRequestV1(train.manifest.repository, {
+    trainBranch: deliveryTrainBranchV1(train.trainId),
+    baseBranch: train.manifest.branch,
+    base: train.manifest.base,
+    trustedAuthor: HOSTED_AUTONOMY_TRUSTED_APP_AUTHOR,
+  });
+  if (request === null) return "ci_policy_absent";
+  return await safely(() => git.dispatchWorkflow(request)) === true
+    ? "ci_dispatched"
+    : "ci_refused";
+}
+
+/**
+ * The one rerun of a red train's failed jobs, or the re-request of a train
+ * pending past its bound (same train id, no blame): a dispatch target is
+ * dispatched again; a pull request target re-runs its completed failed or
+ * never-started runs.
+ */
+export async function rerunTrainCiV1(input: {
+  readonly git: HostedTrainGitHubV1;
+  readonly surface: HostedAutonomyGitHubV1;
+  readonly train: DeliveryTrainV1;
+  readonly commit: string;
+  readonly mode: "rerun" | "rerequest";
+}): Promise<string> {
+  const { git, surface, train, commit, mode } = input;
+  const policy = trainCiPolicyV1(train.manifest.repository);
+  if (policy === null) return "ci_policy_absent";
+  if (mode === "rerequest" && policy.kind === "dispatch") {
+    return await dispatchTrainCi(git, train);
+  }
+  if (surface.listHeadRuns === undefined || !surface.rerunFailedJobs) {
+    return "ci_rerun_unavailable";
+  }
+  const runs = await safely(() => surface.listHeadRuns!(commit));
+  if (runs === null) return "ci_unreadable";
+  const targets = runs.filter((run) =>
+    run.status === "completed" && run.conclusion !== "success" &&
+    (mode === "rerequest" || (failedRun(run) && run.runAttempt === 1))
+  );
+  if (targets.length === 0) return "ci_rerun_unavailable";
+  let accepted = 0;
+  for (const run of targets) {
+    if (await safely(() => surface.rerunFailedJobs!(run.id)) === true) {
+      accepted++;
+    }
+  }
+  return `ci_rerun:runs=${targets.length}:accepted=${accepted}`;
+}
diff --git a/ops/hosted-autonomy-train-gates.ts b/ops/hosted-autonomy-train-gates.ts
new file mode 100644
index 0000000000..08bd2692ae
--- /dev/null
+++ b/ops/hosted-autonomy-train-gates.ts
@@ -0,0 +1,297 @@
+/**
+ * The delivery-train member gate (redesign 2026-10-25 C12, WP3.3). A record
+ * rides a train only when every gate the direct path's `preMergeGate` holds
+ * holds for it too, minus the base equality and the moved-base reads (a
+ * train lands the literal reviewed head on a newer tip whose own tree is
+ * tested instead):
+ *
+ * - shape: delivery eligible (a parked record only under the closed spent
+ *   shape), not owner gated, issue-backed with a PR, head, base and its
+ *   deterministic branch, not queue protected, no takeover custody, and no
+ *   intent other than the runtime's merge intent bound to (pr, head);
+ * - authority: the LATEST completed current-head review authorizes it over
+ *   the trusted task statement read now (no unresolved P0; a carried review
+ *   never makes a train member), the source is not opted out, and no
+ *   production release request already records the delivery;
+ * - the pull request: open, at the record head, App-authored, on the
+ *   default branch (`pullBaseRefRefusal`);
+ * - CI: the exact head's required CI is green with the reviewed base's
+ *   expected checks (`headCiRefusal`, #154 coverage);
+ * - the spent gates (`spentMergeRefusal`: the source issue is open and a
+ *   Gateway request provably binds) and the protected paths
+ *   (`protectedPathRefusal`).
+ *
+ * Every gate is the shared one; nothing here relaxes or duplicates a rule.
+ * Landing re-runs this gate for every member immediately before the ref
+ * update, which is the final task re-read and opt-out.
+ */
+import type { WorkItemId } from "../src/contracts/brands.ts";
+import type { DeliveryTrainMemberV1 } from "../src/contracts/delivery-train.ts";
+import type { ReviewReceiptV1 } from "../src/contracts/review-receipt.ts";
+import type { RepairStateSnapshotV1 } from "../src/contracts/state-snapshots.ts";
+import { hasTakeoverCustody } from "../src/github/existing-pr-takeover-provenance.ts";
+import { QUEUE_PROOF_ACTIVATED } from "../src/github/queue-runtime-policy.ts";
+import { candidateBranch } from "../src/repair/keys.ts";
+import { isGatewayVpsRepository } from "../src/repair/vps-delivery.ts";
+import {
+  DELIVERY_TRAIN_CANDIDATE_TARGETS,
+  type DeliveryTrainModeV1,
+  deliveryTrainModeV1,
+} from "../src/host/target-policy.ts";
+import type { RepositoryIdentityV1 } from "../src/contracts/shared.ts";
+import { acceptanceOwnerGated } from "./hosted-autonomy-acceptance.ts";
+import {
+  boundReviewReceipts,
+  readTrustedTask,
+} from "./hosted-autonomy-delivery.ts";
+import {
+  headCiRefusal,
+  protectedPathRefusal,
+  pullBaseRefRefusal,
+} from "./hosted-autonomy-merge-gates.ts";
+import {
+  deliveryEligible,
+  HOSTED_AUTONOMY_TRUSTED_APP_AUTHOR,
+  isHostedSelf,
+  sameRepository,
+} from "./hosted-autonomy-policy.ts";
+import {
+  type HostedQueueCustodyContext,
+  queueRecordProtected,
+} from "./hosted-autonomy-queue-context.ts";
+import type {
+  HostedAutonomyPassContextV1,
+  HostedAutonomyScopeV1,
+} from "./hosted-autonomy-scopes.ts";
+import {
+  latestAuthorizingReceipt,
+  parkedStep,
+  spentDeliveryAdmissible,
+  spentMergeRefusal,
+} from "./hosted-autonomy-spent-delivery.ts";
+import type {
+  HostedAutonomyDepsV1,
+  HostedAutonomyPullV1,
+  HostedAutonomyRecordV1,
+} from "./hosted-autonomy-types.ts";
+
+/**
+ * The train mode the launcher applies to one repository: the trusted code
+ * policy (`deliveryTrainModeV1`, every target `off`), or a test's override.
+ * The self target is never a train target.
+ */
+export function hostedDeliveryTrainMode(
+  deps: Pick<HostedAutonomyDepsV1, "deliveryTrainMode">,
+  repository: RepositoryIdentityV1,
+): DeliveryTrainModeV1 {
+  if (isHostedSelf(repository)) return "off";
+  return deps.deliveryTrainMode?.(repository) ??
+    deliveryTrainModeV1(repository);
+}
+
+/**
+ * True when the runner must add its `train` phase: some candidate target is
+ * not `off` (or a test overrides the mode). With every target `off` the
+ * phase list, its timing line and every progress line are unchanged.
+ */
+export function trainPhaseActive(
+  deps: Pick<HostedAutonomyDepsV1, "deliveryTrainMode">,
+): boolean {
+  return deps.deliveryTrainMode !== undefined ||
+    DELIVERY_TRAIN_CANDIDATE_TARGETS.some((target) =>
+      deliveryTrainModeV1(target) !== "off"
+    );
+}
+
+/** Why a record does not ride a train this pass (a closed vocabulary). */
+export type TrainMemberRefusalV1 =
+  | "train_self"
+  | "not_eligible"
+  | "spent_not_admissible"
+  | "owner_gated"
+  | "identity_incomplete"
+  | "queue_protected"
+  | "takeover_custody"
+  | "intent_open"
+  | "carried_unsupported"
+  | "no_authorizing_review"
+  | "already_recorded"
+  | "surface_unreadable"
+  | "default_branch_unreadable"
+  | "latest_review_blocking"
+  | "task_acceptance_refused"
+  | "pull_unavailable"
+  | "pull_not_open"
+  | "head_moved"
+  | "foreign_author"
+  | "base_mismatch"
+  | "checks_pending"
+  | "issue_not_open"
+  | "request_unbindable"
+  | "clock_invalid"
+  | "protected_path"
+  | "protected_path_unverified";
+
+/** A record admitted as a train member this pass, with what admitted it. */
+export interface TrainMemberAdmissionV1 {
+  readonly record: HostedAutonomyRecordV1;
+  readonly member: DeliveryTrainMemberV1;
+  readonly receipt: ReviewReceiptV1;
+  readonly pull: HostedAutonomyPullV1;
+}
+
+export type TrainMemberVerdictV1 =
+  | { readonly ok: true; readonly admission: TrainMemberAdmissionV1 }
+  | { readonly ok: false; readonly refusal: TrainMemberRefusalV1 };
+
+/** True for the runtime's merge intent bound to exactly this (pr, head). */
+export function boundMergeIntent(
+  record: Pick<HostedAutonomyRecordV1, "intent" | "target">,
+): boolean {
+  const intent = record.intent;
+  return intent !== null && intent.kind === "merge" &&
+    intent.pr !== null && intent.pr === record.target.pr &&
+    intent.expectedHead !== null && intent.expectedHead === record.target.head;
+}
+
+/** A production release request already records this exact delivery. */
+function productionRecorded(
+  snapshot: Pick<RepairStateSnapshotV1, "releaseRequests">,
+  record: HostedAutonomyRecordV1,
+): boolean {
+  return snapshot.releaseRequests.some((request) =>
+    sameRepository(request.target.repository, record.repository) &&
+    request.source.pullRequest === record.target.pr &&
+    request.source.head === record.target.head &&
+    request.source.base === record.target.base &&
+    request.target.environment === "production"
+  );
+}
+
+/**
+ * The read-free part of the gate (shape, custody, intent, bound receipts,
+ * recorded delivery). The runtime's handoff and the launcher reach the same
+ * static answer from the same record.
+ */
+export function trainMemberStaticRefusal(
+  snapshot: RepairStateSnapshotV1,
+  record: HostedAutonomyRecordV1,
+  custody?: HostedQueueCustodyContext,
+  closedIssues: ReadonlySet<string> = new Set(),
+): TrainMemberRefusalV1 | null {
+  if (isHostedSelf(record.repository)) return "train_self";
+  if (!deliveryEligible(record, snapshot)) return "not_eligible";
+  if (acceptanceOwnerGated(record, snapshot, closedIssues)) {
+    return "owner_gated";
+  }
+  const { pr, head, base, branch } = record.target;
+  if (
+    record.source.kind !== "issue" || record.related.issueNumber === null ||
+    pr === null || head === null || base === null ||
+    branch !== candidateBranch(record.id as WorkItemId)
+  ) return "identity_incomplete";
+  if (
+    queueRecordProtected(record, custody) ||
+    (isGatewayVpsRepository(record.repository) &&
+      (QUEUE_PROOF_ACTIVATED || custody?.proofActivated === true))
+  ) return "queue_protected";
+  if (hasTakeoverCustody(record)) return "takeover_custody";
+  if (record.intent !== null && !boundMergeIntent(record)) {
+    return "intent_open";
+  }
+  // The closed spent shape admits no intent at all; its merge intent is the
+  // runtime's own and is cleared only by a verified landing.
+  if (
+    parkedStep(record) &&
+    !spentDeliveryAdmissible({ ...record, intent: null }, snapshot)
+  ) return "spent_not_admissible";
+  if (boundReviewReceipts(snapshot, record).length === 0) {
+    return "carried_unsupported";
+  }
+  if (productionRecorded(snapshot, record)) return "already_recorded";
+  return null;
+}
+
+/**
+ * The whole member gate, in order: the static gate, the trusted task and
+ * the latest review, the opt-out, the pull request, the head CI, the spent
+ * gates and the protected paths. `pull` is read once over the record's own
+ * surface; nothing here writes.
+ */
+export async function trainMemberGate(input: {
+  readonly context: HostedAutonomyPassContextV1;
+  readonly scope: HostedAutonomyScopeV1;
+  readonly record: HostedAutonomyRecordV1;
+}): Promise<TrainMemberVerdictV1> {
+  const { context, scope, record } = input;
+  const refuse = (refusal: TrainMemberRefusalV1): TrainMemberVerdictV1 => ({
+    ok: false,
+    refusal,
+  });
+  const refusal = trainMemberStaticRefusal(
+    context.snapshot,
+    record,
+    context.deps.queueCustody,
+    context.closedIssues,
+  );
+  if (refusal !== null) return refuse(refusal);
+  const surface = scope.surface;
+  if (surface === null) return refuse("surface_unreadable");
+  if (scope.baseBranch === null) return refuse("default_branch_unreadable");
+  const pr = record.target.pr!;
+  const head = record.target.head!;
+  const base = record.target.base!;
+  const issueNumber = record.related.issueNumber!;
+  const verdict = latestAuthorizingReceipt(
+    context.snapshot,
+    record,
+    await readTrustedTask(surface, record),
+  );
+  if (verdict.kind === "blocking") return refuse("latest_review_blocking");
+  if (verdict.kind !== "authorized") return refuse("task_acceptance_refused");
+  let optedOut: boolean | null = null;
+  try {
+    optedOut = await surface.readIssueOptedOut?.(issueNumber) ?? null;
+  } catch {
+    optedOut = null;
+  }
+  if (optedOut !== false) return refuse("task_acceptance_refused");
+  const pull = await context.readPull(scope, pr);
+  if (pull === null) return refuse("pull_unavailable");
+  if (pull.state !== "open" || pull.merged !== false) {
+    return refuse("pull_not_open");
+  }
+  if (pull.headSha !== head || pull.number !== pr) return refuse("head_moved");
+  if (pull.author !== HOSTED_AUTONOMY_TRUSTED_APP_AUTHOR) {
+    return refuse("foreign_author");
+  }
+  const baseRef = pullBaseRefRefusal(false, pull, scope.baseBranch);
+  if (baseRef !== null) return refuse(baseRef);
+  const ci = await headCiRefusal(surface, false, head, base);
+  if (ci !== null) return refuse(ci);
+  const spent = await spentMergeRefusal(
+    context,
+    scope,
+    record,
+    verdict.receipt,
+  );
+  if (spent !== null) return refuse(spent);
+  const guarded = await protectedPathRefusal(surface, record.repository, pr);
+  if (guarded !== null) return refuse(guarded);
+  return {
+    ok: true,
+    admission: {
+      record,
+      receipt: verdict.receipt,
+      pull,
+      member: {
+        recordId: record.id as WorkItemId,
+        pr,
+        head,
+        reviewedBase: base,
+        receiptId: verdict.receipt.id,
+        issueNumber,
+      },
+    },
+  };
+}
