+
+/**
+ * B0 holds `a.txt`, `b.txt`, `c.txt`, `d.txt`; member m (1..n) changes its
+ * own `m<i>.txt` path (member 0 changes `a.txt`; every member changes
+ * `a.txt` when `overlapping`); unless `moveTip` is false the owner then
+ * moves main from B0 to T with a change to `c.txt` no member touches.
+ */
+export async function createWorld(
