+ * listing suppresses it too.
+ */
+export interface TrainPremergeCiRequestV1 {
+  readonly workflowFile: string;
+  /** The train branch `sentinel-train/<trainId>` (a ref, never a SHA). */
+  readonly ref: string;
+  readonly inputs: Readonly<Record<string, string>>;
+}
+
+const TRAIN_BRANCH = /^sentinel-train\/[0-9a-f]{64}$/;
+
+export function trainPremergeCiRequestV1(
+  repository: Pick<RepositoryConfigV1["repository"], "owner" | "name">,
+  input: {
+    readonly trainBranch: string;
+    readonly baseBranch: string;
+    readonly base: string;
+    readonly trustedAuthor: string;
+  },
+): TrainPremergeCiRequestV1 | null {
+  const policy = premergeCiPolicyV1(repository);
+  if (
+    policy === null || !TRAIN_BRANCH.test(input.trainBranch) ||
+    !isGitSha(input.base) || input.baseBranch.length === 0 ||
+    input.trustedAuthor.length === 0
+  ) return null;
+  return {
+    workflowFile: policy.workflowFile,
+    ref: input.trainBranch,
+    inputs: {
+      [policy.baseRefInput]: input.baseBranch,
+      [policy.authorInput]: input.trustedAuthor,
+      [policy.scopeBaseInput]: input.base,
+    },
+  };
+}
+
+/** Runs of the workflow already bound to C (null: unreadable) suppress it. */
+export function trainPremergeDispatchSuppressed(
+  runsOnCommit: number | null,
+): boolean {
+  return runsOnCommit === null || runsOnCommit > 0;
+}
