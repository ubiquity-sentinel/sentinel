+      world.tipReads++;
+      await world.onTipRead?.(world.tipReads);
+      return branch === "main" ? await readTip() : null;
+    },
+    hasSuccessfulCheck: () => Promise.resolve(false),
+    hasAllChecksGreen: (head) =>
+      Promise.resolve(
+        ci.get(head) === "green" ? true : ci.get(head) === "red" ? false : null,
+      ),
+    failedChecks: (commit) =>
+      Promise.resolve(ci.get(commit) === "red" ? ["test"] : []),
+    listHeadRuns: (head) => Promise.resolve(runsFor(head)),
+    rerunFailedJobs(id) {
