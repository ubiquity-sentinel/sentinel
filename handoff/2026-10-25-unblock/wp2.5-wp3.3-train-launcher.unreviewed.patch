diff --git a/ops/hosted-autonomy-delivery-batch.ts b/ops/hosted-autonomy-delivery-batch.ts
new file mode 100644
index 0000000000..625ca4e5a0
--- /dev/null
+++ b/ops/hosted-autonomy-delivery-batch.ts
@@ -0,0 +1,301 @@
+/**
+ * Batched delivery booking (redesign 2026-10-25 C11, WP2.5). The delivery
+ * pass used to return after its first verified booking, so N merged
+ * deliveries needed N passes and N state commits. It now hands every booking
+ * it decides (a release request with its record transition, or the precise
+ * park of a carried merge that landed off its tip) to one batch and writes
+ * the batch once: one whole-snapshot expected-head compare-and-swap, the
+ * same strict parse and the same byte-for-byte readback as the single write
+ * it replaces. A batch of one writes exactly the snapshot that single write
+ * wrote.
+ *
+ * Every booking carries the exact record row its decision read. A lost
+ * compare-and-swap (the head moved under the pass) re-reads the state once
+ * and keeps only the bookings that are still valid on the fresh head: the
+ * record row is canonically unchanged, nothing that authorized it changed
+ * (the reviews of its pull request, the charges of its task) and no release
+ * request for the same delivery appeared. The kept ones are re-applied onto
+ * the fresh snapshot and written once more; a second loss ends the pass with
+ * `write_conflict`. A dropped booking is never lost evidence: its merge is
+ * adopted by a later pass exactly as a lost single write always was.
+ */
+import { canonicalStringify } from "../src/contracts/canonical.ts";
+import type { GitSha } from "../src/contracts/brands.ts";
+import type {
+  PortResultV1,
+  StateWriteResultV1,
+} from "../src/contracts/ports.ts";
+import type { ReleaseRequestV1 } from "../src/contracts/release.ts";
+import {
+  parseRepairStateSnapshotV1,
+  type RepairStateSnapshotV1,
+} from "../src/contracts/state-snapshots.ts";
+import { releaseRequestMatchesDelivery } from "../src/repair/loop-records.ts";
+import { orderRecords } from "../src/state/state-records.ts";
+import { sameRepository } from "./hosted-autonomy-policy.ts";
+import { retryWritten } from "./hosted-autonomy-retry-actions.ts";
+import type { HostedAutonomyPassContextV1 } from "./hosted-autonomy-scopes.ts";
+import { failed, readRepairSafely, skipped } from "./hosted-autonomy-state.ts";
+import type {
+  HostedAutonomyRecordV1,
+  HostedAutonomyResultV1,
+} from "./hosted-autonomy-types.ts";
+
+/** One verified booking (or precise park) the delivery pass decided. */
+export interface DeliveryBookingV1 {
+  /** The exact record row the decision read. */
+  readonly before: HostedAutonomyRecordV1;
+  /** Its replacement row; null leaves the row unchanged. */
+  readonly after: HostedAutonomyRecordV1 | null;
+  /** The release request this booking adds, if any. */
+  readonly request: ReleaseRequestV1 | null;
+  /** The action reported once the batch is written and read back. */
+  readonly done: string;
+  /** The delivered revision reported with it, if any. */
+  readonly revision: string | null;
+  /** The clock reading the transition was made at. */
+  readonly now: number;
+}
+
+/** The bookings of one delivery pass, in decision order. */
+export class DeliveryBatchV1 {
+  readonly #bookings: DeliveryBookingV1[] = [];
+
+  get size(): number {
+    return this.#bookings.length;
+  }
+
+  get bookings(): readonly DeliveryBookingV1[] {
+    return this.#bookings;
+  }
+
+  /**
+   * Adds a booking unless the batch already books this record or already
+   * holds a release request with the same id or for the same delivery (the
+   * case a later pass would have reported `already_recorded`).
+   */
+  add(booking: DeliveryBookingV1): boolean {
+    if (
+      this.#bookings.some((held) =>
+        held.before.id === booking.before.id ||
+        (booking.request !== null && held.request !== null &&
+          (held.request.id === booking.request.id ||
+            releaseRequestMatchesDelivery(held.request, booking.before)))
+      )
+    ) return false;
+    this.#bookings.push(booking);
+    return true;
+  }
+}
+
+/**
+ * The batch applied onto `snapshot` as the next snapshot written against
+ * `head`: one sequence step, the latest booking clock, every replaced row and
+ * every added request (ordered by id exactly as the store reads them back).
+ * Null when the clock would move backwards against `snapshot`.
+ */
+export function planDeliveryBatch(
+  snapshot: RepairStateSnapshotV1,
+  head: string,
+  bookings: readonly DeliveryBookingV1[],
+): unknown | null {
+  const now = Math.max(...bookings.map((booking) => booking.now));
+  if (!Number.isSafeInteger(now) || now < snapshot.updatedAt) return null;
+  const rows = new Map<string, HostedAutonomyRecordV1>();
+  for (const booking of bookings) {
+    if (booking.after !== null) rows.set(booking.before.id, booking.after);
+  }
+  const requests = bookings.flatMap((booking) =>
+    booking.request === null ? [] : [booking.request]
+  );
+  return {
+    ...snapshot,
+    stateHead: head,
+    sequence: snapshot.sequence + 1,
+    updatedAt: now,
+    work: rows.size === 0
+      ? snapshot.work
+      : snapshot.work.map((row) => rows.get(row.id) ?? row),
+    releaseRequests: requests.length === 0
+      ? snapshot.releaseRequests
+      : orderRecords<ReleaseRequestV1>(
+        [...snapshot.releaseRequests, ...requests].map((row) => ({
+          id: row.id,
+          value: row,
+        })),
+      ),
+  };
+}
+
+function same(a: unknown, b: unknown): boolean {
+  return canonicalStringify(a) === canonicalStringify(b);
+}
+
+/** The reviews and charges that authorized a booking's record. */
+function authority(
+  snapshot: RepairStateSnapshotV1,
+  record: HostedAutonomyRecordV1,
+): unknown {
+  return {
+    reviews: snapshot.reviews.filter((review) =>
+      sameRepository(review.repository, record.repository) &&
+      review.pullRequest.number === record.target.pr
+    ),
+    reservations: snapshot.reservations.filter((reservation) =>
+      reservation.taskId === record.id
+    ),
+  };
+}
+
+/**
+ * The bookings of `bookings` that remain valid on `fresh`, decided from
+ * `decided` (the snapshot the pass read): the row is unchanged, its pull
+ * request's reviews and its task's charges are unchanged, and no release
+ * request for the same id or delivery appeared.
+ */
+export function keepValidBookings(
+  decided: RepairStateSnapshotV1,
+  fresh: RepairStateSnapshotV1,
+  bookings: readonly DeliveryBookingV1[],
+): DeliveryBookingV1[] {
+  return bookings.filter((booking) => {
+    const row = fresh.work.find((item) => item.id === booking.before.id);
+    if (row === undefined || !same(row, booking.before)) return false;
+    if (!same(authority(fresh, row), authority(decided, row))) return false;
+    const request = booking.request;
+    return request === null ||
+      !fresh.releaseRequests.some((existing) =>
+        existing.id === request.id ||
+        releaseRequestMatchesDelivery(existing, booking.before)
+      );
+  });
+}
+
+type Written =
+  | { readonly kind: "applied"; readonly head: string }
+  | { readonly kind: "result"; readonly result: HostedAutonomyResultV1 }
+  | { readonly kind: "conflict"; readonly currentHead: string | null };
+
+/** One parse, expected-head write and byte-for-byte readback. */
+async function writeOnce(
+  context: HostedAutonomyPassContextV1,
+  draft: unknown,
+  expectedHead: string,
+): Promise<Written> {
+  const { deps, actions, observedHead } = context;
+  let next: RepairStateSnapshotV1;
+  try {
+    next = parseRepairStateSnapshotV1(draft);
+  } catch {
+    return {
+      kind: "result",
+      result: skipped("snapshot_invalid", observedHead, actions),
+    };
+  }
+  let write: PortResultV1<StateWriteResultV1> | null;
+  try {
+    write = await deps.state.writeRepair(next, expectedHead as GitSha);
+  } catch {
+    return {
+      kind: "result",
+      result: failed("write_unavailable", observedHead, actions),
+    };
+  }
+  if (write === null || !write.ok) {
+    return {
+      kind: "result",
+      result: failed("write_unavailable", observedHead, actions),
+    };
+  }
+  if (write.value.status === "conflict") {
+    return { kind: "conflict", currentHead: write.value.currentHead };
+  }
+  if (write.value.status === "ambiguous") {
+    return {
+      kind: "result",
+      result: failed("write_ambiguous", observedHead, actions),
+    };
+  }
+  const readback = await readRepairSafely(deps.state);
+  if (
+    readback === null || !readback.ok ||
+    readback.value.status !== "found" ||
+    readback.value.head !== write.value.head ||
+    canonicalStringify(readback.value.snapshot) !== canonicalStringify(next)
+  ) {
+    return {
+      kind: "result",
+      result: failed("readback_unverified", observedHead, actions),
+    };
+  }
+  return { kind: "applied", head: write.value.head };
+}
+
+/**
+ * Writes the batch once (null for an empty batch). After the readback every
+ * written booking's action and revision is reported, in decision order.
+ */
+export async function writeDeliveryBatch(
+  context: HostedAutonomyPassContextV1,
+  batch: DeliveryBatchV1,
+): Promise<HostedAutonomyResultV1 | null> {
+  if (batch.size === 0) return null;
+  const { deps, actions, revisions, observedHead } = context;
+  let snapshot = context.snapshot;
+  let head = observedHead;
+  let kept: readonly DeliveryBookingV1[] = batch.bookings;
+  for (let attempt = 0;; attempt++) {
+    const draft = planDeliveryBatch(snapshot, head, kept);
+    if (draft === null) {
+      return skipped(
+        attempt === 0 ? "clock_invalid" : "write_conflict",
+        observedHead,
+        actions,
+      );
+    }
+    const written = await writeOnce(context, draft, head);
+    if (written.kind === "result") return written.result;
+    if (written.kind === "applied") {
+      for (const booking of kept) {
+        actions.push(booking.done);
+        if (booking.revision !== null) revisions.push(booking.revision);
+      }
+      return {
+        kind: "hosted_autonomy",
+        status: "applied",
+        reason: retryWritten(actions) ? "retried" : "applied",
+        beforeHead: observedHead,
+        appliedHead: written.head,
+        actions,
+        revisions,
+      };
+    }
+    // A lost compare-and-swap: re-read once. A refusal that names the head
+    // the batch was written against (or a re-read that finds it) is no race
+    // to rebase over and is never re-read; a second loss ends the pass.
+    if (attempt > 0 || written.currentHead === head) {
+      return skipped("write_conflict", observedHead, actions);
+    }
+    const fresh = await readRepairSafely(deps.state);
+    if (
+      fresh === null || !fresh.ok || fresh.value.status !== "found" ||
+      fresh.value.head === head
+    ) return skipped("write_conflict", observedHead, actions);
+    const still = keepValidBookings(
+      context.snapshot,
+      fresh.value.snapshot,
+      kept,
+    );
+    actions.push(
+      `delivery:batch:rebased:kept=${still.length}:dropped=${
+        kept.length - still.length
+      }`,
+    );
+    if (still.length === 0) {
+      return skipped("write_conflict", observedHead, actions);
+    }
+    kept = still;
+    snapshot = fresh.value.snapshot;
+    head = fresh.value.head;
+  }
+}
