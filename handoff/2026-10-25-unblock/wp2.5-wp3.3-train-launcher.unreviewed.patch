+++ b/tests/host/delivery-batch_test.ts
@@ -0,0 +1,459 @@
+/**
+ * C11 batched booking (WP2.5): the delivery pass books every verified
+ * delivery it decides in ONE state commit instead of returning after the
+ * first one, through the real runner, the real Git repair store and a fake
+ * GitHub surface. A lost compare-and-swap re-reads once and keeps only the
+ * bookings still valid on the fresh head; a batch of one writes exactly the
+ * snapshot the single write wrote.
+ */
+import assert from "node:assert/strict";
+import type { GitSha, WorkItemId } from "../../src/contracts/brands.ts";
+import {
+  reviewTaskStatementDigest,
+  type ReviewTaskStatementV1,
+} from "../../src/contracts/review-receipt.ts";
+import type { RepairStateSnapshotV1 } from "../../src/contracts/state-snapshots.ts";
+import type { WorkRecordV1 } from "../../src/contracts/work-record.ts";
+import type {
+  HostedAutonomyGitHubV1,
+  HostedAutonomyResultV1,
+} from "../../ops/hosted-autonomy.ts";
+import { runHostedAutonomy } from "../../ops/hosted-autonomy.ts";
+import { buildHostedReleaseRequest } from "../../ops/hosted-autonomy-delivery.ts";
+import {
+  DeliveryBatchV1,
+  keepValidBookings,
+  planDeliveryBatch,
+} from "../../ops/hosted-autonomy-delivery-batch.ts";
+import { orderRecords } from "../../src/state/state-records.ts";
+import {
+  darkQueueCoordinatorFixture,
+  darkQueueFixture,
+} from "./hosted-autonomy-dark-queue-fixture.ts";
+import {
+  authorizingReceipt,
+  BASE,
+  deliveryRecord,
+  pullFacts,
+  SELF_REPO,
+} from "./hosted-autonomy-fixtures.ts";
+import { makeRig, repairSnapshot, type RigV1 } from "./hosted-autonomy-rig.ts";
+import { SHA1, T0 } from "../state/helpers.ts";
+
+const COUNT = 20;
+const NOW = T0 + 5_000_000;
+
+function hex(seed: number, width = 40): string {
+  return seed.toString(16).padStart(width, "0");
+}
+
+interface DeliveryV1 {
+  readonly record: WorkRecordV1;
+  readonly receipt: ReturnType<typeof authorizingReceipt>;
+  readonly task: ReviewTaskStatementV1;
+  readonly merge: GitSha;
+}
+
+/** One already-merged self delivery whose booking write was lost. */
+async function delivery(index: number): Promise<DeliveryV1> {
+  const issue = 300 + index;
+  const pr = 500 + index;
+  const head = hex(0xa000 + index) as GitSha;
+  const id = `issue-ubiquity-sentinel-${issue}` as WorkItemId;
+  const receiptId = `review-receipt:${hex(0xb000 + index, 64)}`;
+  const title = `Deliver batched sentinel issue ${issue}`;
+  const body = `Batch fixture task ${issue}.`;
+  const task: ReviewTaskStatementV1 = {
+    issueNumber: issue,
+    title,
+    body,
+    digest: await reviewTaskStatementDigest({
+      issueNumber: issue,
+      title,
+      body,
+    }),
+  };
+  return {
+    record: deliveryRecord({
+      id,
+      source: { kind: "issue", id: String(issue), revision: SHA1 },
+      related: { incidentId: null, issueNumber: issue },
+      target: {
+        base: BASE,
+        branch: `sentinel/repair/${id}`,
+        checkpoint: null,
+        head,
+        pr,
+      },
+      evidence: [{ kind: "review_receipt", ref: `artifact:${receiptId}` }],
+    }),
+    receipt: authorizingReceipt({
+      id: receiptId,
+      pullRequest: { number: pr, head, base: BASE },
+      taskAcceptance: {
+        issueNumber: issue,
+        taskDigest: task.digest,
+        verdict: "fulfilled",
+        evidence: ["the batched candidate satisfies its issue"],
+      },
+    }),
+    task,
+    merge: hex(0xc000 + index) as GitSha,
+  };
+}
+
+async function deliveries(count = COUNT): Promise<DeliveryV1[]> {
+  return await Promise.all(
+    Array.from({ length: count }, (_, index) => delivery(index)),
+  );
+}
+
+/** A self surface whose every pull is already merged on [BASE, head]. */
+function surface(
+  base: HostedAutonomyGitHubV1,
+  all: readonly DeliveryV1[],
+  onTask: (issue: number) => void = () => {},
+): HostedAutonomyGitHubV1 {
+  return {
+    ...base,
+    readIssueTask: (issue) => {
+      onTask(issue);
+      return Promise.resolve(
+        all.find((item) => item.task.issueNumber === issue)?.task ?? null,
+      );
+    },
+    readPull: (number) => {
+      const item = all.find((entry) => entry.record.target.pr === number);
+      return Promise.resolve(
+        item === undefined ? null : pullFacts({
+          number,
+          headSha: item.record.target.head,
+          mergeCommitSha: item.merge,
+          parents: [BASE, item.record.target.head!],
+        }),
+      );
+    },
+  };
+}
+
+async function snapshotOf(rig: RigV1): Promise<
+  { head: string; snapshot: RepairStateSnapshotV1 }
+> {
+  const read = await rig.state.readRepair();
+  assert.ok(read.ok && read.value.status === "found");
+  return { head: read.value.head, snapshot: read.value.snapshot };
+}
+
+async function pass(
+  rig: RigV1,
+  now: () => number = () => NOW,
+): Promise<HostedAutonomyResultV1> {
+  return await runHostedAutonomy({
+    state: rig.state,
+    githubFor: rig.githubFor,
+    queueCustody: darkQueueFixture(rig),
+    queue: await darkQueueCoordinatorFixture(rig),
+    clock: { now },
+  });
+}
+
+async function withRig(
+  name: string,
+  all: readonly DeliveryV1[],
+  body: (rig: RigV1, github: HostedAutonomyGitHubV1) => Promise<void>,
+): Promise<void> {
+  const { rig, github } = await makeRig(name, {
+    repair: repairSnapshot(
+      all.map((item) => item.record),
+      all.map((item) => item.receipt),
+    ),
+  });
+  rig.githubFor = () => surface(github, all);
+  try {
+    await body(rig, github);
+  } finally {
+    await Deno.remove(rig.tmp, { recursive: true });
+  }
+}
+
+const requestLines = (actions: readonly string[]) =>
+  actions.filter((action) => action.startsWith("request:"));
+
+Deno.test("delivery batch: 20 verified bookings land in one state commit", async () => {
+  const all = await deliveries();
+  await withRig("delivery-batch-20", all, async (rig) => {
+    const before = await snapshotOf(rig);
+    const result = await pass(rig);
+    assert.equal(result.status, "applied", JSON.stringify(result));
+    assert.equal(rig.writes, 1, "one whole-snapshot write for every booking");
+    assert.equal(requestLines(result.actions).length, COUNT);
+    assert.deepEqual(
+      result.revisions,
+      all.map((item) => item.merge),
+      "every booked revision is reported in decision order",
+    );
+    const after = await snapshotOf(rig);
+    assert.equal(after.snapshot.sequence, before.snapshot.sequence + 1);
+    assert.equal(after.snapshot.releaseRequests.length, COUNT);
+    for (const item of all) {
+      assert.ok(
+        after.snapshot.releaseRequests.some((request) =>
+          request.source.pullRequest === item.record.target.pr &&
+          request.revision === item.merge
+        ),
+      );
+    }
+    // A self record is never rewritten by its booking.
+    assert.deepEqual(after.snapshot.work, before.snapshot.work);
+    // The next pass finds every delivery recorded and writes nothing.
+    const again = await pass(rig);
+    assert.equal(again.status, "skipped", JSON.stringify(again));
+    assert.equal(rig.writes, 1);
+  });
+});
+
+Deno.test("delivery batch: a lost CAS over an unrelated write rebases and keeps all", async () => {
+  const all = await deliveries(4);
+  const bystander = await delivery(90);
+  await withRig(
+    "delivery-batch-rebase",
+    [...all, bystander],
+    async (rig, github) => {
+      const inner = rig.state.writeRepair;
+      let raced = false;
+      rig.state.writeRepair = async (next, expected) => {
+        if (!raced) {
+          raced = true;
+          // A concurrent writer moves the head first: it only touches a
+          // record none of the bookings read.
+          const current = await snapshotOf(rig);
+          const moved = {
+            ...current.snapshot,
+            stateHead: current.head,
+            sequence: current.snapshot.sequence + 1,
+            updatedAt: NOW - 1,
+            work: current.snapshot.work.map((row) =>
+              row.id === bystander.record.id
+                ? { ...row, updatedAt: NOW - 1 }
+                : row
+            ),
+          } as RepairStateSnapshotV1;
+          const write = await inner(moved, current.head as GitSha);
+          assert.ok(write.ok && write.value.status === "applied");
+        }
+        return await inner(next, expected);
+      };
+      // The bystander's pull reads unavailable, so it books nothing.
+      rig.githubFor = () => surface(github, all);
+      const before = await snapshotOf(rig);
+      const result = await pass(rig);
+      assert.equal(result.status, "applied", JSON.stringify(result));
+      assert.ok(
+        result.actions.includes("delivery:batch:rebased:kept=4:dropped=0"),
+        JSON.stringify(result.actions),
+      );
+      // The pass still reports the head it observed, like the single write.
+      assert.equal(result.beforeHead, before.head);
+      const after = await snapshotOf(rig);
+      assert.equal(after.snapshot.releaseRequests.length, all.length);
+      // The concurrent write survives the rebase.
+      const row = after.snapshot.work.find((item) =>
+        item.id === bystander.record.id
+      );
+      assert.notEqual(row?.updatedAt, bystander.record.updatedAt);
+    },
+  );
+});
+
+Deno.test("delivery batch: a rebase drops exactly the bookings the race invalidated", async () => {
+  const all = await deliveries(3);
+  await withRig("delivery-batch-drop", all, async (rig) => {
+    const inner = rig.state.writeRepair;
+    let raced = false;
+    const request = await buildHostedReleaseRequest(
+      SELF_REPO,
+      hex(0xdead),
+      all[1].record.target.head!,
+      BASE,
+      all[1].record.target.pr!,
+      all[1].receipt,
+      NOW,
+    );
+    assert.ok(request !== null);
+    rig.state.writeRepair = async (next, expected) => {
+      if (!raced) {
+        raced = true;
+        // The race changes the first booking's row and records the second
+        // delivery under another revision; the third stays valid.
+        const current = await snapshotOf(rig);
+        const moved = {
+          ...current.snapshot,
+          stateHead: current.head,
+          sequence: current.snapshot.sequence + 1,
+          updatedAt: NOW - 1,
+          work: current.snapshot.work.map((row) =>
+            row.id === all[0].record.id ? { ...row, updatedAt: NOW - 1 } : row
+          ),
+          releaseRequests: orderRecords(
+            [...current.snapshot.releaseRequests, request].map((value) => ({
+              id: value.id,
+              value,
+            })),
+          ),
+        } as RepairStateSnapshotV1;
+        const write = await inner(moved, current.head as GitSha);
+        assert.ok(write.ok && write.value.status === "applied");
+      }
+      return await inner(next, expected);
+    };
+    const result = await pass(rig);
+    assert.equal(result.status, "applied", JSON.stringify(result));
+    assert.ok(
+      result.actions.includes("delivery:batch:rebased:kept=1:dropped=2"),
+      JSON.stringify(result.actions),
+    );
+    assert.deepEqual(
+      requestLines(result.actions).map((line) => line.split(":")[1]),
+      [all[2].record.id],
+    );
+    const after = await snapshotOf(rig);
+    assert.equal(after.snapshot.releaseRequests.length, 2);
+  });
+});
+
+Deno.test("delivery batch: a second lost CAS ends the pass with write_conflict", async () => {
+  const all = await deliveries(2);
+  await withRig("delivery-batch-conflict", all, async (rig) => {
+    const inner = rig.state.writeRepair;
+    rig.state.writeRepair = async (next, expected) => {
+      // Every write races a concurrent one that touches no booked record.
+      const current = await snapshotOf(rig);
+      const moved = {
+        ...current.snapshot,
+        stateHead: current.head,
+        sequence: current.snapshot.sequence + 1,
+      } as RepairStateSnapshotV1;
+      await inner(moved, current.head as GitSha);
+      return await inner(next, expected);
+    };
+    const result = await pass(rig);
+    assert.equal(result.status, "skipped", JSON.stringify(result));
+    assert.equal(result.reason, "write_conflict");
+    assert.ok(
+      result.actions.includes("delivery:batch:rebased:kept=2:dropped=0"),
+    );
+    assert.equal(requestLines(result.actions).length, 0);
+  });
+});
+
+Deno.test("delivery batch: a deadline after bookings still writes them", async () => {
+  const all = await deliveries(3);
+  await withRig("delivery-batch-deadline", all, async (rig, github) => {
+    let late = false;
+    let reads = 0;
+    // The third record's delivery task read (its second read of the pass,
+    // after the closure-delivery phase's) happens past the pass deadline.
+    rig.githubFor = () =>
+      surface(github, all, (issue) => {
+        if (issue === all[2].task.issueNumber && ++reads === 2) late = true;
+      });
+    const result = await pass(rig, () => late ? NOW + 3_600_000 : NOW);
+    assert.equal(result.status, "applied", JSON.stringify(result));
+    assert.ok(
+      result.actions.includes("continuation:delivery:deferred_deadline"),
+    );
+    assert.deepEqual(
+      requestLines(result.actions).map((line) => line.split(":")[1]),
+      [all[0].record.id, all[1].record.id],
+    );
+    assert.equal(rig.writes, 1);
+  });
+});
+
+Deno.test("delivery batch: a batch of one writes exactly the single-write snapshot", async () => {
+  const [item] = await deliveries(1);
+  const snapshot = repairSnapshot([item.record], [item.receipt]);
+  const request = await buildHostedReleaseRequest(
+    SELF_REPO,
+    item.merge,
+    item.record.target.head!,
+    BASE,
+    item.record.target.pr!,
+    item.receipt,
+    NOW,
+  );
+  assert.ok(request !== null);
+  const head = hex(0xfeed);
+  const batch = new DeliveryBatchV1();
+  assert.ok(batch.add({
+    before: item.record,
+    after: null,
+    request,
+    done: "request",
+    revision: item.merge,
+    now: NOW,
+  }));
+  // The single write the pass used to make for this booking.
+  const single = {
+    ...snapshot,
+    stateHead: head,
+    sequence: snapshot.sequence + 1,
+    updatedAt: NOW,
+    work: snapshot.work,
+    releaseRequests: orderRecords(
+      [...snapshot.releaseRequests, request].map((row) => ({
+        id: row.id,
+        value: row,
+      })),
+    ),
+  };
+  assert.deepEqual(planDeliveryBatch(snapshot, head, batch.bookings), single);
+  // A park adds no request and keeps the request list as read.
+  const parked = { ...item.record, updatedAt: NOW };
+  const park = planDeliveryBatch(snapshot, head, [{
+    before: item.record,
+    after: parked,
+    request: null,
+    done: "park",
+    revision: null,
+    now: NOW,
+  }]) as RepairStateSnapshotV1;
+  assert.equal(park.releaseRequests, snapshot.releaseRequests);
+  assert.deepEqual(park.work, [parked]);
+  // A clock behind the snapshot plans nothing.
+  assert.equal(
+    planDeliveryBatch(snapshot, head, [{
+      ...batch.bookings[0],
+      now: snapshot.updatedAt - 1,
+    }]),
+    null,
+  );
+  // The same record or the same delivery is never booked twice.
+  assert.equal(batch.add({ ...batch.bookings[0], done: "again" }), false);
+});
+
+Deno.test("delivery batch: rebase validity reads the row, its reviews and its charges", async () => {
+  const [item] = await deliveries(1);
+  const decided = repairSnapshot([item.record], [item.receipt]);
+  const booking = {
+    before: item.record,
+    after: null,
+    request: null,
+    done: "request",
+    revision: null,
+    now: NOW,
+  };
+  assert.equal(keepValidBookings(decided, decided, [booking]).length, 1);
+  const reviewed = repairSnapshot([item.record], [
+    item.receipt,
+    authorizingReceipt({
+      id: `review-receipt:${hex(0xe1, 64)}`,
+      pullRequest: item.receipt.pullRequest,
+      completedAt: T0 + 9000,
+      observedAt: T0 + 9100,
+    }),
+  ]);
+  assert.equal(keepValidBookings(decided, reviewed, [booking]).length, 0);
+  const missing = repairSnapshot([], []);
+  assert.equal(keepValidBookings(decided, missing, [booking]).length, 0);
+});
