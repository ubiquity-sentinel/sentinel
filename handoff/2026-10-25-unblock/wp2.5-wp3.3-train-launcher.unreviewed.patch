+      return { mergeBase, changes: await changesBetween(mergeBase, head) };
+    },
+    readIssueOpen: (number) => Promise.resolve(!closedIssues.includes(number)),
+    readIssueTask: (number) =>
+      Promise.resolve(members.find((m) => m.issue === number)?.task ?? null),
+    readIssueOptedOut: () => Promise.resolve(false),
+    closeIssue(number) {
+      closedIssues.push(number);
+      return Promise.resolve(true);
+    },
+    listParkedRuns: () => Promise.resolve([]),
+    approveRun: () => Promise.resolve(true),
+    merge() {
+      world.merges++;
+      calls.push("merge");
+      return Promise.resolve(null);
+    },
+    train: trainGit,
+  };
+
+  const world: WorldV1 = {
+    dir,
+    bare,
+    reviewedBase,
+    tip,
+    members,
+    git: trainGit,
+    surface,
+    ci,
+    attempts,
+    calls,
+    trainPulls,
+    closedIssues,
+    merges: 0,
+    beforeFastForward: null,
+    fastForwardAnswer: "ok",
+    onTipRead: null,
+    tipReads: 0,
+    async ownerCommit(path) {
+      ownerCommits++;
+      await must(work, ["fetch", "-q", bare, "main"]);
+      await must(work, ["checkout", "-q", "-B", "main", "FETCH_HEAD"]);
+      await Deno.writeTextFile(`${work}/${path}`, `owner ${ownerCommits}\n`);
+      await must(work, ["add", "-A"]);
+      await must(work, ["commit", "-q", "-m", `owner ${ownerCommits}`]);
+      const sha = await must(work, ["rev-parse", "HEAD"]) as GitSha;
+      await must(work, ["push", "-q", bare, "main:refs/heads/main"]);
+      ci.set(sha, "green");
+      return sha;
+    },
+    readTip,
+    async treeOf(commit) {
+      return (await readCommit(commit))!.tree;
+    },
+    record(member, intent = false) {
+      return deliveryRecord({
+        repository: PASSPORT,
+        id: member.id,
+        source: { kind: "issue", id: String(member.issue), revision: SHA1 },
+        related: { incidentId: null, issueNumber: member.issue },
+        target: {
+          base: reviewedBase,
+          branch: candidateBranch(member.id),
+          checkpoint: null,
+          head: member.head,
+          pr: member.pr,
+        },
+        evidence: [{
+          kind: "review_receipt",
+          ref: `artifact:${world.receipt(member).id}`,
+        }],
+        intent: intent
+          ? {
+            kind: "merge",
+            key: mergeIntentKey(member.pr, member.head),
+            startedAt: T0 + 2500,
+            branch: candidateBranch(member.id),
+            expectedHead: member.head,
+            observedBase: reviewedBase,
+            pr: member.pr,
+            requestId: null,
+            resultId: null,
+          }
+          : null,
+      });
+    },
+    receipt(member) {
+      return authorizingReceipt({
+        id: `review-receipt:${member.pr.toString(16).padStart(64, "0")}`,
+        repository: PASSPORT,
+        pullRequest: {
+          number: member.pr,
+          head: member.head,
+          base: reviewedBase,
+        },
+        taskAcceptance: {
+          issueNumber: member.issue,
+          taskDigest: member.task.digest,
+          verdict: "fulfilled",
+          evidence: ["the train fixture candidate satisfies its issue"],
+        },
+      });
+    },
+    async cleanup() {
+      await Deno.remove(dir, { recursive: true });
+    },
+  };
+  return world;
+}
+
+export const TRAIN_NOW = T0 + 5_000_000;
+export const TRAIN_LABEL = "train:ubiquity/passport.ubq.fi";
+
+/**
+ * The real repair store seeded with the world's members (the first one
+ * carries the runtime's merge intent bound to its pull and head).
+ */
+export async function trainRig(name: string, world: WorldV1): Promise<RigV1> {
+  const records = world.members.map((member, index) =>
+    world.record(member, index === 0)
+  );
+  const { rig } = await makeRig(name, {
+    repair: repairSnapshot(
+      records,
+      world.members.map((member) => world.receipt(member)),
+    ),
+  });
+  rig.githubFor = (repository) =>
+    repository.name === PASSPORT.name ? world.surface : null;
+  return rig;
+}
+
+/** One maintenance pass; `mode` overrides the policy for Passport only. */
+export async function trainPass(
+  rig: RigV1,
+  mode?: DeliveryTrainModeV1,
+  lines?: string[],
+): Promise<HostedAutonomyResultV1> {
+  const log = console.log;
+  if (lines !== undefined) {
+    console.log = (...values: unknown[]) => {
+      if (typeof values[0] === "string") lines.push(values[0]);
+    };
+  }
+  try {
+    return await runHostedAutonomy({
+      state: rig.state,
+      githubFor: rig.githubFor,
+      queueCustody: darkQueueFixture(rig),
+      queue: await darkQueueCoordinatorFixture(rig),
+      clock: { now: () => TRAIN_NOW },
+      ...(mode === undefined ? {} : {
+        deliveryTrainMode: (repository) =>
+          repository.name === PASSPORT.name ? mode : "off",
+      }),
+    });
+  } finally {
+    console.log = log;
+  }
+}
+
+/** The repair rows as the store holds them now. */
+export async function trainWork(rig: RigV1) {
+  const read = await rig.state.readRepair();
+  if (!read.ok || read.value.status !== "found") throw new Error("unread");
+  return read.value.snapshot.work;
+}
