@@ -0,0 +1,336 @@
+/**
+ * The delivery-train member gate (redesign 2026-10-25 C12, WP3.3): composed
+ * of the very gates `preMergeGate` uses, minus base equality and the
+ * moved-base reads. Each gate refuses on its own; the extracted gates equal
+ * the inline checks they replaced, so the direct path is unchanged; and the
+ * runtime's merge intent is closable only for the exact landed member.
+ */
+import assert from "node:assert/strict";
+import type { WorkRecordV1 } from "../../src/contracts/work-record.ts";
+import type { HostedAutonomyPassContextV1 } from "../../ops/hosted-autonomy-scopes.ts";
+import { createHostedAutonomyScopes } from "../../ops/hosted-autonomy-scopes.ts";
+import type {
+  HostedAutonomyDepsV1,
+  HostedAutonomyGitHubV1,
+  HostedAutonomyPullV1,
+} from "../../ops/hosted-autonomy-types.ts";
+import {
+  trainMemberGate,
+  type TrainMemberVerdictV1,
+} from "../../ops/hosted-autonomy-train-gates.ts";
+import {
+  headCiRefusal,
+  pullBaseRefRefusal,
+} from "../../ops/hosted-autonomy-merge-gates.ts";
+import { headIsGreen } from "../../ops/hosted-autonomy-spent-delivery.ts";
+import { intentClosable } from "../../ops/hosted-autonomy-retries.ts";
+import { buildHostedReleaseRequest } from "../../ops/hosted-autonomy-delivery.ts";
+import { releaseSnapshot, repairSnapshot } from "./hosted-autonomy-rig.ts";
+import { finding, SELF_REPO } from "./hosted-autonomy-fixtures.ts";
+import {
+  createWorld,
+  PASSPORT,
+  TRAIN_NOW,
+  type WorldV1,
+} from "./train-world.ts";
+import { T0 } from "../state/helpers.ts";
+
+function context(
+  world: WorldV1,
+  records: WorkRecordV1[],
+  reviews: unknown[],
+  options: {
+    surface?: HostedAutonomyGitHubV1;
+    protectedIds?: string[];
+    releaseRequests?: unknown[];
+  } = {},
+): HostedAutonomyPassContextV1 {
+  const surface = options.surface ?? world.surface;
+  const deps = {
+    githubFor: () => surface,
+    clock: { now: () => TRAIN_NOW },
+    queueCustody: {
+      ready: true,
+      proofActivated: false,
+      protectedRecordIds: new Set(options.protectedIds ?? []),
+    },
+  } as unknown as HostedAutonomyDepsV1;
+  return {
+    deps,
+    actions: [],
+    revisions: [],
+    snapshot: repairSnapshot(records, reviews, options.releaseRequests ?? []),
+    observedHead: "e".repeat(40),
+    initialHead: "e".repeat(40),
+    releaseSnapshot: releaseSnapshot(),
+    closedIssues: new Set(),
+    foreignMerged: new Map(),
+    dedicatedReservations: new Set(),
+    ...createHostedAutonomyScopes(deps),
+  };
+}
+
+async function gate(
+  ctx: HostedAutonomyPassContextV1,
+  record: WorkRecordV1,
+): Promise<TrainMemberVerdictV1> {
+  return await trainMemberGate({
+    context: ctx,
+    scope: await ctx.scopeFor(record.repository),
+    record,
+  });
+}
+
+function refusal(verdict: TrainMemberVerdictV1): string | null {
+  return verdict.ok ? null : verdict.refusal;
+}
+
+let shared: WorldV1 | null = null;
+async function world(): Promise<WorldV1> {
+  shared ??= await createWorld("train-gates", 1);
+  return shared;
+}
+
+Deno.test("train gate: an admissible member is the exact reviewed tuple", async () => {
+  const w = await world();
+  const [member] = w.members;
+  for (const intent of [false, true]) {
+    const record = w.record(member, intent);
+    const verdict = await gate(
+      context(w, [record], [w.receipt(member)]),
+      record,
+    );
+    assert.ok(verdict.ok, JSON.stringify(verdict));
+    assert.deepEqual(verdict.admission.member, {
+      recordId: member.id,
+      pr: member.pr,
+      head: member.head,
+      reviewedBase: w.reviewedBase,
+      receiptId: w.receipt(member).id,
+      issueNumber: member.issue,
+    });
+  }
+});
+
+Deno.test("train gate: every shared gate refuses on its own", async () => {
+  const w = await world();
+  const [member] = w.members;
+  const record = w.record(member);
+  const receipt = w.receipt(member);
+  const surfaced = async (surface: Partial<HostedAutonomyGitHubV1>) =>
+    refusal(
+      await gate(
+        context(w, [record], [receipt], {
+          surface: { ...w.surface, ...surface },
+        }),
+        record,
+      ),
+    );
+  const pull = (await w.surface.readPull(member.pr, "main"))!;
+  const withPull = (overrides: Partial<HostedAutonomyPullV1>) =>
+    surfaced({ readPull: () => Promise.resolve({ ...pull, ...overrides }) });
+  assert.equal(
+    await surfaced({ readIssueOptedOut: () => Promise.resolve(true) }),
+    "task_acceptance_refused",
+  );
+  assert.equal(
+    await surfaced({ readIssueOptedOut: () => Promise.resolve(null) }),
+    "task_acceptance_refused",
+  );
+  assert.equal(
+    await surfaced({ readIssueTask: () => Promise.resolve(null) }),
+    "task_acceptance_refused",
+  );
+  assert.equal(
+    await surfaced({ hasAllChecksGreen: () => Promise.resolve(false) }),
+    "checks_pending",
+  );
+  assert.equal(
+    await surfaced({ hasAllChecksGreen: () => Promise.resolve(null) }),
+    "checks_pending",
+  );
+  assert.equal(await withPull({ author: "someone" }), "foreign_author");
+  assert.equal(
+    await withPull({ author: "github-actions[bot]" }),
+    "foreign_author",
+  );
+  assert.equal(await withPull({ state: "closed" }), "pull_not_open");
+  assert.equal(await withPull({ headSha: w.reviewedBase }), "head_moved");
+  assert.equal(await withPull({ baseRef: "release" }), "base_mismatch");
+  assert.equal(
+    await surfaced({ readIssueOpen: () => Promise.resolve(false) }),
+    "issue_not_open",
+  );
+  assert.equal(
+    await surfaced({ listPullFiles: () => Promise.resolve(["package.json"]) }),
+    "protected_path",
+  );
+  assert.equal(
+    await surfaced({ listPullFiles: () => Promise.resolve(null) }),
+    "protected_path_unverified",
+  );
+  assert.equal(
+    await surfaced({ readPull: () => Promise.resolve(null) }),
+    "pull_unavailable",
+  );
+});
+
+Deno.test("train gate: shape, custody, intent and receipt refusals need no read", async () => {
+  const w = await world();
+  const [member] = w.members;
+  const receipt = w.receipt(member);
+  const record = w.record(member);
+  const refuse = async (
+    candidate: WorkRecordV1,
+    reviews: unknown[] = [receipt],
+    options: Parameters<typeof context>[3] = {},
+  ) =>
+    refusal(await gate(context(w, [candidate], reviews, options), candidate));
+  assert.equal(
+    await refuse({ ...record, repository: SELF_REPO }, []),
+    "train_self",
+  );
+  assert.equal(
+    await refuse(record, [receipt], { protectedIds: [record.id] }),
+    "queue_protected",
+  );
+  const bound = w.record(member, true);
+  assert.equal(
+    await refuse({
+      ...bound,
+      intent: { ...bound.intent!, expectedHead: w.reviewedBase },
+    }),
+    "intent_open",
+  );
+  assert.equal(
+    await refuse({
+      ...bound,
+      intent: { ...bound.intent!, kind: "review_request" },
+    }),
+    "intent_open",
+  );
+  // Only a review of an earlier head: a carried review never makes a member.
+  assert.equal(
+    await refuse(record, [{
+      ...receipt,
+      pullRequest: { ...receipt.pullRequest, head: w.reviewedBase },
+    }]),
+    "carried_unsupported",
+  );
+  // A later P0 on the same head outvotes the earlier clean review.
+  assert.equal(
+    await refuse(record, [receipt, {
+      ...receipt,
+      id: `review-receipt:${"9".repeat(64)}`,
+      completedAt: T0 + 9000,
+      observedAt: T0 + 9100,
+      unresolvedSeverities: ["P0"],
+      findings: [finding("P0")],
+    }]),
+    "latest_review_blocking",
+  );
+  const request = await buildHostedReleaseRequest(
+    PASSPORT,
+    member.head,
+    member.head,
+    w.reviewedBase,
+    member.pr,
+    receipt,
+    T0 + 5000,
+  );
+  assert.equal(
+    await refuse(record, [receipt], { releaseRequests: [request] }),
+    "already_recorded",
+  );
+  assert.equal(
+    await refuse({ ...record, nextStep: "work" }),
+    "not_eligible",
+  );
+});
+
+Deno.test("train gate: the extracted gates equal preMergeGate's inline checks", async () => {
+  for (const self of [true, false]) {
+    for (const baseRef of ["main", "development", null]) {
+      for (const branch of ["main", null]) {
+        // The inline rule `!self && pull.baseRef !== scope.baseBranch`.
+        const inline = !self && baseRef !== branch ? "base_mismatch" : null;
+        assert.equal(pullBaseRefRefusal(self, { baseRef }, branch), inline);
+      }
+    }
+    for (const green of [true, false, null]) {
+      for (const named of [true, false]) {
+        const surface = {
+          hasSuccessfulCheck: () => Promise.resolve(named),
+          hasAllChecksGreen: () => Promise.resolve(green),
+        } as unknown as HostedAutonomyGitHubV1;
+        // The inline rule `!await headIsGreen(surface, self, head, base)`.
+        const inline = await headIsGreen(surface, self, "h", "b")
+          ? null
+          : "checks_pending";
+        assert.equal(await headCiRefusal(surface, self, "h", "b"), inline);
+      }
+    }
+  }
+  const throwing = {
+    hasSuccessfulCheck: () => Promise.reject(new Error("unread")),
+    hasAllChecksGreen: () => Promise.reject(new Error("unread")),
+  } as unknown as HostedAutonomyGitHubV1;
+  assert.equal(
+    await headCiRefusal(throwing, false, "h", "b"),
+    "checks_pending",
+  );
+});
+
+Deno.test("train gate: intentClosable clears only the exact landed member's merge intent", async () => {
+  const w = await world();
+  const [member] = w.members;
+  const record = w.record(member, true);
+  const landed = { pr: member.pr, head: member.head };
+  // Without a train member the runtime's merge intent stays protected.
+  assert.equal(intentClosable(record, []), false);
+  assert.equal(intentClosable(record, [], landed), true);
+  assert.equal(
+    intentClosable(record, [], { pr: member.pr + 1, head: member.head }),
+    false,
+  );
+  assert.equal(
+    intentClosable(record, [], { pr: member.pr, head: w.reviewedBase }),
+    false,
+  );
+  // A stale merge intent (another expected head) is not the landed merge,
+  // even when the record and the member name the landed head.
+  assert.equal(
+    intentClosable(
+      {
+        ...record,
+        intent: { ...record.intent!, expectedHead: w.reviewedBase },
+      },
+      [],
+      landed,
+    ),
+    false,
+  );
+  assert.equal(
+    intentClosable(
+      { ...record, intent: { ...record.intent!, pr: member.pr + 1 } },
+      [],
+      landed,
+    ),
+    false,
+  );
+  // Any other intent kind keeps its own rule, member or not.
+  const push = {
+    ...record,
+    intent: { ...record.intent!, kind: "review_request" },
+  };
+  assert.equal(
+    intentClosable(push as WorkRecordV1, [], landed),
+    intentClosable(push as WorkRecordV1, []),
+  );
+  assert.equal(intentClosable(w.record(member), [], landed), true);
+});
+
+Deno.test("train gate: dispose the shared world", async () => {
+  await shared?.cleanup();
+  shared = null;
+});
diff --git a/tests/host/train-land_test.ts b/tests/host/train-land_test.ts
new file mode 100644
index 0000000000..3a4f84ac51
--- /dev/null
+++ b/tests/host/train-land_test.ts
@@ -0,0 +1,331 @@
+/**
+ * Delivery-train landing (redesign 2026-10-25 C12 steps 1-6) through the
+ * real runner, the real Git repair store, a temporary bare remote serving
+ * the Git Data API and a fake GitHub surface (`train-world.ts`). The tip only
+ * ever moves to a commit whose exact tree passed CI, by fast-forward, and
+ * nothing is booked unless it landed:
+ * - a tip moved before the uncached pre-landing read, or between that read
+ *   and the PATCH, is refused (`base_moved`) with nothing booked, and the
+ *   next pass rebuilds the train on the new tip;
+ * - a lost PATCH response is adopted from the tip read back;
+ * - a refused PATCH on an unmoved tip is `landing_refused`, never a merge;
+ * - a red train is rerun once, then bisected: its tested green prefix lands;
+ * - red on T itself evicts nobody;
+ * - a one-member train on its own base lands on its head's CI (tree
+ *   identity).
+ */
+import assert from "node:assert/strict";
+import type { RigV1 } from "./hosted-autonomy-rig.ts";
+import {
+  createWorld,
+  TRAIN_LABEL as LABEL,
+  trainPass as pass,
+  trainRig,
+  trainWork,
+  type WorldV1,
+} from "./train-world.ts";
+
+interface BuiltV1 {
+  world: WorldV1;
+  rig: RigV1;
+  commit: string;
+  tree: string;
+  id12: string;
+}
+
+/** A world whose train was built (pass 1) and made green. */
+async function built(
+  name: string,
+  count = 2,
+  options: { moveTip?: boolean; green?: boolean } = {},
+): Promise<BuiltV1> {
+  const world = await createWorld(name, count, { moveTip: options.moveTip });
+  const rig = await trainRig(name, world);
+  const first = await pass(rig, "on");
+  const refs = await world.git.listTrainRefs();
+  assert.equal(refs?.length, 1, JSON.stringify(first.actions));
+  const commit = refs![0].sha;
+  if (options.green !== false) world.ci.set(commit, "green");
+  return {
+    world,
+    rig,
+    commit,
+    tree: await world.treeOf(commit),
+    id12: refs![0].ref.slice(-64, -52),
+  };
+}
+
+async function dispose({ world, rig }: BuiltV1) {
+  await Deno.remove(rig.tmp, { recursive: true });
+  await world.cleanup();
+}
+
+/** Nothing of the train is booked: every row is exactly as seeded. */
+async function nothingBooked(train: BuiltV1) {
+  assert.equal(train.rig.writes, 0);
+  for (const row of await trainWork(train.rig)) {
+    assert.notEqual(row.nextStep, "done");
+  }
+  assert.deepEqual(train.world.closedIssues, []);
+  assert.equal(train.world.merges, 0);
+}
+
+Deno.test("train land: a tip moved before the landing read is refused, nothing booked", async () => {
+  const train = await built("train-land-moved-read");
+  const { world } = train;
+  try {
+    // The owner lands a commit right after the overlay and evidence were
+    // re-verified, before the uncached tip read.
+    const readTree = world.git.readTree;
+    let armed = false;
+    world.git.readTree = (tree) => {
+      if (tree === train.tree) armed = true;
+      return readTree(tree);
+    };
+    const readBaseTip = world.surface.readBaseTip;
+    let moved: string | null = null;
+    world.surface.readBaseTip = async (branch) => {
+      if (armed && moved === null) moved = await world.ownerCommit("d.txt");
+      return await readBaseTip(branch);
+    };
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(`${LABEL}:${train.id12}:land_base_moved`),
+      JSON.stringify(result.actions),
+    );
+    assert.ok(!world.calls.includes("fastForward"));
+    assert.equal(await world.readTip(), moved);
+    await nothingBooked(train);
+    // The next pass deletes the abandoned train and rebuilds on the new tip.
+    world.surface.readBaseTip = readBaseTip;
+    const next = await pass(train.rig, "on");
+    assert.ok(next.actions.includes(`${LABEL}:ref_deleted:${train.id12}`));
+    const refs = await world.git.listTrainRefs();
+    assert.equal(refs?.length, 1);
+    const rebuilt = await world.git.readCommit(refs![0].sha);
+    assert.equal(rebuilt?.parents[0], moved);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: a tip moved between the read and the PATCH is refused by the fast-forward", async () => {
+  const train = await built("train-land-moved-patch");
+  const { world } = train;
+  try {
+    let moved: string | null = null;
+    world.beforeFastForward = async () => {
+      moved ??= await world.ownerCommit("d.txt");
+    };
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(`${LABEL}:${train.id12}:land_base_moved`),
+      JSON.stringify(result.actions),
+    );
+    assert.equal(
+      world.calls.filter((call) => call === "fastForward").length,
+      1,
+    );
+    assert.equal(await world.readTip(), moved, "the owner's commit stays");
+    await nothingBooked(train);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: a lost PATCH response is adopted from the tip", async () => {
+  const train = await built("train-land-lost");
+  const { world } = train;
+  try {
+    world.fastForwardAnswer = "lost";
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(
+        `${LABEL}:${train.id12}:landed:sha=${train.commit}:members=2:adopted`,
+      ),
+      JSON.stringify(result.actions),
+    );
+    assert.equal(await world.readTip(), train.commit);
+    // Every new tip tree is the tree CI tested.
+    assert.equal(await world.treeOf(await world.readTip()), train.tree);
+    assert.equal(train.rig.writes, 2, "one booking batch, one closure write");
+    const rows = await trainWork(train.rig);
+    assert.equal(
+      rows.find((row) => row.id === world.members[0].id)?.intent,
+      null,
+    );
+    assert.equal(world.merges, 0);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: a refused PATCH on an unmoved tip is landing_refused, never a merge", async () => {
+  const train = await built("train-land-refused");
+  const { world } = train;
+  try {
+    world.fastForwardAnswer = "refused";
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(`${LABEL}:${train.id12}:land_landing_refused`),
+      JSON.stringify(result.actions),
+    );
+    assert.equal(await world.readTip(), world.tip);
+    for (const member of world.members) {
+      assert.ok(result.actions.includes(`delivery:${member.id}:train_target`));
+    }
+    await nothingBooked(train);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: a red train reruns once, then lands its tested green prefix", async () => {
+  const train = await built("train-land-bisect", 2, { green: false });
+  const { world } = train;
+  try {
+    world.ci.set(train.commit, "red");
+    const rerun = await pass(train.rig, "on");
+    assert.ok(
+      rerun.actions.some((action) =>
+        action.startsWith(`${LABEL}:${train.id12}:rerun:ci_rerun:runs=1`)
+      ),
+      JSON.stringify(rerun.actions),
+    );
+    // Still red after its rerun, and green on T: the prefix M[:1] is built
+    // as its own digest-named train and tested.
+    const probe = await pass(train.rig, "on");
+    assert.ok(
+      probe.actions.some((action) => action.endsWith(":built:members=1")),
+      JSON.stringify(probe.actions),
+    );
+    const refs = (await world.git.listTrainRefs())!;
+    assert.equal(refs.length, 2);
+    const prefix = refs.find((ref) => ref.sha !== train.commit)!;
+    assert.equal(await world.readTip(), world.tip);
+    await nothingBooked(train);
+    world.ci.set(prefix.sha, "green");
+    const landed = await pass(train.rig, "on");
+    assert.ok(
+      landed.actions.includes(
+        `${LABEL}:${
+          prefix.ref.slice(-64, -52)
+        }:landed:sha=${prefix.sha}:members=1`,
+      ),
+      JSON.stringify(landed.actions),
+    );
+    assert.equal(await world.readTip(), prefix.sha);
+    assert.equal(
+      await world.treeOf(prefix.sha),
+      await world.treeOf(await world.readTip()),
+    );
+    const rows = await trainWork(train.rig);
+    const step = (id: string) => rows.find((row) => row.id === id)?.nextStep;
+    assert.equal(step(world.members[0].id), "delivery");
+    assert.equal(step(world.members[1].id), "delivery");
+    assert.equal(
+      rows.find((row) => row.id === world.members[1].id)?.intent,
+      null,
+    );
+    assert.equal(world.merges, 0);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: the same checks red on T evict nobody", async () => {
+  const train = await built("train-land-base-red", 2, { green: false });
+  const { world } = train;
+  try {
+    world.ci.set(train.commit, "red");
+    world.attempts.set(train.commit, 2);
+    world.ci.set(world.tip, "red");
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(
+        `${LABEL}:${train.id12}:wait_base_red:checks=1`,
+      ),
+      JSON.stringify(result.actions),
+    );
+    assert.equal((await world.git.listTrainRefs())?.length, 1);
+    await nothingBooked(train);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: a one-member train on its head's own base lands on tree identity", async () => {
+  const train = await built("train-land-identity", 1, {
+    moveTip: false,
+    green: false,
+  });
+  const { world } = train;
+  try {
+    // No train CI was requested: the head's own green CI covers C's tree.
+    assert.equal(world.trainPulls.length, 0);
+    assert.equal(
+      train.tree,
+      await world.treeOf(world.members[0].head),
+      "C's tree is H's tree",
+    );
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(
+        `${LABEL}:${train.id12}:landed:sha=${train.commit}:members=1`,
+      ),
+      JSON.stringify(result.actions),
+    );
+    assert.equal(await world.readTip(), train.commit);
+    // Its bound merge intent is cleared by the booking write; it closes on
+    // the next pass from the re-derived train proof.
+    const [row] = await trainWork(train.rig);
+    assert.equal(row.nextStep, "delivery");
+    assert.equal(row.intent, null);
+    await pass(train.rig, "on");
+    assert.deepEqual(world.closedIssues, [world.members[0].issue]);
+    assert.equal(world.merges, 0);
+  } finally {
+    await dispose(train);
+  }
+});
+
+Deno.test("train land: a train ref whose commit tree is not the reviewed overlay never lands", async () => {
+  const train = await built("train-land-forged", 2, { green: false });
+  const { world } = train;
+  try {
+    // A commit with the train's exact manifest message and parents, but one
+    // more file than the reviewed patches, under the digest-named ref.
+    const original = (await world.git.readCommit(train.commit))!;
+    const entries = (await world.git.readTree(original.tree))!;
+    const blob = entries.get("c.txt")!;
+    const forgedTree = await world.git.createTree({
+      baseTree: original.tree,
+      changes: [{
+        path: "extra.txt",
+        oldMode: null,
+        oldSha: null,
+        newMode: blob.mode,
+        newSha: blob.sha,
+      }],
+    });
+    const forged = await world.git.createCommit({
+      message: original.message,
+      tree: forgedTree!,
+      parents: original.parents,
+    });
+    const [ref] = (await world.git.listTrainRefs())!;
+    assert.ok(await world.git.deleteRef(ref.ref));
+    assert.ok(await world.git.createRef(ref.ref, forged!));
+    world.ci.set(forged!, "green");
+    const result = await pass(train.rig, "on");
+    assert.ok(
+      result.actions.includes(`${LABEL}:${train.id12}:land_tree_tree`),
+      JSON.stringify(result.actions),
+    );
+    assert.ok(!world.calls.includes("fastForward"));
+    assert.equal(await world.readTip(), world.tip);
+    await nothingBooked(train);
+  } finally {
+    await dispose(train);
+  }
+});
diff --git a/tests/host/train-pass_test.ts b/tests/host/train-pass_test.ts
new file mode 100644
index 0000000000..70115074a4
--- /dev/null
+++ b/tests/host/train-pass_test.ts
@@ -0,0 +1,217 @@
+/**
+ * The launcher's delivery-train phase (redesign 2026-10-25 C12, WP3.3)
+ * through the real runner, the real Git repair store and a git-backed fake
+ * target (`train-world.ts`):
+ * - `off` (the production policy for every target) adds no phase, never
+ *   touches the train capability and leaves every result unchanged;
+ * - `plan_only` logs one sanitized plan line and writes nothing anywhere;
+ * - `on` builds one octopus train on the moved tip, requests its CI, lands it
+ *   by a fast-forward once green (never the merge API), books every member
+ *   in one batch write, closes the issues and finally deletes the ref.
+ */
+import assert from "node:assert/strict";
+import { deliveryTrainModeV1 } from "../../src/host/target-policy.ts";
+import { DELIVERY_TRAIN_CANDIDATE_TARGETS } from "../../src/host/target-policy.ts";
+import type { HostedAutonomyResultV1 } from "../../ops/hosted-autonomy.ts";
+import { trainPhaseActive } from "../../ops/hosted-autonomy-train-gates.ts";
+import { treeChanges } from "../../ops/hosted-autonomy-github-trees.ts";
+import {
+  createWorld,
+  PASSPORT,
+  TRAIN_LABEL as LABEL,
+  trainPass,
+  trainRig,
+  trainWork,
+} from "./train-world.ts";
+/** Every train-port call that changes GitHub. */
+const EFFECTS = [
+  "createTree",
+  "createCommit",
+  "createRef",
+  "fastForward",
+  "deleteRef",
+  "openPull",
+  "dispatchWorkflow",
+];
+
+const rigFor = trainRig;
+const pass = trainPass;
+const work = trainWork;
+
+const trainLines = (result: HostedAutonomyResultV1) =>
+  result.actions.filter((action) => action.startsWith("train:"));
+
+Deno.test("train off: the production policy is off and adds no phase", () => {
+  for (const target of DELIVERY_TRAIN_CANDIDATE_TARGETS) {
+    assert.equal(deliveryTrainModeV1(target), "off");
+  }
+  assert.equal(deliveryTrainModeV1(PASSPORT), "off");
+  assert.equal(
+    deliveryTrainModeV1({ owner: "ubiquity", name: "ai.ubq.fi" }),
+    "off",
+  );
+  assert.equal(trainPhaseActive({}), false);
+  assert.equal(trainPhaseActive({ deliveryTrainMode: () => "off" }), true);
+});
+
+Deno.test("train off: the train capability is never touched and results are unchanged", async () => {
+  const outcomes: { actions: readonly string[]; lines: string[] }[] = [];
+  for (const capability of [true, false]) {
+    const world = await createWorld(`train-off-${capability}`);
+    const rig = await rigFor(`train-off-${capability}`, world);
+    if (!capability) delete world.surface.train;
+    const lines: string[] = [];
+    try {
+      const result = await pass(rig, undefined, lines);
+      assert.deepEqual(trainLines(result), []);
