@@ -0,0 +1,325 @@
+/**
+ * Delivery-train CI (redesign 2026-10-25 C12, WP3.3): the policy per target,
+ * the `train` dispatch kind of the pre-merge workflow (the complete Sentinel
+ * set on the train ref, suppressed while a run is bound to C), the CI facts
+ * of a train commit (never-started jobs are pending, never red), the k=1
+ * tree identity, and idempotent requests.
+ */
+import assert from "node:assert/strict";
+import {
+  deliveryTrainBranchV1,
+  deliveryTrainManifestV1,
+  deliveryTrainV1,
+} from "../../src/contracts/delivery-train.ts";
+import {
+  trainPremergeCiRequestV1,
+  trainPremergeDispatchSuppressed,
+} from "../../src/host/actions-premerge-ci.ts";
+import { trainCiPolicyV1 } from "../../src/host/target-policy.ts";
+import type { HostedAutonomyGitHubV1 } from "../../ops/hosted-autonomy-types.ts";
+import {
+  approveTrainRunsV1,
+  readTrainCiFactV1,
+  requestTrainCiV1,
+  rerunTrainCiV1,
+  trainPullBodyV1,
+  trainTreeIdentityGreenV1,
+} from "../../ops/hosted-autonomy-train-ci.ts";
+import { buildTrainV1 } from "../../ops/hosted-autonomy-train-build.ts";
+import { createWorld, TRAIN_NOW, type WorldV1 } from "./train-world.ts";
+import { T0 } from "../state/helpers.ts";
+
+const AI = { owner: "ubiquity", name: "ai.ubq.fi" };
+const TRAIN_ID = "a".repeat(64);
+
+Deno.test("train CI: Passport opens a train pull request, ai.ubq.fi dispatches", () => {
+  assert.deepEqual(
+    trainCiPolicyV1({ owner: "ubiquity", name: "passport.ubq.fi" }),
+    { kind: "pull_request", backup: true },
+  );
+  const ai = trainCiPolicyV1(AI);
+  assert.equal(ai?.kind, "dispatch");
+  assert.equal(
+    ai?.kind === "dispatch" ? ai.premerge.workflowFile : null,
+    "deno-deploy.yml",
+  );
+  assert.equal(
+    trainCiPolicyV1({ owner: "ubiquity-sentinel", name: "sentinel" }),
+    null,
+  );
+  assert.equal(trainCiPolicyV1({ owner: "example", name: "other" }), null);
+});
+
+Deno.test("train CI: the train dispatch carries the complete set on the train ref", () => {
+  const base = "b".repeat(40);
+  const request = trainPremergeCiRequestV1(AI, {
+    trainBranch: `sentinel-train/${TRAIN_ID}`,
+    baseBranch: "development",
+    base,
+    trustedAuthor: "ubiquity-sentinel[bot]",
+  });
+  assert.deepEqual(request, {
+    workflowFile: "deno-deploy.yml",
+    ref: `sentinel-train/${TRAIN_ID}`,
+    inputs: {
+      base_ref: "development",
+      sentinel_pr_author: "ubiquity-sentinel[bot]",
+      scope_base: base,
+    },
+  });
+  const valid = {
+    trainBranch: `sentinel-train/${TRAIN_ID}`,
+    baseBranch: "development",
+    base,
+    trustedAuthor: "ubiquity-sentinel[bot]",
+  };
+  for (
+    const invalid of [
+      { ...valid, trainBranch: "sentinel/repair/x" },
+      { ...valid, trainBranch: `sentinel-train/${TRAIN_ID.slice(1)}` },
+      { ...valid, base: "main" },
+      { ...valid, baseBranch: "" },
+      { ...valid, trustedAuthor: "" },
+    ]
+  ) assert.equal(trainPremergeCiRequestV1(AI, invalid), null);
+  // No pre-merge workflow: Passport's own CI runs on its pull requests.
+  assert.equal(
+    trainPremergeCiRequestV1({ owner: "ubiquity", name: "passport.ubq.fi" }, {
+      ...valid,
+    }),
+    null,
+  );
+  assert.equal(trainPremergeDispatchSuppressed(null), true);
+  assert.equal(trainPremergeDispatchSuppressed(0), false);
+  assert.equal(trainPremergeDispatchSuppressed(2), true);
+});
+
+async function trainOf(
+  world: WorldV1,
+  repository: { owner: string; name: string },
+) {
+  const train = await deliveryTrainV1(deliveryTrainManifestV1({
+    repository,
+    branch: "main",
+    base: world.tip,
+    members: world.members.map((member) => ({
+      recordId: member.id,
+      pr: member.pr,
+      head: member.head,
+      reviewedBase: world.reviewedBase,
+      receiptId: world.receipt(member).id,
+      issueNumber: member.issue,
+    })),
+  }));
+  const patches = await Promise.all(
+    world.members.map((member) =>
+      world.surface.mergeBaseTreeChanges!(world.reviewedBase, member.head)
+    ),
+  );
+  const changes = patches.flatMap((patch) => patch!.changes).sort((a, b) =>
+    a.path < b.path ? -1 : 1
+  );
+  const built = await buildTrainV1({
+    git: world.git,
+    train,
+    changes,
+    existing: null,
+  });
+  assert.equal(built.kind, "built");
+  return {
+    train,
+    commit: (built as { commit: string }).commit,
+  };
+}
+
+Deno.test("train CI: the facts of a train commit", async () => {
+  const world = await createWorld("train-ci-facts");
+  try {
+    const { commit } = await trainOf(world, {
+      owner: "ubiquity",
+      name: "passport.ubq.fi",
+    });
+    const fact = () =>
+      readTrainCiFactV1({
+        surface: world.surface,
+        commit,
+        base: world.tip,
+        now: TRAIN_NOW,
+      });
+    assert.deepEqual(await fact(), { state: "missing" });
+    world.ci.set(commit, "pending");
+    assert.deepEqual(await fact(), { state: "pending", since: T0 });
+    world.ci.set(commit, "never_started");
+    assert.deepEqual(await fact(), { state: "pending", since: T0 });
+    world.ci.set(commit, "red");
+    assert.deepEqual(await fact(), {
+      state: "red",
+      failed: ["test"],
+      rerun: false,
+    });
+    world.attempts.set(commit, 2);
+    assert.deepEqual(await fact(), {
+      state: "red",
+      failed: ["test"],
+      rerun: true,
+    });
+    world.ci.set(commit, "green");
+    assert.deepEqual(await fact(), { state: "green" });
+    const unreadable = { ...world.surface, listHeadRuns: undefined };
+    assert.equal(
+      await readTrainCiFactV1({
+        surface: unreadable,
+        commit,
+        base: world.tip,
+        now: TRAIN_NOW,
+      }),
+      null,
+    );
+  } finally {
+    await world.cleanup();
+  }
+});
+
+Deno.test("train CI: tree identity holds only for one member on its own base", async () => {
+  for (const moveTip of [false, true]) {
+    const world = await createWorld(`train-ci-identity-${moveTip}`, 1, {
+      moveTip,
+    });
+    try {
+      const { train, commit } = await trainOf(world, {
+        owner: "ubiquity",
+        name: "passport.ubq.fi",
+      });
+      const read = (await world.git.readCommit(commit))!;
+      assert.equal(
+        await trainTreeIdentityGreenV1({
+          git: world.git,
+          surface: world.surface,
+          train,
+          commit: read,
+        }),
+        !moveTip,
+      );
+      if (!moveTip) {
+        // Red head CI is no identity evidence.
+        world.ci.set(world.members[0].head, "red");
+        assert.equal(
+          await trainTreeIdentityGreenV1({
+            git: world.git,
+            surface: world.surface,
+            train,
+            commit: read,
+          }),
+          false,
+        );
+      }
+    } finally {
+      await world.cleanup();
+    }
+  }
+});
+
+Deno.test("train CI: requests are idempotent per policy", async () => {
+  const world = await createWorld("train-ci-request");
+  try {
+    const passport = await trainOf(world, {
+      owner: "ubiquity",
+      name: "passport.ubq.fi",
+    });
+    const request = (train: typeof passport) =>
+      requestTrainCiV1({
+        git: world.git,
+        surface: world.surface,
+        train: train.train,
+        commit: train.commit,
+      });
+    assert.equal(await request(passport), "ci_pull_opened:pr=900");
+    assert.equal(await request(passport), "ci_requested");
+    assert.equal(world.trainPulls.length, 1);
+    assert.equal(
+      world.trainPulls[0].head,
+      deliveryTrainBranchV1(passport.train.trainId),
+    );
+    const body = trainPullBodyV1(passport.train, passport.commit);
+    assert.doesNotMatch(body, /\b(close[sd]?|fix(e[sd])?|resolve[sd]?)\b/i);
+    for (const member of world.members) {
+      assert.ok(body.includes(`#${member.pr}`));
+    }
+    world.trainPulls[0] = { ...world.trainPulls[0], state: "closed" };
+    assert.equal(await request(passport), "ci_pull_closed");
+
+    const ai = await trainOf(world, AI);
+    assert.equal(await request(ai), "ci_dispatched");
+    world.ci.set(ai.commit, "pending");
+    assert.equal(await request(ai), "ci_requested", "a bound run suppresses");
+    assert.equal(
+      world.calls.filter((call) => call === "dispatchWorkflow").length,
+      1,
+    );
+    // Pending past its bound: the same train is dispatched again.
+    assert.equal(
+      await rerunTrainCiV1({
+        git: world.git,
+        surface: world.surface,
+        train: ai.train,
+        commit: ai.commit,
+        mode: "rerequest",
+      }),
+      "ci_dispatched",
+    );
+    // A red pull request train reruns its failed first attempt once.
+    world.ci.set(passport.commit, "red");
+    assert.equal(
+      await rerunTrainCiV1({
+        git: world.git,
+        surface: world.surface,
+        train: passport.train,
+        commit: passport.commit,
+        mode: "rerun",
+      }),
+      "ci_rerun:runs=1:accepted=1",
+    );
+    assert.equal(
+      await rerunTrainCiV1({
+        git: world.git,
+        surface: world.surface,
+        train: passport.train,
+        commit: passport.commit,
+        mode: "rerun",
+      }),
+      "ci_rerun_unavailable",
+    );
+  } finally {
+    await world.cleanup();
+  }
+});
+
+Deno.test("train CI: runs parked on a train commit are approved, three per pass", async () => {
+  const approved: number[] = [];
+  const surface = {
+    listParkedRuns: () => Promise.resolve([5, 6, 7, 8]),
+    approveRun: (id: number) => {
+      approved.push(id);
+      return Promise.resolve(id !== 6);
+    },
+  } as unknown as HostedAutonomyGitHubV1;
+  assert.equal(
+    await approveTrainRunsV1(surface, "c".repeat(40)),
+    "ci_approved:runs=3:approved=2",
+  );
+  assert.deepEqual(approved, [5, 6, 7]);
+  for (
+    const listParkedRuns of [
+      () => Promise.resolve([]),
+      () => Promise.reject(new Error("unreadable")),
+    ]
+  ) {
+    assert.equal(
+      await approveTrainRunsV1(
+        { listParkedRuns } as unknown as HostedAutonomyGitHubV1,
+        "c".repeat(40),
+      ),
+      null,
+    );
+  }
+});
