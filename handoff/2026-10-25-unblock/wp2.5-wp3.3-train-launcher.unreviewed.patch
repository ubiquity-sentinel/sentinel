diff --git a/ops/hosted-autonomy-train-advance.ts b/ops/hosted-autonomy-train-advance.ts
new file mode 100644
index 0000000000..7460f8a68a
--- /dev/null
+++ b/ops/hosted-autonomy-train-advance.ts
@@ -0,0 +1,301 @@
+/**
+ * The delivery-train phase's per-train steps (redesign 2026-10-25 C12,
+ * WP3.3), split from `hosted-autonomy-train-pass.ts`: the CI fact of one
+ * train commit (tree identity first for one member), the build and CI
+ * request of one train, and the execution of the bisection decision for the
+ * active train (land a tested green prefix by fast-forward, name an
+ * ejection, wait, or do the CI work: probe builds, requests, reruns).
+ */
+import type { GitSha } from "../src/contracts/brands.ts";
+import {
+  deliveryTrainPrefixV1,
+  type DeliveryTrainRepositoryV1,
+  type DeliveryTrainV1,
+  deliveryTrainV1,
+} from "../src/contracts/delivery-train.ts";
+import {
+  decideTrainBisectV1,
+  type TrainCiFactV1,
+  trainPrefixIdsV1,
+} from "../src/repair/train-bisect.ts";
+import {
+  computeTrainOverlayV1,
+  type TrainBaseTreeV1,
+  type TrainTreeChangeV1,
+} from "../src/repair/train-overlay.ts";
+import type { DeliveryBatchV1 } from "./hosted-autonomy-delivery-batch.ts";
+import type {
+  HostedAutonomyPassContextV1,
+  HostedAutonomyScopeV1,
+} from "./hosted-autonomy-scopes.ts";
+import {
+  buildTrainV1,
+  type HostedTrainCommitV1,
+  type HostedTrainGitHubV1,
+} from "./hosted-autonomy-train-build.ts";
+import {
+  approveTrainRunsV1,
+  readTrainCiFactV1,
+  requestTrainCiV1,
+  rerunTrainCiV1,
+  trainTreeIdentityGreenV1,
+} from "./hosted-autonomy-train-ci.ts";
+import {
+  bookLandedTrainV1,
+  landTrainV1,
+} from "./hosted-autonomy-train-land.ts";
+import type { HostedAutonomyGitHubV1 } from "./hosted-autonomy-types.ts";
+
+/** One parsed train ref: its commit and the manifest that commit carries. */
+export interface TrainEntryV1 {
+  readonly ref: string;
+  readonly train: DeliveryTrainV1;
+  readonly commit: HostedTrainCommitV1;
+}
+
+export interface TargetV1 {
+  readonly context: HostedAutonomyPassContextV1;
+  readonly scope: HostedAutonomyScopeV1;
+  readonly surface: HostedAutonomyGitHubV1;
+  readonly git: HostedTrainGitHubV1;
+  readonly repository: DeliveryTrainRepositoryV1;
+  readonly branch: string;
+  readonly tip: GitSha;
+  readonly label: string;
+  readonly batch: DeliveryBatchV1;
+}
+
+async function safely<T>(read: () => Promise<T>): Promise<T | null> {
+  try {
+    return await read();
+  } catch {
+    return null;
+  }
+}
+
+/** The CI fact of one train commit, tree identity first for one member. */
+export async function commitFact(
+  target: TargetV1,
+  entry: TrainEntryV1,
+): Promise<TrainCiFactV1 | null> {
+  if (
+    entry.train.manifest.members.length === 1 &&
+    await trainTreeIdentityGreenV1({
+      git: target.git,
+      surface: target.surface,
+      train: entry.train,
+      commit: entry.commit,
+    })
+  ) return { state: "green" };
+  return await readTrainCiFactV1({
+    surface: target.surface,
+    commit: entry.commit.sha,
+    base: entry.train.manifest.base,
+    now: target.context.deps.clock.now(),
+  });
+}
+
+export async function buildAndRequest(
+  target: TargetV1,
+  train: DeliveryTrainV1,
+  changes: readonly TrainTreeChangeV1[],
+  entries: readonly TrainEntryV1[],
+): Promise<void> {
+  const { context, label } = target;
+  const id12 = train.trainId.slice(0, 12);
+  const built = await buildTrainV1({
+    git: target.git,
+    train,
+    changes,
+    existing: entries.find((row) => row.train.trainId === train.trainId)
+      ?.commit.sha ?? null,
+  });
+  if (built.kind === "refused") {
+    context.actions.push(`${label}:${id12}:build_${built.reason}`);
+    return;
+  }
+  context.actions.push(
+    `${label}:${id12}:${built.kind}:members=${train.manifest.members.length}`,
+  );
+  const commit = await safely(() => target.git.readCommit(built.commit));
+  if (
+    commit !== null && train.manifest.members.length === 1 &&
+    await trainTreeIdentityGreenV1({
+      git: target.git,
+      surface: target.surface,
+      train,
+      commit,
+    })
+  ) {
+    context.actions.push(`${label}:${id12}:ci_tree_identity`);
+    return;
+  }
+  const requested = await requestTrainCiV1({
+    git: target.git,
+    surface: target.surface,
+    train,
+    commit: built.commit,
+  });
+  context.actions.push(`${label}:${id12}:${requested}`);
+}
+
+/** Advance the active train by the bisection decision. */
+export async function advanceTrain(
+  target: TargetV1,
+  active: DeliveryTrainV1,
+  entries: readonly TrainEntryV1[],
+  facts: {
+    tree: {
+      base: TrainBaseTreeV1;
+      entries: ReadonlyMap<string, { mode: string; sha: string }>;
+    };
+    protectedPaths: readonly string[];
+    patches: ReadonlyMap<string, readonly TrainTreeChangeV1[] | null>;
+    baseRed: readonly string[] | null;
+  },
+): Promise<void> {
+  const { context, label } = target;
+  const id12 = active.trainId.slice(0, 12);
+  const k = active.manifest.members.length;
+  const ids = await trainPrefixIdsV1(active.manifest);
+  const prefixEntry = (j: number) =>
+    entries.find((row) => row.train.trainId === ids[j - 1]);
+  const ci = new Map<number, TrainCiFactV1>();
+  for (let j = 1; j <= k; j++) {
+    const entry = prefixEntry(j);
+    if (entry === undefined) continue;
+    const approved = await approveTrainRunsV1(target.surface, entry.commit.sha);
+    if (approved !== null) {
+      context.actions.push(
+        `${label}:${entry.train.trainId.slice(0, 12)}:${approved}`,
+      );
+    }
+    const fact = await commitFact(target, entry);
+    if (fact !== null) ci.set(j, fact);
+  }
+  const decision = decideTrainBisectV1({
+    now: context.deps.clock.now(),
+    members: active.manifest.members,
+    ci,
+    baseRed: facts.baseRed,
+  });
+  const prefixTrain = async (j: number) =>
+    j === k ? active : await deliveryTrainV1(
+      deliveryTrainPrefixV1(active.manifest, j),
+    );
+  switch (decision.kind) {
+    case "land": {
+      const entry = prefixEntry(decision.prefix);
+      if (entry === undefined) {
+        context.actions.push(`${label}:${id12}:land_ref_missing`);
+        return;
+      }
+      const outcome = await landTrainV1({
+        context,
+        scope: target.scope,
+        git: target.git,
+        train: entry.train,
+        commit: entry.commit.sha,
+        tree: facts.tree.base,
+        baseEntries: facts.tree.entries,
+        protectedPaths: facts.protectedPaths,
+        patches: facts.patches,
+        evidence: async () =>
+          (await commitFact(target, entry))?.state === "green",
+      });
+      const landedId = entry.train.trainId.slice(0, 12);
+      if (outcome.kind === "refused") {
+        context.actions.push(`${label}:${landedId}:land_${outcome.reason}`);
+        return;
+      }
+      context.actions.push(
+        `${label}:${landedId}:landed:sha=${outcome.commit}:members=${entry.train.manifest.members.length}${
+          outcome.adopted ? ":adopted" : ""
+        }`,
+      );
+      const booked = await bookLandedTrainV1({
+        context,
+        scope: target.scope,
+        git: target.git,
+        train: entry.train,
+        commit: entry.commit,
+        tip: outcome.tip,
+        batch: target.batch,
+      });
+      context.actions.push(...booked.lines);
+      return;
+    }
+    case "eject":
+      context.actions.push(
+        `${label}:${id12}:eject:${decision.member.recordId}`,
+      );
+      return;
+    case "wait_base_red":
+      context.actions.push(
+        `${label}:${id12}:wait_base_red:checks=${decision.checks.length}`,
+      );
+      return;
+    case "wait_facts":
+      context.actions.push(`${label}:${id12}:wait_facts:${decision.reason}`);
+      return;
+    case "ci": {
+      for (const j of decision.build) {
+        const train = await prefixTrain(j);
+        const overlay = computeTrainOverlayV1({
+          base: target.tip,
+          tree: facts.tree.base,
+          protectedPaths: facts.protectedPaths,
+          candidates: train.manifest.members.map((member) => ({
+            member,
+            changes: facts.patches.get(member.recordId) ?? null,
+          })),
+        });
+        if (overlay.members.length !== train.manifest.members.length) {
+          context.actions.push(`${label}:${id12}:probe_${j}_facts`);
+          continue;
+        }
+        await buildAndRequest(target, train, overlay.changes, entries);
+      }
+      for (const j of decision.request) {
+        const entry = prefixEntry(j);
+        if (entry === undefined) continue;
+        const requested = await requestTrainCiV1({
+          git: target.git,
+          surface: target.surface,
+          train: entry.train,
+          commit: entry.commit.sha,
+        });
+        context.actions.push(
+          `${label}:${entry.train.trainId.slice(0, 12)}:${requested}`,
+        );
+      }
+      for (
+        const [mode, list] of [
+          ["rerun", decision.rerun],
+          ["rerequest", decision.rerequest],
+        ] as const
+      ) {
+        for (const j of list) {
+          const entry = prefixEntry(j);
+          if (entry === undefined) continue;
+          const outcome = await rerunTrainCiV1({
+            git: target.git,
+            surface: target.surface,
+            train: entry.train,
+            commit: entry.commit.sha,
+            mode,
+          });
+          context.actions.push(
+            `${label}:${entry.train.trainId.slice(0, 12)}:${mode}:${outcome}`,
+          );
+        }
+      }
+      if (decision.waiting.length > 0) {
+        context.actions.push(
+          `${label}:${id12}:ci_waiting:prefixes=${decision.waiting.join(",")}`,
+        );
+      }
+      return;
+    }
+  }
+}
