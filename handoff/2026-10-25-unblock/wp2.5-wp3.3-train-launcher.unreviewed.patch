+      await ancestor(member.head, main) === true;
+    const landed = merged ? await readCommit(main) : null;
+    return {
+      number,
+      state: merged ? "closed" : "open",
+      merged,
+      mergeCommitSha: merged ? main : null,
+      headSha: member.head,
+      baseRef: "main",
+      baseSha: reviewedBase,
+      author: APP,
