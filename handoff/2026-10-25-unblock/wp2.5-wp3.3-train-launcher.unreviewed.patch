+ * `off` until the owner enables one after probes P1-P5, the DECISIONS
+ * entry and the independent audit; the self target is never a train target
+ * (it keeps `executeSelfMerge`).
+ */
+export type DeliveryTrainModeV1 = "off" | "plan_only" | "on";
+
+export function deliveryTrainModeV1(
+  _repository: Pick<RepositoryIdentityV1, "owner" | "name">,
+): DeliveryTrainModeV1 {
+  return "off";
+}
+
+/**
+ * The only targets a delivery train may ever run on (the self target keeps
+ * its own merge). The launcher adds its `train` phase only while one of
+ * these is not `off`, so with every target `off` its phases are unchanged.
+ */
+export const DELIVERY_TRAIN_CANDIDATE_TARGETS: readonly Pick<
+  RepositoryIdentityV1,
+  "owner" | "name"
+>[] = Object.freeze([
+  Object.freeze({ owner: "ubiquity", name: "passport.ubq.fi" }),
+  Object.freeze({ owner: "ubiquity", name: "ai.ubq.fi" }),
+]);
+
+/**
+ * How a train commit C gets the target's own complete CI (C12):
+ * `pull_request` opens an App-authored train pull request (head
+ * `sentinel-train/<id>`, base the default branch, never a closing keyword),
+ * whose never-started jobs go to backup CI on the subject (T, C) when
+ * `backup` is set; `dispatch` asks the pre-merge workflow for the train ref
+ * with the complete Sentinel set (`trainPremergeCiRequestV1`).
+ */
+export type TrainCiPolicyV1 =
+  | { readonly kind: "pull_request"; readonly backup: boolean }
+  | {
+    readonly kind: "dispatch";
+    readonly premerge: PremergeCiPolicyV1;
+  };
+
+export function trainCiPolicyV1(
+  repository: Pick<RepositoryIdentityV1, "owner" | "name">,
+): TrainCiPolicyV1 | null {
+  if (isPassportTarget(repository)) {
+    return { kind: "pull_request", backup: true };
+  }
+  const premerge = premergeCiPolicyV1(repository);
+  return premerge === null ? null : { kind: "dispatch", premerge };
+}
