index 0000000000..ea8d979db4
--- /dev/null
+++ b/ops/hosted-autonomy-train-build.ts
@@ -0,0 +1,446 @@
+/**
+ * Delivery-train build over GitHub's Git Data API (redesign 2026-10-25 C12,
+ * WP3.3). The launcher never runs local git for a train: it creates the
+ * overlay tree on T's tree (`POST /git/trees` with `base_tree`, a deletion as
+ * `sha: null`), the octopus commit C with parents `[T, H_1..H_k]` and the
+ * exact manifest message (`POST /git/commits`), and the digest-named ref
+ * `refs/heads/sentinel-train/<trainId>` (`POST /git/refs`). Idempotency comes
+ * from that ref, never from SHA determinism: an existing ref is read and
+ * verified instead of rebuilt, and a refused create (the ref appeared) is
+ * read back and verified the same way.
+ *
+ * `HostedTrainGitHubV1` is the launcher-only capability of ONE repository
+ * over the App token; `createHostedTrainGitHub` is its production
+ * implementation. Every answer is bound to the requested object, and
+ * anything unreadable is null, which never builds, lands or books.
+ */
+import type { GitSha } from "../src/contracts/brands.ts";
+import {
+  deliveryTrainCommitMessageV1,
+  deliveryTrainParentsV1,
+  deliveryTrainRefV1,
+  type DeliveryTrainV1,
+  hasDeliveryTrainParentsV1,
+  parseDeliveryTrainCommitMessageV1,
+} from "../src/contracts/delivery-train.ts";
+import { RecordParseError } from "../src/contracts/validation.ts";
+import type {
+  TrainTreeChangeV1,
+  TrainTreeEntryV1,
+} from "../src/repair/train-overlay.ts";
+import {
+  API_BASE,
+  createHostedAutonomyRequest,
+  LISTING_PAGE_SIZE,
+  MAX_COMPARE_RESPONSE_BYTES,
+  REQUEST_TIMEOUT_MS,
+} from "./hosted-autonomy-github-listing.ts";
+import { parseRecursiveTree } from "./hosted-autonomy-github-trees.ts";
+
+/** One commit as GitHub's Git Data API reports it. */
+export interface HostedTrainCommitV1 {
+  readonly sha: string;
+  readonly tree: string;
+  readonly parents: readonly string[];
+  readonly message: string;
+}
+
+/** One `refs/heads/sentinel-train/*` ref and the commit it names. */
+export interface HostedTrainRefV1 {
+  readonly ref: string;
+  readonly sha: string;
+}
+
+/** One open pull request of a train branch. */
+export interface HostedTrainPullV1 {
+  readonly number: number;
+  readonly state: "open" | "closed";
+}
+
+/** Launcher-only train capability of ONE repository (the App token). */
+export interface HostedTrainGitHubV1 {
+  /** Every `refs/heads/sentinel-train/*` ref; null when unreadable. */
+  listTrainRefs(): Promise<readonly HostedTrainRefV1[] | null>;
+  readCommit(sha: string): Promise<HostedTrainCommitV1 | null>;
+  /** Every non-directory entry of one tree, read whole; null otherwise. */
+  readTree(tree: string): Promise<ReadonlyMap<string, TrainTreeEntryV1> | null>;
+  /** The created tree's id; null on any refusal. */
+  createTree(input: {
+    readonly baseTree: string;
+    readonly changes: readonly TrainTreeChangeV1[];
+  }): Promise<string | null>;
+  /** The created commit's id; null on any refusal. */
+  createCommit(input: {
+    readonly message: string;
+    readonly tree: string;
+    readonly parents: readonly string[];
+  }): Promise<string | null>;
+  /** True when GitHub created `ref` at `sha`. */
+  createRef(ref: string, sha: string): Promise<boolean>;
+  /**
+   * `PATCH /git/refs/heads/<branch>` with `{sha, force: false}`: true on
+   * acceptance. GitHub refuses a non-fast-forward; the caller decides every
+   * other outcome from the tip it reads back.
+   */
+  fastForward(branch: string, sha: string): Promise<boolean>;
+  deleteRef(ref: string): Promise<boolean>;
+  /** True when `ancestor` is `descendant` or its ancestor; null unread. */
+  isAncestor(ancestor: string, descendant: string): Promise<boolean | null>;
+  /** Pull requests whose head is exactly `branch`; null when unreadable. */
+  listBranchPulls(branch: string): Promise<readonly HostedTrainPullV1[] | null>;
+  /** The created pull request number; null on any refusal. */
+  openPull(input: {
+    readonly head: string;
+    readonly base: string;
+    readonly title: string;
+    readonly body: string;
+  }): Promise<number | null>;
+  /** Comment, then close: true only when the pull request ends closed. */
+  closePull(number: number, comment: string): Promise<boolean>;
+  /** `workflow_dispatch` of one workflow file: true on acceptance (204). */
+  dispatchWorkflow(input: {
+    readonly workflowFile: string;
+    readonly ref: string;
+    readonly inputs: Readonly<Record<string, string>>;
+  }): Promise<boolean>;
+}
+
+const OBJECT_ID = /^[0-9a-f]{40}$/;
+
+function field(value: unknown, key: string): unknown {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)[key]
+    : undefined;
+}
+
+function objectId(value: unknown): string | null {
+  return typeof value === "string" && OBJECT_ID.test(value) ? value : null;
+}
+
+/** The commit body GitHub answers, bound to the requested id. */
+export function parseHostedTrainCommit(
+  body: unknown,
+  sha: string,
+): HostedTrainCommitV1 | null {
+  if (field(body, "sha") !== sha) return null;
+  const tree = objectId(field(field(body, "tree"), "sha"));
+  const message = field(body, "message");
+  const rows = field(body, "parents");
+  if (tree === null || typeof message !== "string" || !Array.isArray(rows)) {
+    return null;
+  }
+  const parents = rows.map((row) => objectId(field(row, "sha")));
+  if (parents.some((parent) => parent === null)) return null;
+  return { sha, tree, parents: parents as string[], message };
+}
+
+/**
+ * Bounded effect whose only evidence is GitHub's acceptance (any 2xx): a ref
+ * deletion and a workflow dispatch answer 204 with no body, which the JSON
+ * reader reads as a refusal. The body is never parsed or returned.
+ */
+function createTrainEffect(token: string) {
+  return async function effect(
+    method: string,
+    path: string,
+    body?: Record<string, unknown>,
+  ): Promise<boolean> {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
+    try {
+      const response = await fetch(`${API_BASE}${path}`, {
+        method,
+        headers: {
+          authorization: `Bearer ${token}`,
+          accept: "application/vnd.github+json",
+          "user-agent": "sentinel-hosted-autonomy",
+          ...(body === undefined ? {} : { "content-type": "application/json" }),
+        },
+        ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+        signal: controller.signal,
+      });
+      await response.body?.cancel();
+      return response.status >= 200 && response.status < 300;
+    } catch {
+      return false;
+    } finally {
+      clearTimeout(timer);
+    }
+  };
+}
+
+/** The production capability for one repository, over its App token. */
+export function createHostedTrainGitHub(
+  token: string,
+  repository: { readonly owner: string; readonly name: string },
+): HostedTrainGitHubV1 {
+  const scope = `${repository.owner}/${repository.name}`;
+  const owner = repository.owner;
+  const request = createHostedAutonomyRequest(token);
+  const effect = createTrainEffect(token);
+  const prefix = "refs/heads/sentinel-train/";
+  return {
+    async listTrainRefs() {
+      const body = await request(
+        "GET",
+        `/repos/${scope}/git/matching-refs/heads/sentinel-train/`,
+      );
+      // Unknown is never empty: a listing that may be cut at a page bound
+      // is no proof of which trains exist.
+      if (!Array.isArray(body) || body.length >= LISTING_PAGE_SIZE) return null;
+      const refs: HostedTrainRefV1[] = [];
+      for (const row of body) {
+        const ref = field(row, "ref");
+        const sha = objectId(field(field(row, "object"), "sha"));
+        if (typeof ref !== "string" || !ref.startsWith(prefix) || !sha) {
+          return null;
+        }
+        refs.push({ ref, sha });
+      }
+      return refs;
+    },
+    async readCommit(sha) {
+      if (objectId(sha) === null) return null;
+      return parseHostedTrainCommit(
+        await request("GET", `/repos/${scope}/git/commits/${sha}`),
+        sha,
+      );
+    },
+    async readTree(tree) {
+      if (objectId(tree) === null) return null;
+      return parseRecursiveTree(
+        await request(
+          "GET",
+          `/repos/${scope}/git/trees/${tree}?recursive=1`,
+          undefined,
+          MAX_COMPARE_RESPONSE_BYTES,
+        ),
+        tree,
+      );
+    },
+    async createTree({ baseTree, changes }) {
+      const body = await request("POST", `/repos/${scope}/git/trees`, {
+        base_tree: baseTree,
+        tree: changes.map((change) =>
+          change.newMode === null
+            ? {
+              path: change.path,
+              mode: change.oldMode,
+              type: change.oldMode === "160000" ? "commit" : "blob",
+              sha: null,
+            }
+            : {
+              path: change.path,
+              mode: change.newMode,
+              type: change.newMode === "160000" ? "commit" : "blob",
+              sha: change.newSha,
+            }
+        ),
+      }, MAX_COMPARE_RESPONSE_BYTES);
+      return objectId(field(body, "sha"));
+    },
+    async createCommit({ message, tree, parents }) {
+      const body = await request("POST", `/repos/${scope}/git/commits`, {
+        message,
+        tree,
+        parents: [...parents],
+      });
+      const sha = objectId(field(body, "sha"));
+      return sha !== null && field(field(body, "tree"), "sha") === tree
+        ? sha
+        : null;
+    },
+    async createRef(ref, sha) {
+      const body = await request("POST", `/repos/${scope}/git/refs`, {
+        ref,
+        sha,
+      });
+      return field(body, "ref") === ref &&
+        field(field(body, "object"), "sha") === sha;
+    },
+    async fastForward(branch, sha) {
+      const body = await request(
+        "PATCH",
+        `/repos/${scope}/git/refs/heads/${branch}`,
+        { sha, force: false },
+      );
+      return field(body, "ref") === `refs/heads/${branch}` &&
+        field(field(body, "object"), "sha") === sha;
+    },
+    deleteRef(ref) {
+      if (!ref.startsWith(prefix)) return Promise.resolve(false);
+      return effect("DELETE", `/repos/${scope}/git/${ref}`);
+    },
+    async isAncestor(ancestor, descendant) {
+      if (objectId(ancestor) === null || objectId(descendant) === null) {
+        return null;
+      }
+      if (ancestor === descendant) return true;
+      const compare = await request(
+        "GET",
+        `/repos/${scope}/compare/${ancestor}...${descendant}`,
+        undefined,
+        MAX_COMPARE_RESPONSE_BYTES,
+      );
+      const status = field(compare, "status");
+      if (status === "ahead" || status === "identical") {
+        return field(field(compare, "merge_base_commit"), "sha") === ancestor;
+      }
+      return status === "behind" || status === "diverged" ? false : null;
+    },
+    async listBranchPulls(branch) {
+      const head = encodeURIComponent(`${owner}:${branch}`);
+      const body = await request(
+        "GET",
+        `/repos/${scope}/pulls?state=all&head=${head}&per_page=${LISTING_PAGE_SIZE}`,
+      );
+      if (!Array.isArray(body) || body.length >= LISTING_PAGE_SIZE) return null;
+      const pulls: HostedTrainPullV1[] = [];
+      for (const row of body) {
+        const number = field(row, "number");
+        const state = field(row, "state");
+        if (
+          field(field(row, "head"), "ref") !== branch ||
+          field(field(field(row, "head"), "repo"), "full_name") !== scope ||
+          typeof number !== "number" || !Number.isSafeInteger(number) ||
+          (state !== "open" && state !== "closed")
+        ) return null;
+        pulls.push({ number, state });
+      }
+      return pulls;
+    },
+    async openPull({ head, base, title, body }) {
+      const created = await request("POST", `/repos/${scope}/pulls`, {
+        head,
+        base,
+        title,
+        body,
+        maintainer_can_modify: false,
+      });
+      const number = field(created, "number");
+      return field(field(created, "head"), "ref") === head &&
+          typeof number === "number" && Number.isSafeInteger(number)
+        ? number
+        : null;
+    },
+    async closePull(number, comment) {
+      const commented = await request(
+        "POST",
+        `/repos/${scope}/issues/${number}/comments`,
+        { body: comment },
+      );
+      if (commented === null) return false;
+      const closed = await request("PATCH", `/repos/${scope}/pulls/${number}`, {
+        state: "closed",
+      });
+      return field(closed, "number") === number &&
+        field(closed, "state") === "closed";
+    },
+    dispatchWorkflow({ workflowFile, ref, inputs }) {
+      // A dispatch answers 204 with no body: only acceptance is evidence.
+      return effect(
+        "POST",
+        `/repos/${scope}/actions/workflows/${workflowFile}/dispatches`,
+        { ref, inputs: { ...inputs } },
+      );
+    },
+  };
+}
+
+/** A train commit read back and proven to be this train's. */
+export type TrainCommitVerdictV1 =
+  | { readonly ok: true; readonly commit: HostedTrainCommitV1 }
+  | {
+    readonly ok: false;
+    readonly reason: "unreadable" | "manifest" | "parents";
+  };
+
+/**
+ * Commit `sha` is exactly this train's: its message parses to this train id
+ * and manifest and its parents are `[T, H_1..H_k]` (the tree is verified at
+ * landing against the members' reviewed patches).
+ */
+export async function verifyTrainCommitV1(
+  git: HostedTrainGitHubV1,
+  train: DeliveryTrainV1,
+  sha: string,
+): Promise<TrainCommitVerdictV1> {
+  let commit: HostedTrainCommitV1 | null = null;
+  try {
+    commit = await git.readCommit(sha);
+  } catch {
+    commit = null;
+  }
+  if (commit === null) return { ok: false, reason: "unreadable" };
+  try {
+    const parsed = await parseDeliveryTrainCommitMessageV1(commit.message);
+    if (parsed.trainId !== train.trainId) {
+      return { ok: false, reason: "manifest" };
+    }
+  } catch (error) {
+    if (error instanceof RecordParseError) {
+      return { ok: false, reason: "manifest" };
+    }
+    throw error;
+  }
+  return hasDeliveryTrainParentsV1(train.manifest, commit.parents)
+    ? { ok: true, commit }
+    : { ok: false, reason: "parents" };
+}
+
+export type TrainBuildOutcomeV1 =
+  | { readonly kind: "built" | "existing"; readonly commit: GitSha }
+  | {
+    readonly kind: "refused";
+    readonly reason:
+      | "base_unreadable"
+      | "tree_refused"
+      | "commit_refused"
+      | "ref_refused"
+      | "existing_invalid";
+  };
+
+/**
+ * Builds the train's commit and ref, or adopts the existing ref when it
+ * already names this train's verified commit. `existing` is the commit the
+ * ref names in this pass's listing, if any. `changes` is the overlay union.
+ */
+export async function buildTrainV1(input: {
+  readonly git: HostedTrainGitHubV1;
+  readonly train: DeliveryTrainV1;
+  readonly changes: readonly TrainTreeChangeV1[];
+  readonly existing: string | null;
+}): Promise<TrainBuildOutcomeV1> {
+  const { git, train } = input;
+  const ref = deliveryTrainRefV1(train.trainId);
+  const adopt = async (sha: string): Promise<TrainBuildOutcomeV1> => {
+    const verdict = await verifyTrainCommitV1(git, train, sha);
+    return verdict.ok
+      ? { kind: "existing", commit: sha as GitSha }
+      : { kind: "refused", reason: "existing_invalid" };
+  };
+  if (input.existing !== null) return await adopt(input.existing);
+  const base = await git.readCommit(train.manifest.base);
+  if (base === null) return { kind: "refused", reason: "base_unreadable" };
+  const tree = await git.createTree({
+    baseTree: base.tree,
+    changes: input.changes,
+  });
+  if (tree === null) return { kind: "refused", reason: "tree_refused" };
+  const commit = await git.createCommit({
+    message: deliveryTrainCommitMessageV1(train),
+    tree,
+    parents: deliveryTrainParentsV1(train.manifest),
+  });
+  if (commit === null) return { kind: "refused", reason: "commit_refused" };
+  if (await git.createRef(ref, commit)) {
+    return { kind: "built", commit: commit as GitSha };
+  }
+  // A refused create: the ref may exist (another pass built it first). Read
+  // it back and adopt it only when it names this train's verified commit.
+  const refs = await git.listTrainRefs();
+  const found = refs?.find((row) => row.ref === ref);
+  return found === undefined
+    ? { kind: "refused", reason: "ref_refused" }
+    : await adopt(found.sha);
+}
