+/**
+ * The delivery-train runtime handoff over the production train facts
+ * (`src/github/git-train-drift.ts`) on a REAL temporary Git repository,
+ * through the real delivery step: a member whose reviewed paths the tip left
+ * alone defers with no write, a drifted one takes the legacy refresh, and
+ * once a train commit `[T, H]` carrying the manifest is the tip the pull
+ * request waits for the launcher's booking. Synthetic files only; the
+ * GitHub port is a fake and nothing is written to any remote.
+ */
+import assert from "node:assert/strict";
+import type { GitSha } from "../../src/contracts/brands.ts";
+import {
+  deliveryTrainCommitMessageV1,
+  deliveryTrainManifestV1,
+  deliveryTrainV1,
+} from "../../src/contracts/delivery-train.ts";
+import {
+  isTrainAncestorWithGit,
+  readTrainCommitWithGit,
+  readTrainMemberPatchWithGit,
+} from "../../src/github/git-train-drift.ts";
+import type { TrainHandoffPortV1 } from "../../src/repair/loop-train-handoff.ts";
+import { REPO, T0 } from "../state/helpers.ts";
+import {
+  authorizingReceipt,
+  BASE_BRANCH,
+  openPull,
+  reviewedRecord,
+  TrainGithub,
+  trainMember,
+  trainRig,
+} from "./train-handoff-rig.ts";
+import { makeTrainRepo, type TrainRepoV1 } from "./train-repo.ts";
+
+function gitFacts(repo: TrainRepoV1): TrainHandoffPortV1 {
+  return {
+    mode: () => "on",
+    readMemberPatch: (request) =>
+      readTrainMemberPatchWithGit(repo.run, request),
+    readCommit: (sha) => readTrainCommitWithGit(repo.run, sha),
+    isAncestor: (ancestor, descendant) =>
+      isTrainAncestorWithGit(repo.run, ancestor, descendant),
+  };
+}
+
+async function history(repo: TrainRepoV1) {
+  const b0 = await repo.commit({ "src/app.ts": "v0\n", "README": "r\n" });
+  assert.ok((await repo.git(["checkout", "-q", "-b", "candidate"])).ok);
+  const h = await repo.commit({ "src/app.ts": "v1\n" });
+  assert.ok((await repo.git(["checkout", "-q", "development"])).ok);
+  const clean = await repo.commit({ "README": "r2\n" });
+  assert.ok((await repo.git(["reset", "-q", "--hard", b0])).ok);
+  const drifted = await repo.commit({ "src/app.ts": "tip\n" });
+  return { b0, h, clean, drifted };
+}
+
+async function stepAt(
+  repo: TrainRepoV1,
+  b0: GitSha,
+  h: GitSha,
+  github: TrainGithub,
+) {
+  const receipt = await authorizingReceipt(h, b0);
+  const record = reviewedRecord(h, b0, receipt);
+  const rig = trainRig(github, gitFacts(repo), T0);
+  await rig.seed([record], { reviews: [receipt] });
+  const step = await rig.step();
+  return { step, rig, record, receipt };
+}
+
+Deno.test("train handoff over git: an untouched member defers, a drifted one refreshes, a landed one awaits booking", async () => {
+  const repo = await makeTrainRepo();
+  try {
+    const { b0, h, clean, drifted } = await history(repo);
+
+    const member = await stepAt(
+      repo,
+      b0,
+      h,
+      new TrainGithub(clean, openPull(h, b0)),
+    );
+    assert.deepEqual(member.step, {
+      kind: "deferred",
+      detail: "delivery train: pending",
+    });
+    assert.deepEqual((await member.rig.snapshot()).work[0], member.record);
+    assert.equal(member.rig.merges(), 0);
+
+    const drift = new TrainGithub(drifted, openPull(h, b0));
+    const ejected = await stepAt(repo, b0, h, drift);
+    assert.deepEqual(ejected.step, { kind: "progress" });
+    const refreshed = (await ejected.rig.snapshot()).work[0];
+    assert.equal(refreshed.intent?.kind, "base_refresh");
+    assert.equal(refreshed.intent?.observedBase, drifted);
+    assert.equal(refreshed.target.head, h, "the reviewed head is kept");
+    assert.equal(ejected.rig.merges(), 0);
+
+    // The launcher's train at `clean` lands as the octopus [clean, h].
+    const train = await deliveryTrainV1(deliveryTrainManifestV1({
+      repository: { owner: REPO.owner, name: REPO.name },
+      branch: BASE_BRANCH,
+      base: clean,
+      members: [trainMember(h, member.receipt)],
+    }));
+    const built = await repo.git([
+      "commit-tree",
+      await repo.rev(`${h}^{tree}`),
+      "-p",
+      clean,
+      "-p",
+      h,
+      "-m",
+      deliveryTrainCommitMessageV1(train),
+    ]);
+    assert.ok(built.ok);
+    const c = built.stdout.trim() as GitSha;
+    const landed = await stepAt(
+      repo,
+      b0,
+      h,
+      new TrainGithub(c, { ...openPull(h, b0), state: "merged", mergeSha: c }),
+    );
+    assert.deepEqual(landed.step, {
+      kind: "deferred",
+      detail: `delivery train: train_booking_pending ${train.trainId}`,
+    });
+    const after = await landed.rig.snapshot();
+    assert.deepEqual(after.work[0], landed.record);
+    assert.equal(after.releaseRequests.length, 0);
+  } finally {
+    await repo.cleanup();
+  }
+});
