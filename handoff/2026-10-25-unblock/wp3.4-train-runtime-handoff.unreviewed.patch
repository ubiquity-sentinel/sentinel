+/**
+ * The delivery-train runtime handoff rig: the REAL repair loop over
+ * in-memory state, a recording fake GitHub port serving one pull request,
+ * the tip, `sentinel-train/*` refs and per-commit checks, an injected clock
+ * and an optional injected train facts port. No network, no GitHub write,
+ * no model call.
+ */
+import assert from "node:assert/strict";
+import { RollingStartBudget } from "../../src/budget/mod.ts";
+import {
+  asWorkItemId,
+  type GitSha,
+  type WorkItemId,
+} from "../../src/contracts/brands.ts";
+import {
+  type DeliveryTrainId,
+  deliveryTrainIdV1,
+  deliveryTrainManifestV1,
+  type DeliveryTrainMemberV1,
+} from "../../src/contracts/delivery-train.ts";
+import type {
+  GitHubCheckV1,
+  GitHubPullRequestV1,
+  GitHubRefV1,
+  PortResultV1,
+} from "../../src/contracts/ports.ts";
+import { portError, portOk } from "../../src/contracts/ports.ts";
+import type { ReviewReceiptV1 } from "../../src/contracts/review-receipt.ts";
+import type { RepairStateSnapshotV1 } from "../../src/contracts/state-snapshots.ts";
+import type { WorkRecordV1 } from "../../src/contracts/work-record.ts";
+import { DurableGitHubCooldownGate } from "../../src/repair/github-cooldown.ts";
+import {
+  mergeIntentKey,
+  reviewOperationKey,
+  reviewReceiptId,
+} from "../../src/repair/keys.ts";
+import { loadRepairContext, runRepairCycle } from "../../src/repair/loop.ts";
+import type {
+  RepairCycleDepsV1,
+  StepResultV1,
+} from "../../src/repair/loop-types.ts";
+import { executeDeliveryStep } from "../../src/repair/loop-work.ts";
+import type {
+  TrainHandoffDepsV1,
+  TrainHandoffPortV1,
+} from "../../src/repair/loop-train-handoff.ts";
+import { REPO, SHA1, T0 } from "../state/helpers.ts";
+import {
+  FakeClock,
+  FakeGithub,
+  type FakeGithubOptionsV1,
+  FakeIncidents,
+  FakeModel,
+  FakeReplay,
+  MemoryState,
+  repairConfigs,
+} from "./helpers.ts";
+import { exactOpenPr } from "./loop-candidate-fixtures.ts";
+import { seededSnapshot } from "./loop-rig.ts";
+import { completedReceipt, deliveryRecord } from "./loop-review-fixtures.ts";
+
+export const BRANCH = "sentinel/repair/issue-1";
+export const BASE_BRANCH = "development";
+export const RECORD_ID: WorkItemId = asWorkItemId("issue-1");
+
+function green(head: GitSha): GitHubCheckV1 {
+  return {
+    name: "ci",
+    status: "completed",
+    conclusion: "success",
+    head,
+    startedAt: 1,
+    completedAt: 2,
+  };
+}
+
+/** A fake port serving the tip, one pull request, train refs and checks. */
+export class TrainGithub extends FakeGithub {
+  tip: GitSha;
+  pull: GitHubPullRequestV1;
+  readonly trainRefs = new Map<string, GitSha>();
+  readonly checksBySha = new Map<string, GitHubCheckV1[]>();
+  readonly parentsBySha = new Map<string, GitSha[]>();
+  prepareCalls = 0;
+
+  constructor(
+    tip: GitSha,
+    pull: GitHubPullRequestV1,
+    options: FakeGithubOptionsV1 = {},
+  ) {
+    super(options);
+    this.tip = tip;
+    this.pull = pull;
+    this.prepareBaseRefresh = () => {
+      this.prepareCalls++;
+      return Promise.resolve(portError("unavailable", "prepared unavailable"));
+    };
+  }
+
+  override readRef(ref: string): Promise<PortResultV1<GitHubRefV1 | null>> {
+    this.calls.push(`readRef:${ref}`);
+    if (ref === `refs/heads/${BASE_BRANCH}`) {
+      return Promise.resolve(portOk({ ref, sha: this.tip }));
+    }
+    if (ref === `refs/heads/${BRANCH}`) {
+      return Promise.resolve(portOk({ ref, sha: this.pull.head }));
+    }
+    const train = this.trainRefs.get(ref);
+    return Promise.resolve(
+      portOk(train === undefined ? null : { ref, sha: train }),
+    );
+  }
+
+  override readPullRequest(
+    number: number,
+  ): Promise<PortResultV1<GitHubPullRequestV1 | null>> {
+    this.calls.push(`readPr:${number}`);
+    return Promise.resolve(
+      portOk(number === this.pull.number ? { ...this.pull } : null),
+    );
+  }
+
+  override findPullRequestByHeadRef(
+    headRef: string,
+  ): Promise<PortResultV1<GitHubPullRequestV1 | null>> {
+    this.calls.push(`findPr:${headRef}`);
+    return Promise.resolve(
+      portOk(headRef === this.pull.headRef ? { ...this.pull } : null),
+    );
+  }
+
+  override readChecks(head: GitSha) {
+    this.calls.push(`readChecks:${head}`);
+    return Promise.resolve(portOk({
+      head,
+      checks: this.checksBySha.get(head) ?? [green(head)],
+    }));
+  }
+
+  readCommitParents(sha: GitSha): Promise<PortResultV1<GitSha[] | null>> {
+    this.calls.push(`readParents:${sha}`);
+    return Promise.resolve(portOk(this.parentsBySha.get(sha) ?? null));
+  }
+}
+
+/** The clean current-head receipt that authorizes (7, head, base). */
+export async function authorizingReceipt(
+  head: GitSha,
+  base: GitSha = SHA1,
+): Promise<ReviewReceiptV1> {
+  return completedReceipt(7, head, base, {
+    id: await reviewReceiptId(reviewOperationKey(7, head, 1), head),
+  });
+}
+
+/** The reviewed delivery record of PR 7 at `head` on `base`. */
+export function reviewedRecord(
+  head: GitSha,
+  base: GitSha = SHA1,
+  receipt?: ReviewReceiptV1,
+  intentAt?: number,
+): WorkRecordV1 {
+  return deliveryRecord(head, {
+    target: { base, branch: BRANCH, checkpoint: null, head, pr: 7 },
+    intent: intentAt === undefined || receipt === undefined ? null : {
+      kind: "merge",
+      key: mergeIntentKey(7, head),
+      startedAt: intentAt,
+      branch: BRANCH,
+      expectedHead: head,
+      observedBase: base,
+      pr: 7,
+      requestId: receipt.requestId,
+      resultId: receipt.resultId,
+    },
+  });
+}
+
+/** The open pull request of the reviewed record. */
+export function openPull(head: GitSha, base: GitSha = SHA1) {
+  return exactOpenPr(7, head, BRANCH, base);
+}
+
+/** The exact member tuple the record and its receipt name. */
+export function trainMember(
+  head: GitSha,
+  receipt: ReviewReceiptV1,
+): DeliveryTrainMemberV1 {
+  return {
+    recordId: RECORD_ID,
+    pr: 7,
+    head,
+    reviewedBase: receipt.pullRequest.base,
+    receiptId: receipt.id,
+    issueNumber: 1,
+  };
+}
+
+/** The singleton train `(tip, [member])`'s id. */
+export function singletonId(
+  tip: GitSha,
+  member: DeliveryTrainMemberV1,
+): Promise<DeliveryTrainId> {
+  return deliveryTrainIdV1(deliveryTrainManifestV1({
+    repository: { owner: REPO.owner, name: REPO.name },
+    branch: BASE_BRANCH,
+    base: tip,
+    members: [member],
+  }));
+}
+
+export interface TrainRigV1 {
+  readonly clock: FakeClock;
+  readonly state: MemoryState;
+  readonly github: TrainGithub;
+  readonly model: FakeModel;
+  run(): Promise<Awaited<ReturnType<typeof runRepairCycle>>>;
+  /** One real delivery step of the first record (its exact result). */
+  step(): Promise<StepResultV1>;
+  snapshot(): Promise<RepairStateSnapshotV1>;
+  seed(
+    work: WorkRecordV1[],
+    extra?: Partial<RepairStateSnapshotV1>,
+  ): Promise<void>;
+  merges(): number;
+}
+
+/** `train` undefined: a host with no train facts port at all. */
+export function trainRig(
+  github: TrainGithub,
+  train?: TrainHandoffPortV1,
+  now: number = T0,
+): TrainRigV1 {
+  const clock = new FakeClock(now);
+  const state = new MemoryState();
+  const configs = repairConfigs({
+    adapter: { kind: "github" },
+    sessionBound: { maxDurationMs: 240_000, maxOutputChars: 200_000 },
+  });
+  const budget = new RollingStartBudget({ clock, state, configs });
+  const githubCooldown = new DurableGitHubCooldownGate({ state, clock });
+  const model = new FakeModel({ head: SHA1, changedPaths: ["src/app.ts"] });
+  const deps: RepairCycleDepsV1 & TrainHandoffDepsV1 = {
+    clock,
+    state,
+    configs,
+    controllerSha: SHA1,
+    github,
+    githubCooldown,
+    incidents: new FakeIncidents({ summaries: [], evidence: null }),
+    replay: new FakeReplay(),
+    model,
+    budget,
+    ...(train === undefined ? {} : { deliveryTrain: train }),
+  };
+  const snapshot = async () => {
+    const read = await state.readRepair();
+    assert.ok(read.ok && read.value.status === "found");
+    if (!read.ok || read.value.status !== "found") {
+      throw new Error("no repair state");
+    }
+    return read.value.snapshot;
+  };
+  return {
+    clock,
+    state,
+    github,
+    model,
+    run: () =>
+      runRepairCycle(deps, {
+        deadline: clock.now() + 60 * 60_000,
+        stepLimit: 16,
+      }),
+    step: async () => {
+      const at = clock.now();
+      const context = await loadRepairContext(deps, {
+        runDeadline: at + 60 * 60_000,
+        modelCutoff: at + 60 * 60_000,
+      });
+      assert.ok(context !== null);
+      return await executeDeliveryStep(deps, context, context.snapshot.work[0]);
+    },
+    snapshot,
+    seed: async (work, extra = {}) => {
+      const written = await state.writeRepair(
+        seededSnapshot(work, extra),
+        null,
+      );
+      assert.ok(written.ok && written.value.status === "applied");
+    },
+    merges: () => github.calls.filter((call) => call === "merge").length,
+  };
+}
+
+/** A facts port that fails the test if the handoff reads it. */
+export function untouchedPort(
+  mode: "off" | "plan_only",
+): TrainHandoffPortV1 {
+  const fail = (): never => {
+    throw new Error("a train fact was read");
+  };
+  return {
+    mode: () => mode,
+    readMemberPatch: fail,
+    readTrainCi: fail,
+    readCommit: fail,
+    isAncestor: fail,
+  };
+}
