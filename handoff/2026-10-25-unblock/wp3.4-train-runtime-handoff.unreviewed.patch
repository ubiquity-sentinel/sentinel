+/**
+ * A real temporary Git repository for the delivery-train runtime facts
+ * (`src/github/git-train-drift.ts`): synthetic files only, no remote, no
+ * network and no credentials. The runner has the trusted executor's shape.
+ */
+import assert from "node:assert/strict";
+import type { GitSha } from "../../src/contracts/brands.ts";
+import type { TrainGitRunV1 } from "../../src/github/git-train-drift.ts";
+
+const HERE = new URL(import.meta.url);
+if (HERE.protocol !== "file:") throw new Error("expected a file: test module");
+const ROOT = decodeURIComponent(HERE.pathname).replace(
+  /\/tests\/repair\/train-repo\.ts$/,
+  "",
+);
+const TRUSTED_PATH = Deno.env.get("PATH") ?? "/usr/bin:/bin";
+
+export interface TrainRepoV1 {
+  readonly dir: string;
+  /** The bounded read-only runner the train facts take. */
+  readonly run: TrainGitRunV1;
+  git(args: string[]): Promise<{ ok: boolean; stdout: string }>;
+  /** Writes (string/bytes) or deletes (null) files, then commits them all. */
+  commit(files: Record<string, string | Uint8Array | null>): Promise<GitSha>;
+  /** `git rev-parse <rev>` (a commit, or `<commit>:<path>` for a blob). */
+  rev(rev: string): Promise<string>;
+  cleanup(): Promise<void>;
+}
+
+export async function makeTrainRepo(): Promise<TrainRepoV1> {
+  const tmp = await Deno.makeTempDir({ prefix: "sentinel-train-", dir: ROOT });
+  const env = {
+    PATH: TRUSTED_PATH,
+    HOME: `${tmp}/home`,
+    GIT_CONFIG_GLOBAL: "/dev/null",
+    GIT_CONFIG_SYSTEM: "/dev/null",
+    GIT_TERMINAL_PROMPT: "0",
+    GIT_AUTHOR_NAME: "sentinel-train-test",
+    GIT_AUTHOR_EMAIL: "sentinel-train-test@localhost",
+    GIT_COMMITTER_NAME: "sentinel-train-test",
+    GIT_COMMITTER_EMAIL: "sentinel-train-test@localhost",
+  };
+  await Deno.mkdir(`${tmp}/home`, { recursive: true });
+  const dir = `${tmp}/repo`;
+  await Deno.mkdir(dir, { recursive: true });
+  const exec = async (args: string[]) => {
+    const out = await new Deno.Command("git", {
+      args,
+      cwd: dir,
+      clearEnv: true,
+      env,
+      stdout: "piped",
+      stderr: "piped",
+    }).output();
+    return out;
+  };
+  const git = async (args: string[]) => {
+    const out = await exec(args);
+    return { ok: out.success, stdout: new TextDecoder().decode(out.stdout) };
+  };
+  const run: TrainGitRunV1 = async (args, maxOutputBytes) => {
+    const out = await exec(args);
+    const overflow = out.stdout.byteLength > maxOutputBytes;
+    return {
+      ok: out.success && !overflow,
+      code: out.code,
+      stdout: new TextDecoder().decode(out.stdout),
+      stdoutBytes: out.stdout,
+      ...(overflow ? { overflow: true } : {}),
+    };
+  };
+  assert.ok((await git(["init", "-q", "-b", "development"])).ok);
+  const commit = async (files: Record<string, string | Uint8Array | null>) => {
+    for (const [name, content] of Object.entries(files)) {
+      const path = `${dir}/${name}`;
+      if (content === null) {
+        await Deno.remove(path, { recursive: true });
+        continue;
+      }
+      const slash = name.lastIndexOf("/");
+      if (slash > 0) {
+        await Deno.mkdir(`${dir}/${name.slice(0, slash)}`, {
+          recursive: true,
+        });
+      }
+      if (typeof content === "string") await Deno.writeTextFile(path, content);
+      else await Deno.writeFile(path, content);
+    }
+    assert.ok((await git(["add", "-A"])).ok);
+    assert.ok((await git(["commit", "-q", "--allow-empty", "-m", "c"])).ok);
+    return (await git(["rev-parse", "HEAD"])).stdout.trim() as GitSha;
+  };
+  const rev = async (name: string) => {
+    const out = await git(["rev-parse", name]);
+    assert.ok(out.ok, `rev-parse ${name}`);
+    return out.stdout.trim();
+  };
+  return {
+    dir,
+    run,
+    git,
+    commit,
+    rev,
+    cleanup: () => Deno.remove(tmp, { recursive: true }).catch(() => {}),
+  };
+}
