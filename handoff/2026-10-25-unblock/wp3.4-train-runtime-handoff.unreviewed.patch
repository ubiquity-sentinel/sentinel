new file mode 100644
index 0000000000..922793bdc6
--- /dev/null
+++ b/src/github/git-train-drift.ts
@@ -0,0 +1,388 @@
+/**
+ * Delivery-train runtime facts over the trusted local object store (redesign
+ * 2026-10-25 C12, WP3.4). The runtime handoff (`loop-train-handoff.ts`)
+ * decides from the same pure overlay rule as the launcher
+ * (`computeTrainOverlayV1`), so this module only reads git:
+ *
+ * - R_m, a member's reviewed patch: the raw tree change list between the
+ *   unique merge base of its reviewed base and its head, and the head
+ *   (`git diff-tree -r --raw --no-abbrev -z --no-renames`), as the
+ *   (path, oldMode, oldBlob, newMode, newBlob) tuples the launcher derives
+ *   from GitHub's Git trees (`mergeBaseTreeChanges`);
+ * - T's entries over exactly the paths the drift rule reads: every changed
+ *   path and every parent directory of an added path (`git ls-tree T --
+ *   <paths>`, literal pathspecs, non-recursive) and every non-directory path
+ *   under an added path (`git ls-tree -r T -- <added paths>`). Any other path
+ *   is "not known", so the rule can never pass on a fact it did not read;
+ * - a landing commit's parents and message (`git cat-file commit`) and one
+ *   ancestry fact (`git merge-base --is-ancestor`), for train landing
+ *   recognition (`verifyTrainLandingV1`).
+ *
+ * Every command only reads the local object store: no checkout, index or
+ * ref update, no hook, no network and no credential. A missing object, an
+ * ambiguous merge base, a bound or unparsable output is a typed failure,
+ * never a fact.
+ */
+import { type GitSha, isGitSha } from "../contracts/brands.ts";
+import { portError, portOk, type PortResultV1 } from "../contracts/ports.ts";
+import type {
+  TrainBaseTreeV1,
+  TrainTreeChangeV1,
+  TrainTreeEntryV1,
+} from "../repair/train-overlay.ts";
+import type { CarriedPatchGitRunV1 } from "./git-carried-patch.ts";
+
+/** One bounded git run over the trusted local store. */
+export type TrainGitRunV1 = CarriedPatchGitRunV1;
+
+/** Bound on one listing (bytes); a larger listing is no fact. */
+export const TRAIN_GIT_MAX_OUTPUT_BYTES = 16 * 1024 * 1024;
+/** Bound on one commit object read (a maximal train message is ~70 KB). */
+const COMMIT_MAX_BYTES = 1024 * 1024;
+const SMALL_OUTPUT_BYTES = 64 * 1024;
+/** Pathspecs per `ls-tree` run (argv stays bounded). */
+const PATHSPEC_CHUNK = 256;
+/** Bound on one patch's changed paths; a larger patch is no fact. */
+export const TRAIN_GIT_MAX_CHANGES = 20_000;
+
+const STATIC_INPUT = "train git input is invalid";
+const STATIC_OBJECT = "train git input commit is unavailable";
+const STATIC_MERGE_BASE = "train git merge base is not unique";
+const STATIC_READ = "train git read failed";
+const STATIC_BOUND = "train git read exceeded its bound";
+const STATIC_OUTPUT = "train git output is invalid";
+
+const NULL_SHA = "0".repeat(40);
+const OBJECT_ID = /^[0-9a-f]{40}$/;
+const ENTRY_MODES = new Set(["100644", "100755", "120000", "160000"]);
+
+/** The member patch and T's entries over its paths. */
+export interface TrainMemberPatchV1 {
+  readonly changes: readonly TrainTreeChangeV1[];
+  readonly tree: TrainBaseTreeV1;
+}
+
+export interface TrainMemberPatchRequestV1 {
+  /** The base the authorizing receipt recorded (B0_m). */
+  readonly reviewedBase: GitSha;
+  /** The literal reviewed head (H_m). */
+  readonly head: GitSha;
+  /** The tip T the overlay is computed on. */
+  readonly base: GitSha;
+}
+
+/** A commit's exact parents and message. */
+export interface TrainGitCommitV1 {
+  readonly parents: readonly GitSha[];
+  readonly message: string;
+}
+
+function failure(result: { timeout?: boolean; overflow?: boolean }) {
+  return result.timeout === true || result.overflow === true
+    ? portError("unavailable", STATIC_BOUND)
+    : portError("unavailable", STATIC_READ);
+}
+
+/**
+ * The exact output text: a path or message that is not valid UTF-8 cannot
+ * be named exactly (nor through the Git Data API), so it is no fact.
+ */
+function exactText(
+  result: { stdout: string; stdoutBytes?: Uint8Array },
+): string | null {
+  if (result.stdoutBytes === undefined) return result.stdout;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(
+      result.stdoutBytes,
+    );
+  } catch {
+    return null;
+  }
+}
+
+function byPath(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function parentDirs(path: string): string[] {
+  const parts = path.split("/");
+  return parts.slice(1).map((_, index) => parts.slice(0, index + 1).join("/"));
+}
+
+async function commitExists(
+  run: TrainGitRunV1,
+  sha: GitSha,
+): Promise<PortResultV1<boolean>> {
+  const result = await run(
+    ["rev-parse", "--verify", "--quiet", `${sha}^{commit}`],
+    SMALL_OUTPUT_BYTES,
+  );
+  if (result.ok) return portOk(result.stdout.trim() === sha);
+  if (result.code === 1) return portOk(false);
+  return portError("unavailable", STATIC_OBJECT);
+}
+
+async function uniqueMergeBase(
+  run: TrainGitRunV1,
+  a: GitSha,
+  b: GitSha,
+): Promise<PortResultV1<GitSha>> {
+  const result = await run(["merge-base", "--all", a, b], SMALL_OUTPUT_BYTES);
+  if (!result.ok) {
+    return result.code === 1
+      ? portError("conflict", STATIC_MERGE_BASE)
+      : portError("unavailable", STATIC_MERGE_BASE);
+  }
+  const bases = result.stdout.split("\n").map((line) => line.trim())
+    .filter((line) => line.length > 0);
+  if (bases.length !== 1 || !isGitSha(bases[0])) {
+    return portError("conflict", STATIC_MERGE_BASE);
+  }
+  return portOk(bases[0] as GitSha);
+}
+
+function side(mode: string, sha: string) {
+  return mode === "000000" && sha === NULL_SHA
+    ? { mode: null, sha: null }
+    : { mode, sha };
+}
+
+/**
+ * Parses `diff-tree -r -z --raw --no-abbrev --no-renames` output: records
+ * `:<old> <new> <oldSha> <newSha> <status>` NUL `<path>` NUL. Null when the
+ * output is not exactly that shape.
+ */
+export function parseTrainRawDiffV1(
+  stdout: string,
+): TrainTreeChangeV1[] | null {
+  if (stdout.length === 0) return [];
+  if (!stdout.endsWith("\0")) return null;
+  const fields = stdout.slice(0, -1).split("\0");
+  if (fields.length % 2 !== 0) return null;
+  const changes: TrainTreeChangeV1[] = [];
+  for (let i = 0; i < fields.length; i += 2) {
+    const head =
+      /^:([0-7]{6}) ([0-7]{6}) ([0-9a-f]{40}) ([0-9a-f]{40}) ([ADMT])$/
+        .exec(fields[i]);
+    const path = fields[i + 1];
+    if (head === null || path.length === 0) return null;
+    const before = side(head[1], head[3]);
+    const after = side(head[2], head[4]);
+    if (
+      (before.mode !== null && !ENTRY_MODES.has(before.mode)) ||
+      (after.mode !== null && !ENTRY_MODES.has(after.mode))
+    ) return null;
+    changes.push({
+      path,
+      oldMode: before.mode,
+      oldSha: before.sha,
+      newMode: after.mode,
+      newSha: after.sha,
+    });
+  }
+  if (changes.length > TRAIN_GIT_MAX_CHANGES) return null;
+  return changes.sort((a, b) => byPath(a.path, b.path));
+}
+
+/** R_m: the raw change list from the unique merge base of B0 and H to H. */
+export async function readTrainMemberChangesWithGit(
+  run: TrainGitRunV1,
+  reviewedBase: GitSha,
+  head: GitSha,
+): Promise<PortResultV1<TrainTreeChangeV1[]>> {
+  const mergeBase = await uniqueMergeBase(run, reviewedBase, head);
+  if (!mergeBase.ok) return mergeBase;
+  const result = await run([
+    "diff-tree",
+    "-r",
+    "-z",
+    "--raw",
+    "--no-abbrev",
+    "--no-renames",
+    "--no-commit-id",
+    "--ignore-submodules=none",
+    mergeBase.value,
+    head,
+    "--",
+  ], TRAIN_GIT_MAX_OUTPUT_BYTES);
+  if (!result.ok) return failure(result);
+  const text = exactText(result);
+  const changes = text === null ? null : parseTrainRawDiffV1(text);
+  return changes === null
+    ? portError("invalid", STATIC_OUTPUT)
+    : portOk(changes);
+}
+
+interface LsTreeEntry {
+  readonly path: string;
+  readonly mode: string;
+  readonly type: string;
+  readonly sha: string;
+}
+
+/** Parses `ls-tree -z` output (`<mode> <type> <sha>` TAB `<path>` NUL). */
+export function parseTrainLsTreeV1(stdout: string): LsTreeEntry[] | null {
+  if (stdout.length === 0) return [];
+  if (!stdout.endsWith("\0")) return null;
+  const entries: LsTreeEntry[] = [];
+  for (const line of stdout.slice(0, -1).split("\0")) {
+    const match = /^([0-7]{6}) (blob|tree|commit) ([0-9a-f]{40})\t(.+)$/s
+      .exec(line);
+    if (match === null) return null;
+    const [, mode, type, sha, path] = match;
+    const valid = type === "tree"
+      ? mode === "040000"
+      : type === "commit"
+      ? mode === "160000"
+      : mode === "100644" || mode === "100755" || mode === "120000";
+    if (!valid || !OBJECT_ID.test(sha)) return null;
+    entries.push({ path, mode, type, sha });
+  }
+  return entries;
+}
+
+async function lsTree(
+  run: TrainGitRunV1,
+  base: GitSha,
+  paths: readonly string[],
+  recursive: boolean,
+): Promise<PortResultV1<LsTreeEntry[]>> {
+  const out: LsTreeEntry[] = [];
+  for (let i = 0; i < paths.length; i += PATHSPEC_CHUNK) {
+    const result = await run([
+      "--literal-pathspecs",
+      "ls-tree",
+      ...(recursive ? ["-r"] : []),
+      "-z",
+      "--full-tree",
+      base,
+      "--",
+      ...paths.slice(i, i + PATHSPEC_CHUNK),
+    ], TRAIN_GIT_MAX_OUTPUT_BYTES);
+    if (!result.ok) return failure(result);
+    const text = exactText(result);
+    const entries = text === null ? null : parseTrainLsTreeV1(text);
+    if (entries === null) return portError("invalid", STATIC_OUTPUT);
+    out.push(...entries);
+  }
+  return portOk(out);
+}
+
+/**
+ * T's entries over exactly the paths the drift rule reads for `changes`.
+ * `entry` answers for every changed path and every parent directory of an
+ * added path (a directory is no non-directory entry: null); `pathsUnder`
+ * answers for every added path. Every other path is `undefined`.
+ */
+export async function readTrainBaseTreeWithGit(
+  run: TrainGitRunV1,
+  base: GitSha,
+  changes: readonly TrainTreeChangeV1[],
+): Promise<PortResultV1<TrainBaseTreeV1>> {
+  const added = changes.filter((change) => change.newMode !== null)
+    .map((change) => change.path);
+  const known = new Set(changes.map((change) => change.path));
+  for (const path of added) parentDirs(path).forEach((dir) => known.add(dir));
+  const exact = await lsTree(run, base, [...known].sort(byPath), false);
+  if (!exact.ok) return exact;
+  const entries = new Map<string, TrainTreeEntryV1>();
+  for (const entry of exact.value) {
+    if (entry.type !== "tree" && known.has(entry.path)) {
+      entries.set(entry.path, { mode: entry.mode, sha: entry.sha });
+    }
+  }
+  const under = new Map<string, string[]>(added.map((path) => [path, []]));
+  if (added.length > 0) {
+    const listed = await lsTree(run, base, added, true);
+    if (!listed.ok) return listed;
+    for (const entry of listed.value) {
+      for (const dir of parentDirs(entry.path)) {
+        under.get(dir)?.push(entry.path);
+      }
+    }
+  }
+  return portOk({
+    entry: (path) => known.has(path) ? entries.get(path) ?? null : undefined,
+    pathsUnder: (dir) => under.get(dir),
+  });
+}
+
+/**
+ * The member's R_m and T's entries over its paths, after proving all three
+ * commits exist locally (the host restores them first).
+ */
+export async function readTrainMemberPatchWithGit(
+  run: TrainGitRunV1,
+  request: TrainMemberPatchRequestV1,
+): Promise<PortResultV1<TrainMemberPatchV1>> {
+  const { reviewedBase, head, base } = request;
+  if (![reviewedBase, head, base].every((sha) => isGitSha(sha))) {
+    return portError("invalid", STATIC_INPUT);
+  }
+  for (const sha of [reviewedBase, head, base]) {
+    const exists = await commitExists(run, sha);
+    if (!exists.ok) return exists;
+    if (!exists.value) return portError("unavailable", STATIC_OBJECT);
+  }
+  const changes = await readTrainMemberChangesWithGit(run, reviewedBase, head);
+  if (!changes.ok) return changes;
+  const tree = await readTrainBaseTreeWithGit(run, base, changes.value);
+  if (!tree.ok) return tree;
+  return portOk({ changes: changes.value, tree: tree.value });
+}
+
+/**
+ * Splits a raw commit object into its parents and message: headers up to
+ * the first blank line (continuation lines start with a space), then the
+ * message bytes exactly. Null when the object is not that shape.
+ */
+export function parseTrainCommitObjectV1(
+  text: string,
+): TrainGitCommitV1 | null {
+  const split = text.indexOf("\n\n");
+  if (split < 0) return null;
+  const headers = text.slice(0, split).split("\n");
+  if (!/^tree [0-9a-f]{40}$/.test(headers[0] ?? "")) return null;
+  const parents: GitSha[] = [];
+  for (const header of headers.slice(1)) {
+    if (!header.startsWith("parent ")) continue;
+    const sha = header.slice("parent ".length);
+    if (!isGitSha(sha)) return null;
+    parents.push(sha);
+  }
+  return { parents, message: text.slice(split + 2) };
+}
+
+/** One commit's parents and message; null when the object is absent. */
+export async function readTrainCommitWithGit(
+  run: TrainGitRunV1,
+  sha: GitSha,
+): Promise<PortResultV1<TrainGitCommitV1 | null>> {
+  if (!isGitSha(sha)) return portError("invalid", STATIC_INPUT);
+  const exists = await commitExists(run, sha);
+  if (!exists.ok) return exists;
+  if (!exists.value) return portOk(null);
+  const result = await run(["cat-file", "commit", sha], COMMIT_MAX_BYTES);
+  if (!result.ok) return failure(result);
+  const text = exactText(result);
+  const commit = text === null ? null : parseTrainCommitObjectV1(text);
+  return commit === null ? portError("invalid", STATIC_OUTPUT) : portOk(commit);
+}
+
+/** Whether `ancestor` is an ancestor of (or equal to) `descendant`. */
+export async function isTrainAncestorWithGit(
+  run: TrainGitRunV1,
+  ancestor: GitSha,
+  descendant: GitSha,
+): Promise<PortResultV1<boolean>> {
+  if (!isGitSha(ancestor) || !isGitSha(descendant)) {
+    return portError("invalid", STATIC_INPUT);
+  }
+  const result = await run(
+    ["merge-base", "--is-ancestor", ancestor, descendant],
+    SMALL_OUTPUT_BYTES,
+  );
+  if (result.ok) return portOk(true);
+  if (result.code === 1) return portOk(false);
+  return portError("unavailable", STATIC_READ);
+}
