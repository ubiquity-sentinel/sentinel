+++ b/tests/repair/train-handoff_test.ts
@@ -0,0 +1,407 @@
+/**
+ * Delivery-train runtime handoff (redesign 2026-10-25 C12, WP3.4) through
+ * the REAL repair loop and its delivery step: on an "on" target an
+ * admissible member gives zero refresh intents and zero merge calls, every
+ * existing merge gate still runs, drift and a red singleton refresh exactly
+ * as the legacy path does, a verified train landing waits for the
+ * launcher's booking with no write, and unprovable facts never park or
+ * book. With the shipped mode "off" (and "plan_only") every path is
+ * unchanged. Fake GitHub port, in-memory state, injected clock; no network,
+ * no GitHub write, no model call.
+ */
+import assert from "node:assert/strict";
+import type { GitSha } from "../../src/contracts/brands.ts";
+import {
+  deliveryTrainCommitMessageV1,
+  deliveryTrainManifestV1,
+  deliveryTrainRefV1,
+  deliveryTrainV1,
+} from "../../src/contracts/delivery-train.ts";
+import { portOk } from "../../src/contracts/ports.ts";
+import type { WorkRecordV1 } from "../../src/contracts/work-record.ts";
+import type { TrainGitCommitV1 } from "../../src/github/git-train-drift.ts";
+import { deliveryTrainModeV1 } from "../../src/host/target-policy.ts";
+import { CHECK_POLL_MS } from "../../src/repair/loop-bounds.ts";
+import type { TrainHandoffPortV1 } from "../../src/repair/loop-train-handoff.ts";
+import type { TrainCiFactV1 } from "../../src/repair/train-bisect.ts";
+import { trainBaseTreeFromEntries } from "../../src/repair/train-overlay.ts";
+import { REPO, SHA1, SHA2, SHA3, T0 } from "../state/helpers.ts";
+import {
+  authorizingReceipt,
+  BASE_BRANCH,
+  openPull,
+  reviewedRecord,
+  singletonId,
+  TrainGithub,
+  trainMember,
+  trainRig,
+  untouchedPort,
+} from "./train-handoff-rig.ts";
+
+const HEAD = SHA3;
+const BASE = SHA1;
+const TIP = SHA2;
+const TRAIN_COMMIT = "c".repeat(40) as GitSha;
+const SINGLETON_COMMIT = "d".repeat(40) as GitSha;
+const OLD_BLOB = "1".repeat(40);
+const NEW_BLOB = "2".repeat(40);
+const TIP_BLOB = "3".repeat(40);
+const NOW = T0 + 2 * CHECK_POLL_MS;
+
+/** R_m = one modified file; T holds `tipBlob` there. */
+function facts(options: {
+  tipBlob?: string;
+  ci?: TrainCiFactV1;
+  commit?: TrainGitCommitV1;
+} = {}): TrainHandoffPortV1 {
+  return {
+    mode: () => "on",
+    readMemberPatch: () =>
+      Promise.resolve(portOk({
+        changes: [{
+          path: "src/app.ts",
+          oldMode: "100644",
+          oldSha: OLD_BLOB,
+          newMode: "100644",
+          newSha: NEW_BLOB,
+        }],
+        tree: trainBaseTreeFromEntries(
+          new Map([["src/app.ts", {
+            mode: "100644",
+            sha: options.tipBlob ?? OLD_BLOB,
+          }]]),
+        ),
+      })),
+    readTrainCi: () =>
+      Promise.resolve(portOk(options.ci ?? { state: "missing" })),
+    ...(options.commit === undefined ? {} : {
+      readCommit: () => Promise.resolve(portOk(options.commit!)),
+    }),
+    isAncestor: () => Promise.resolve(portOk(true)),
+  };
+}
+
+/** Captures the sanitized handoff lines a block emits. */
+async function handoffLines<T>(
+  block: () => Promise<T>,
+): Promise<{ value: T; lines: Record<string, unknown>[] }> {
+  const lines: Record<string, unknown>[] = [];
+  const original = console.log;
+  console.log = (line: unknown) => {
+    if (typeof line === "string" && line.includes("sentinel_train_handoff")) {
+      lines.push(JSON.parse(line));
+    } else original(line);
+  };
+  try {
+    return { value: await block(), lines };
+  } finally {
+    console.log = original;
+  }
+}
+
+async function seeded(
+  github: TrainGithub,
+  port: TrainHandoffPortV1 | undefined,
+  options: { intentAt?: number; head?: GitSha; base?: GitSha } = {},
+) {
+  const head = options.head ?? HEAD;
+  const base = options.base ?? BASE;
+  const receipt = await authorizingReceipt(head, base);
+  const record = reviewedRecord(head, base, receipt, options.intentAt);
+  const rig = trainRig(github, port, NOW);
+  await rig.seed([record], { reviews: [receipt] });
+  return { rig, record, receipt };
+}
+
+function assertUntouched(
+  after: { work: WorkRecordV1[]; sequence: number },
+  record: WorkRecordV1,
+) {
+  assert.deepEqual(after.work[0], record, "nothing is written");
+  assert.equal(after.sequence, 1);
+}
+
+Deno.test("train handoff: deliveryTrainModeV1 is off for every target", () => {
+  for (
+    const repository of [
+      { owner: "ubiquity-sentinel", name: "sentinel" },
+      { owner: "ubiquity", name: "ai.ubq.fi" },
+      { owner: "ubiquity", name: "passport.ubq.fi" },
+      { owner: "UBIQUITY", name: "Passport.ubq.fi" },
+      { owner: "example-org", name: "example.app" },
+    ]
+  ) assert.equal(deliveryTrainModeV1(repository), "off");
+});
+
+Deno.test("train handoff: an admissible member on a moved base gives zero refresh intents and zero merge calls", async () => {
+  for (const intentAt of [undefined, T0]) {
+    const github = new TrainGithub(TIP, openPull(HEAD));
+    const { rig, record } = await seeded(github, facts(), { intentAt });
+    const { value: outcome, lines } = await handoffLines(() => rig.run());
+    assert.deepEqual(outcome, {
+      status: "margin",
+      detail: "all eligible work is deferred (cooldown or run bounds)",
+    });
+    const after = await rig.snapshot();
+    assertUntouched(after, record);
+    assert.equal(rig.merges(), 0, "the runtime never merges a train target");
+    assert.equal(github.prepareCalls, 0, "no refresh is prepared");
+    assert.equal(after.releaseRequests.length, 0);
+    assert.equal(after.reservations.length, 0);
+    assert.equal(rig.model.requests.length, 0);
+    assert.deepEqual(lines.at(-1), {
+      version: "v1",
+      kind: "sentinel_train_handoff",
+      mode: "on",
+      prNumber: 7,
+      decision: "member",
+    });
+    // Every existing gate still ran before the deferral: the task re-read
+    // and the exact-head CI read.
+    assert.ok(github.calls.includes("readIssue:1"));
+    assert.ok(github.calls.includes(`readChecks:${HEAD}`));
+    assert.deepEqual(await rig.step(), {
+      kind: "deferred",
+      detail: "delivery train: pending",
+    });
+  }
+});
+
+Deno.test("train handoff: a member in flight names its singleton train and an unmoved base still never merges", async () => {
+  const github = new TrainGithub(BASE, openPull(HEAD));
+  const { rig, record, receipt } = await seeded(
+    github,
+    facts({ ci: { state: "pending", since: NOW } }),
+  );
+  const id = await singletonId(BASE, trainMember(HEAD, receipt));
+  github.trainRefs.set(deliveryTrainRefV1(id), SINGLETON_COMMIT);
+  assert.deepEqual(await rig.step(), {
+    kind: "deferred",
+    detail: `delivery train: ${id}`,
+  });
+  assertUntouched(await rig.snapshot(), record);
+  assert.equal(rig.merges(), 0);
+});
+
+Deno.test("train handoff: a failing gate keeps its own non-merge result (pending head CI waits as today)", async () => {
+  const github = new TrainGithub(TIP, openPull(HEAD));
+  github.checksBySha.set(HEAD, [{
+    name: "ci",
+    status: "in_progress",
+    conclusion: null,
+    head: HEAD,
+    startedAt: 1,
+    completedAt: null,
+  }]);
+  const { rig } = await seeded(github, facts());
+  assert.deepEqual(await rig.step(), { kind: "progress" });
+  const work = (await rig.snapshot()).work[0];
+  assert.equal(work.wait?.reason, "ci_pending");
+  assert.equal(work.intent, null, "no refresh and no merge intent");
+  assert.equal(rig.merges(), 0);
+  assert.equal(github.prepareCalls, 0);
+});
+
+/** The final record of one run of `port` on a moved base (legacy: no port). */
+async function finalRecord(
+  port: TrainHandoffPortV1 | undefined,
+  prepare?: (
+    github: TrainGithub,
+    receipt: Awaited<ReturnType<typeof authorizingReceipt>>,
+  ) => Promise<void>,
+) {
+  const github = new TrainGithub(TIP, openPull(HEAD));
+  const { rig, receipt } = await seeded(github, port);
+  await prepare?.(github, receipt);
+  const outcome = await rig.run();
+  assert.equal(outcome.status, "idle", JSON.stringify(outcome));
+  assert.equal(rig.merges(), 0);
+  return { work: (await rig.snapshot()).work[0], github };
+}
+
+Deno.test("train handoff: drift refreshes exactly as the legacy path does", async () => {
+  const legacy = await finalRecord(undefined);
+  assert.equal(legacy.work.intent?.kind, "base_refresh");
+  assert.equal(legacy.work.intent?.observedBase, TIP);
+  const drifted = await finalRecord(facts({ tipBlob: TIP_BLOB }));
+  assert.deepEqual(drifted.work, legacy.work, "the refresh is the legacy one");
+  assert.equal(drifted.github.prepareCalls, legacy.github.prepareCalls);
+});
+
+Deno.test("train handoff: a singleton train red after its rerun on checks green on the tip refreshes as today", async () => {
+  const legacy = await finalRecord(undefined);
+  const red = await finalRecord(
+    facts({ ci: { state: "red", failed: ["ci"], rerun: true } }),
+    async (github, receipt) => {
+      const id = await singletonId(TIP, trainMember(HEAD, receipt));
+      github.trainRefs.set(deliveryTrainRefV1(id), SINGLETON_COMMIT);
+    },
+  );
+  assert.equal(red.work.intent?.kind, "base_refresh");
+  assert.deepEqual(red.work, legacy.work);
+});
+
+Deno.test("train handoff: a red singleton before its rerun, or red on the tip too, ejects nobody", async () => {
+  for (
+    const variant of [
+      { ci: { state: "red", failed: ["ci"], rerun: false }, tipRed: false },
+      { ci: { state: "red", failed: ["ci"], rerun: true }, tipRed: true },
+    ] as const
+  ) {
+    const github = new TrainGithub(TIP, openPull(HEAD));
+    const { rig, record, receipt } = await seeded(
+      github,
+      facts({ ci: variant.ci }),
+    );
+    const id = await singletonId(TIP, trainMember(HEAD, receipt));
+    github.trainRefs.set(deliveryTrainRefV1(id), SINGLETON_COMMIT);
+    if (variant.tipRed) {
+      github.checksBySha.set(TIP, [{
+        name: "ci",
+        status: "completed",
+        conclusion: "failure",
+        head: TIP,
+        startedAt: 1,
+        completedAt: 2,
+      }]);
+    }
+    assert.deepEqual(await rig.step(), {
+      kind: "deferred",
+      detail: `delivery train: ${id}`,
+    });
+    assertUntouched(await rig.snapshot(), record);
+    assert.equal(github.prepareCalls, 0);
+  }
+});
+
+async function landedCommit(): Promise<{
+  commit: TrainGitCommitV1;
+  trainId: string;
+}> {
+  const receipt = await authorizingReceipt(HEAD);
+  const train = await deliveryTrainV1(deliveryTrainManifestV1({
+    repository: { owner: REPO.owner, name: REPO.name },
+    branch: BASE_BRANCH,
+    base: TIP,
+    members: [trainMember(HEAD, receipt)],
+  }));
+  return {
+    commit: {
+      parents: [TIP, HEAD],
+      message: `${deliveryTrainCommitMessageV1(train)}\n`,
+    },
+    trainId: train.trainId,
+  };
+}
+
+function mergedPull(mergeSha: GitSha) {
+  return { ...openPull(HEAD), state: "merged" as const, mergeSha };
+}
+
+Deno.test("train handoff: a pull request a verified train landed waits for the launcher's booking with no write", async () => {
+  const { commit, trainId } = await landedCommit();
+  for (const intentAt of [undefined, T0]) {
+    const github = new TrainGithub(TRAIN_COMMIT, mergedPull(TRAIN_COMMIT));
+    const { rig, record } = await seeded(github, facts({ commit }), {
+      intentAt,
+    });
+    assert.deepEqual(await rig.step(), {
+      kind: "deferred",
+      detail: `delivery train: train_booking_pending ${trainId}`,
+    });
+    const outcome = await rig.run();
+    assert.equal(outcome.status, "margin", JSON.stringify(outcome));
+    const after = await rig.snapshot();
+    assertUntouched(after, record);
+    assert.equal(after.releaseRequests.length, 0, "the launcher books it");
+    assert.equal(rig.merges(), 0);
+    assert.equal(github.prepareCalls, 0);
+  }
+});
+
+Deno.test("train handoff: an unprovable landing is never parked as a merge off its reviewed base", async () => {
+  // No train commit read and parents that are not [reviewed base, head].
+  const github = new TrainGithub(TRAIN_COMMIT, mergedPull(TRAIN_COMMIT));
+  github.parentsBySha.set(TRAIN_COMMIT, [TIP, HEAD]);
+  const port: TrainHandoffPortV1 = { mode: () => "on" };
+  const { rig, record } = await seeded(github, port, { intentAt: T0 });
+  assert.deepEqual(await rig.step(), {
+    kind: "deferred",
+    detail: "delivery train: facts unavailable (landing)",
+  });
+  assertUntouched(await rig.snapshot(), record);
+});
+
+Deno.test("train handoff: a legacy merge on exactly the reviewed base is still booked on a train target", async () => {
+  const merge = "e".repeat(40) as GitSha;
+  const github = new TrainGithub(merge, mergedPull(merge));
+  github.parentsBySha.set(merge, [BASE, HEAD]);
+  const plain = { parents: [BASE, HEAD], message: "Merge pull request #7\n" };
+  const { rig } = await seeded(github, facts({ commit: plain }), {
+    intentAt: T0,
+  });
+  assert.deepEqual(await rig.step(), { kind: "progress" });
+  const after = await rig.snapshot();
+  assert.equal(after.releaseRequests.length, 1, "booked as today");
+  assert.equal(after.releaseRequests[0].revision, merge);
+  assert.equal(after.work[0].intent, null);
+  assert.notEqual(after.work[0].nextStep, "blocked");
+  assert.equal(rig.merges(), 0);
+});
+
+Deno.test("train handoff: unreadable train facts defer with no write and no refresh", async () => {
+  const github = new TrainGithub(TIP, openPull(HEAD));
+  const { rig, record } = await seeded(github, { mode: () => "on" });
+  assert.deepEqual(await rig.step(), {
+    kind: "deferred",
+    detail: "delivery train: facts unavailable (member patch)",
+  });
+  assertUntouched(await rig.snapshot(), record);
+  assert.equal(github.prepareCalls, 0);
+  assert.equal(rig.merges(), 0);
+});
+
+/** One full run: the final snapshot, every port call and the prepares. */
+async function observed(
+  port: TrainHandoffPortV1 | undefined,
+  tip: GitSha,
+) {
+  const github = new TrainGithub(tip, openPull(HEAD), {
+    mergeOutcome: { outcome: "merged", head: HEAD, mergeSha: TRAIN_COMMIT },
+  });
+  github.parentsBySha.set(TRAIN_COMMIT, [BASE, HEAD]);
+  const { rig } = await seeded(github, port);
+  const outcome = await rig.run();
+  // The in-memory store names each write by a process-wide counter.
+  const snapshot = { ...await rig.snapshot(), stateHead: null };
+  return {
+    outcome,
+    snapshot,
+    calls: [...github.calls],
+    prepares: github.prepareCalls,
+    merges: rig.merges(),
+  };
+}
+
+Deno.test("train handoff: with mode off (or plan_only) the loop is byte-identical on the refresh and merge paths", async () => {
+  for (const tip of [TIP, BASE]) {
+    const legacy = await observed(undefined, tip);
+    const off = await observed(untouchedPort("off"), tip);
+    const { value: plan, lines } = await handoffLines(() =>
+      observed(untouchedPort("plan_only"), tip)
+    );
+    assert.deepEqual(off, legacy);
+    assert.deepEqual(plan, legacy);
+    assert.ok(lines.every((line) => line.decision === "legacy"));
+    // plan_only marks the merge step it would hand off; a moved base takes
+    // the legacy refresh first, so that run reaches no merge step.
+    assert.equal(lines.length > 0, tip === BASE);
+    if (tip === TIP) {
+      assert.equal(legacy.snapshot.work[0].intent?.kind, "base_refresh");
+      assert.equal(legacy.merges, 0);
+    } else {
+      assert.equal(legacy.merges, 1, "the legacy path merges");
+      assert.equal(legacy.snapshot.releaseRequests.length, 1);
+    }
+  }
+});
