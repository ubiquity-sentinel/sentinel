@@ -0,0 +1,388 @@
+/**
+ * Delivery-train runtime facts over a REAL temporary Git repository
+ * (`src/github/git-train-drift.ts`, redesign 2026-10-25 C12, WP3.4): R_m is
+ * the exact merge-base tree change list, T's entries cover exactly the paths
+ * the shared overlay rule reads, and the landing commit and ancestry are
+ * read as facts. Decisions come from the shared pure overlay rule. Synthetic
+ * files only; no network, no credentials, no ref or index update.
+ */
+import assert from "node:assert/strict";
+import type { GitSha } from "../../src/contracts/brands.ts";
+import {
+  deliveryTrainCommitMessageV1,
+  deliveryTrainManifestV1,
+  deliveryTrainV1,
+} from "../../src/contracts/delivery-train.ts";
+import {
+  isTrainAncestorWithGit,
+  parseTrainCommitObjectV1,
+  parseTrainLsTreeV1,
+  parseTrainRawDiffV1,
+  readTrainCommitWithGit,
+  readTrainMemberChangesWithGit,
+  readTrainMemberPatchWithGit,
+} from "../../src/github/git-train-drift.ts";
+import {
+  computeTrainOverlayV1,
+  type TrainOverlayDispositionV1,
+} from "../../src/repair/train-overlay.ts";
+import { verifyTrainLandingV1 } from "../../src/repair/train-proof.ts";
+import { member, REPOSITORY } from "./train-fixtures.ts";
+import { makeTrainRepo, type TrainRepoV1 } from "./train-repo.ts";
+
+const BIN_OLD = new Uint8Array([0, 1, 2, 0xff, 0xfe, 0x80, 0, 3]);
+const BIN_NEW = new Uint8Array([0, 1, 2, 0xff, 0xfd, 0x81, 0, 3, 4]);
+
+/** B0, the reviewed head H on it (text, binary, mode, delete, new dir). */
+async function reviewed(repo: TrainRepoV1) {
+  const b0 = await repo.commit({
+    "a.txt": "a\n",
+    "bin.dat": BIN_OLD,
+    "run.sh": "echo run\n",
+    "old.txt": "old\n",
+  });
+  assert.ok((await repo.git(["checkout", "-q", "-b", "candidate"])).ok);
+  await Deno.chmod(`${repo.dir}/run.sh`, 0o755);
+  const h = await repo.commit({
+    "a.txt": "a reviewed\n",
+    "bin.dat": BIN_NEW,
+    "old.txt": null,
+    "dir/new.txt": "new\n",
+  });
+  assert.ok((await repo.git(["checkout", "-q", "development"])).ok);
+  return { b0, h };
+}
+
+async function disposition(
+  repo: TrainRepoV1,
+  b0: GitSha,
+  h: GitSha,
+  t: GitSha,
+  protectedPaths: readonly string[] = [],
+): Promise<{ disposition: TrainOverlayDispositionV1; path: string | null }> {
+  const patch = await readTrainMemberPatchWithGit(repo.run, {
+    reviewedBase: b0,
+    head: h,
+    base: t,
+  });
+  assert.ok(patch.ok, JSON.stringify(patch));
+  const overlay = computeTrainOverlayV1({
+    base: t,
+    tree: patch.value.tree,
+    protectedPaths,
+    candidates: [{
+      member: member(7, { head: h }),
+      changes: patch.value.changes,
+    }],
+  });
