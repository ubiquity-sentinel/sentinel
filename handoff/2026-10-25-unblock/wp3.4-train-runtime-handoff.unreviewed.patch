--- /dev/null
+++ b/src/repair/loop-train-handoff.ts
@@ -0,0 +1,303 @@
+/**
+ * Delivery-train runtime handoff (redesign 2026-10-25 C12, WP3.4).
+ *
+ * On a target whose `deliveryTrainModeV1` is "on" the launcher delivers by
+ * train: it overlays the path-disjoint reviewed patches of every admissible
+ * member onto the tip T as one octopus commit, tests it and fast-forwards
+ * the default branch to it. The runtime then never merges there, and a
+ * moved base alone never refreshes a member (a refresh changes the head and
+ * spends a review round). `trainHandoff` runs at the top of
+ * `reconcileMergeIntent` and `executeMerge`:
+ *
+ * - a pull request a verified train landing merged (`verifyTrainLandingV1`)
+ *   defers with no write to the launcher's booking (`train_booking_pending`);
+ *   unprovable landing facts defer too, so a train landing is never parked
+ *   as a merge off its reviewed base;
+ * - an open pull request passes every existing merge gate first (queue
+ *   custody, takeover, cooldown, current-head receipt with no unresolved P0,
+ *   task re-read, exact-head CI), unchanged; a failing gate keeps its own
+ *   non-merge result. A record that passes them all is admissible: it
+ *   defers with no write (`delivery train: <trainId|pending>`) unless an
+ *   ejection fact holds (drift, a protected path or a submodule by the
+ *   shared overlay rule, or a red singleton train `(T, [m])`), and then only
+ *   the legacy refresh path runs (`loop-train-facts.ts`);
+ * - unreadable facts defer with no write; nothing is ever inferred from them.
+ *
+ * With "off" (every repository today) the handoff returns at once and every
+ * existing path is unchanged; "plan_only" only logs one sanitized line and
+ * keeps the legacy path. The base-refresh hook (`trainHoldsRefresh`) keeps
+ * a moved base from refreshing a delivery-step record on an "on" target, so
+ * that record reaches this handoff instead.
+ */
+import { parseDeliveryTrainMemberV1 } from "../contracts/delivery-train.ts";
+import type { RepositoryConfigV1 } from "../contracts/repository-config.ts";
+import type { ReviewReceiptV1 } from "../contracts/review-receipt.ts";
+import type { RepositoryIdentityV1 } from "../contracts/shared.ts";
+import { tryParse } from "../contracts/validation.ts";
+import type { WorkRecordV1 } from "../contracts/work-record.ts";
+import { deliveryTrainModeV1 } from "../host/target-policy.ts";
+import { checkGithubCooldown } from "./loop-bounds.ts";
+import { configFor } from "./loop-records.ts";
+import {
+  type DeliveryTrainModeV1,
+  trainLandingFact,
+  trainMemberFact,
+  trainPort,
+} from "./loop-train-facts.ts";
+import type {
+  LoopContextV1,
+  RepairCycleDepsV1,
+  StepResultV1,
+} from "./loop-types.ts";
+
+export type {
+  DeliveryTrainModeV1,
+  TrainHandoffDepsV1,
+  TrainHandoffPortV1,
+} from "./loop-train-facts.ts";
+
+/** The merge entry's legacy refresh path (refresh only, never a merge). */
+export interface TrainMergeEntryV1 {
+  /** The moved-base refresh "as today"; null when the base has not moved. */
+  readonly refresh: () => Promise<StepResultV1 | null>;
+}
+
+/** An open pull request on an "on" target: run the merge gates, then admit. */
+export interface TrainAdmittedV1 {
+  readonly kind: "train_admitted";
+  /** After every merge gate passed with `receipt`: defer or refresh. */
+  admit(receipt: ReviewReceiptV1): Promise<StepResultV1>;
+}
+
+/** Closed decision names for the sanitized handoff line. */
+export type TrainHandoffDecisionV1 =
+  | "legacy"
+  | "member"
+  | "booking_pending"
+  | "ejected_drift"
+  | "ejected_protected"
+  | "ejected_submodule"
+  | "ejected_singleton_red"
+  | "not_open"
+  | "not_admissible"
+  | "facts_unavailable";
+
+/** Prefix of every handoff deferral detail. */
+export const TRAIN_HANDOFF_PREFIX = "delivery train: ";
+/** The booking deferral of a train-merged pull request. */
+export const TRAIN_BOOKING_PENDING = "train_booking_pending";
+
+/** The train mode the runtime applies to `repository`. */
+export function trainModeFor(
+  deps: RepairCycleDepsV1,
+  repository: RepositoryIdentityV1,
+): DeliveryTrainModeV1 {
+  return trainPort(deps)?.mode?.(repository) ??
+    deliveryTrainModeV1(repository);
+}
+
+/** A delivery-step record a train may deliver (no self-merge proof). */
+function trainMergePath(record: WorkRecordV1): boolean {
+  return record.nextStep === "delivery" &&
+    (record.intent === null ||
+      (record.intent.kind === "merge" &&
+        record.intent.selfMerge === undefined));
+}
+
+/**
+ * The base-refresh hook: on an "on" target a moved base alone never
+ * refreshes a delivery-step record. Only the handoff's ejection path
+ * refreshes it (`ensureBaseRefreshIntent`'s `trainEjection` option).
+ */
+export function trainHoldsRefresh(
+  deps: RepairCycleDepsV1,
+  record: WorkRecordV1,
+): boolean {
+  return trainMergePath(record) &&
+    trainModeFor(deps, record.repository) === "on";
+}
+
+function emitDecision(
+  mode: DeliveryTrainModeV1,
+  prNumber: number,
+  decision: TrainHandoffDecisionV1,
+): void {
+  console.log(JSON.stringify({
+    version: "v1",
+    kind: "sentinel_train_handoff",
+    mode,
+    prNumber,
+    decision,
+  }));
+}
+
+function defer(
+  pr: number,
+  decision: TrainHandoffDecisionV1,
+  detail: string,
+): StepResultV1 {
+  emitDecision("on", pr, decision);
+  return { kind: "deferred", detail: `${TRAIN_HANDOFF_PREFIX}${detail}` };
+}
+
+async function cooled(
+  deps: RepairCycleDepsV1,
+  context: LoopContextV1,
+  record: WorkRecordV1,
+): Promise<StepResultV1 | null> {
+  const cooling = await checkGithubCooldown(
+    deps,
+    record.repository,
+    context.bounds,
+  );
+  if (cooling.kind === "state_error") {
+    return { kind: "state_error", detail: cooling.detail };
+  }
+  return cooling.kind === "deferred"
+    ? { kind: "deferred", detail: cooling.detail }
+    : null;
+}
+
+async function notOpen(
+  pr: number,
+  merge: TrainMergeEntryV1,
+): Promise<StepResultV1> {
+  const step = await merge.refresh();
+  if (step !== null) {
+    emitDecision("on", pr, "not_open");
+    return step;
+  }
+  return defer(pr, "not_open", "pull request is not open");
+}
+
+/** After every merge gate passed: defer the member or refresh it. */
+async function admitMember(
+  deps: RepairCycleDepsV1,
+  context: LoopContextV1,
+  record: WorkRecordV1,
+  config: RepositoryConfigV1,
+  receipt: ReviewReceiptV1,
+  merge: TrainMergeEntryV1,
+): Promise<StepResultV1> {
+  const pr = record.target.pr!;
+  const member = tryParse(parseDeliveryTrainMemberV1, {
+    recordId: record.id,
+    pr,
+    head: record.target.head,
+    reviewedBase: receipt.pullRequest.base,
+    receiptId: receipt.id,
+    issueNumber: record.related.issueNumber,
+  });
+  if (!member.ok) {
+    return defer(pr, "facts_unavailable", "facts unavailable (member)");
+  }
+  const cooling = await cooled(deps, context, record);
+  if (cooling !== null) return cooling;
+  const tip = await deps.github.readRef(`refs/heads/${config.baseBranch}`);
+  if (!tip.ok || tip.value === null) {
+    return defer(pr, "facts_unavailable", "facts unavailable (tip)");
+  }
+  const fact = await trainMemberFact(
+    deps,
+    record,
+    config,
+    member.value,
+    tip.value.sha,
+  );
+  if (fact.kind === "unknown") {
+    return defer(pr, "facts_unavailable", `facts unavailable (${fact.what})`);
+  }
+  if (fact.kind === "member") {
+    return defer(pr, "member", fact.trainId ?? "pending");
+  }
+  const decision = `ejected_${fact.reason}` as const;
+  const step = await merge.refresh();
+  if (step !== null) {
+    emitDecision("on", pr, decision);
+    return step;
+  }
+  return defer(pr, decision, `ejected (${fact.reason}); refresh not due`);
+}
+
+/**
+ * The handoff at the top of `reconcileMergeIntent` (no `merge` entry) and
+ * `executeMerge` (with it). Null keeps the legacy path: mode "off" or
+ * "plan_only", a self-merge proof the reconciliation must finish, and on
+ * the reconciliation entry every pull request no train landed. Otherwise a
+ * step (a deferral with no write, or the legacy refresh), or, for an open
+ * pull request on the merge entry, the admission continuation that runs
+ * after the merge gates. On an "on" target the merge entry never yields
+ * null: nothing merges there.
+ */
+export function trainHandoff(
+  deps: RepairCycleDepsV1,
+  context: LoopContextV1,
+  record: WorkRecordV1,
+): Promise<StepResultV1 | null>;
+export function trainHandoff(
+  deps: RepairCycleDepsV1,
+  context: LoopContextV1,
+  record: WorkRecordV1,
+  merge: TrainMergeEntryV1,
+): Promise<StepResultV1 | TrainAdmittedV1 | null>;
+export async function trainHandoff(
+  deps: RepairCycleDepsV1,
+  context: LoopContextV1,
+  record: WorkRecordV1,
+  merge?: TrainMergeEntryV1,
+): Promise<StepResultV1 | TrainAdmittedV1 | null> {
+  const mode = trainModeFor(deps, record.repository);
+  if (mode === "off") return null;
+  const pr = record.target.pr;
+  const head = record.target.head;
+  if (mode === "plan_only") {
+    if (pr !== null) emitDecision("plan_only", pr, "legacy");
+    return null;
+  }
+  const config = configFor(deps, record.repository);
+  if (record.intent?.selfMerge !== undefined) {
+    // The self target keeps `executeSelfMerge`; its source-CAS proof is a
+    // write already made, which only the legacy reconciliation finishes.
+    return merge === undefined
+      ? null
+      : defer(pr ?? 0, "not_admissible", "self merge proof is no train member");
+  }
+  if (config === null || pr === null || head === null) {
+    return merge === undefined
+      ? null
+      : defer(pr ?? 0, "facts_unavailable", "facts unavailable (identity)");
+  }
+  const cooling = await cooled(deps, context, record);
+  if (cooling !== null) return cooling;
+  const read = await deps.github.readPullRequest(pr);
+  if (!read.ok || read.value === null) {
+    return merge === undefined
+      ? null
+      : defer(pr, "facts_unavailable", "facts unavailable (pull request)");
+  }
+  const pull = read.value;
+  if (pull.state === "merged" && pull.mergeSha !== null) {
+    const landing = await trainLandingFact(deps, record, config, pull.mergeSha);
+    if (landing.kind === "landed") {
+      return defer(
+        pr,
+        "booking_pending",
+        `${TRAIN_BOOKING_PENDING} ${landing.trainId}`,
+      );
+    }
+    if (landing.kind === "unknown") {
+      return defer(pr, "facts_unavailable", "facts unavailable (landing)");
+    }
+    return merge === undefined ? null : await notOpen(pr, merge);
+  }
+  if (merge === undefined) return null;
+  if (pull.state !== "open") return await notOpen(pr, merge);
+  if (pull.head !== head || pull.baseRef !== config.baseBranch) {
+    return defer(pr, "not_admissible", "pull request identity moved");
+  }
+  return {
+    kind: "train_admitted",
+    admit: (receipt) =>
+      admitMember(deps, context, record, config, receipt, merge),
+  };
+}
