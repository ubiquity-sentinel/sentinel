--- /dev/null
+++ b/src/repair/loop-train-facts.ts
@@ -0,0 +1,277 @@
+/**
+ * The facts the delivery-train runtime handoff reads (redesign 2026-10-25
+ * C12, WP3.4; the decisions are `loop-train-handoff.ts`). Every rule is a
+ * shared pure one: the overlay (`computeTrainOverlayV1`), red-singleton
+ * ejection (`trainEjectedMembersV1`) and landing recognition
+ * (`verifyTrainLandingV1`), so the runtime reaches the launcher's
+ * disposition from the same facts. An unreadable fact is "unknown", never a
+ * pass and never an ejection.
+ */
+import type { GitSha } from "../contracts/brands.ts";
+import {
+  type DeliveryTrainId,
+  deliveryTrainIdV1,
+  deliveryTrainManifestV1,
+  type DeliveryTrainMemberV1,
+  deliveryTrainRefV1,
+  hasDeliveryTrainTrailerV1,
+} from "../contracts/delivery-train.ts";
+import type { PortResultV1 } from "../contracts/ports.ts";
+import type { RepositoryConfigV1 } from "../contracts/repository-config.ts";
+import type { RepositoryIdentityV1 } from "../contracts/shared.ts";
+import type { WorkRecordV1 } from "../contracts/work-record.ts";
+import type {
+  TrainGitCommitV1,
+  TrainMemberPatchRequestV1,
+  TrainMemberPatchV1,
+} from "../github/git-train-drift.ts";
+import type { deliveryTrainModeV1 } from "../host/target-policy.ts";
+import { failedChecks } from "./ci-rejection.ts";
+import type { RepairCycleDepsV1 } from "./loop-types.ts";
+import { mergedExactlyOnBase } from "./merge-off-tip.ts";
+import { type TrainCiFactV1, trainEjectedMembersV1 } from "./train-bisect.ts";
+import { computeTrainOverlayV1 } from "./train-overlay.ts";
+import { verifyTrainLandingV1 } from "./train-proof.ts";
+
+export type DeliveryTrainModeV1 = ReturnType<typeof deliveryTrainModeV1>;
+
+/**
+ * The train facts a trusted host gives the runtime handoff. Each capability
+ * is optional; an absent one is an unreadable fact (a deferral), never a
+ * pass. Model workers never receive it.
+ */
+export interface TrainHandoffPortV1 {
+  /**
+   * Test seam only: a production host never sets it, so the code constant
+   * `deliveryTrainModeV1` is the one production mode.
+   */
+  readonly mode?: (repository: RepositoryIdentityV1) => DeliveryTrainModeV1;
+  /** R_m and T's entries over its paths (`readTrainMemberPatchWithGit`). */
+  readonly readMemberPatch?: (
+    request: TrainMemberPatchRequestV1,
+  ) => Promise<PortResultV1<TrainMemberPatchV1>>;
+  /** The CI fact of one train commit, its rerun included (launcher's reading). */
+  readonly readTrainCi?: (
+    commit: GitSha,
+  ) => Promise<PortResultV1<TrainCiFactV1>>;
+  /** A commit's parents and message (`readTrainCommitWithGit`). */
+  readonly readCommit?: (
+    sha: GitSha,
+  ) => Promise<PortResultV1<TrainGitCommitV1 | null>>;
+  /** Ancestry (`isTrainAncestorWithGit`). */
+  readonly isAncestor?: (
+    ancestor: GitSha,
+    descendant: GitSha,
+  ) => Promise<PortResultV1<boolean>>;
+}
+
+/** The optional host dependency the handoff reads beside the loop's own. */
+export interface TrainHandoffDepsV1 {
+  readonly deliveryTrain?: TrainHandoffPortV1;
+}
+
+export function trainPort(
+  deps: RepairCycleDepsV1,
+): TrainHandoffPortV1 | undefined {
+  return (deps as RepairCycleDepsV1 & TrainHandoffDepsV1).deliveryTrain;
+}
+
+async function settled<T>(
+  read: Promise<PortResultV1<T>>,
+): Promise<PortResultV1<T> | null> {
+  try {
+    return await read;
+  } catch {
+    return null;
+  }
+}
+
+export type TrainLandingFactV1 =
+  | { readonly kind: "landed"; readonly trainId: DeliveryTrainId }
+  | { readonly kind: "not_train" }
+  | { readonly kind: "unknown" };
+
+/**
+ * How the merge `mergeSha` of the record's pull request landed: a verified
+ * train landing, provably no train commit, or unknown. Without the train
+ * commit read, only a merge on exactly [reviewed base, head] is provably
+ * no train landing.
+ */
+export async function trainLandingFact(
+  deps: RepairCycleDepsV1,
+  record: WorkRecordV1,
+  config: RepositoryConfigV1,
+  mergeSha: GitSha,
+): Promise<TrainLandingFactV1> {
+  const head = record.target.head!;
+  const port = trainPort(deps);
+  const commit = port?.readCommit === undefined
+    ? null
+    : await settled(port.readCommit(mergeSha));
+  if (commit === null || !commit.ok || commit.value === null) {
+    const read = deps.github.readCommitParents;
+    const parents = read === undefined
+      ? null
+      : await settled(read.call(deps.github, mergeSha));
+    return parents?.ok === true && parents.value !== null &&
+        mergedExactlyOnBase(parents.value, record.target.base, head)
+      ? { kind: "not_train" }
+      : { kind: "unknown" };
+  }
+  if (!hasDeliveryTrainTrailerV1(commit.value.message)) {
+    return { kind: "not_train" };
+  }
+  const tip = await deps.github.readRef(`refs/heads/${config.baseBranch}`);
+  if (!tip.ok || tip.value === null) return { kind: "unknown" };
+  let reachable: boolean | null = tip.value.sha === mergeSha ? true : null;
+  if (reachable === null && port?.isAncestor !== undefined) {
+    const ancestry = await settled(port.isAncestor(mergeSha, tip.value.sha));
+    reachable = ancestry?.ok === true ? ancestry.value : null;
+  }
+  const verdict = await verifyTrainLandingV1({
+    repository: {
+      owner: record.repository.owner,
+      name: record.repository.name,
+    },
+    branch: config.baseBranch,
+    recordId: record.id,
+    pr: record.target.pr!,
+    head,
+    commit: {
+      sha: mergeSha,
+      parents: commit.value.parents,
+      message: commit.value.message,
+    },
+    tip: tip.value.sha,
+    commitReachable: reachable,
+  });
+  if (verdict.ok) return { kind: "landed", trainId: verdict.trainId };
+  return verdict.reason === "not_landed" ||
+      verdict.reason === "ancestry_unknown"
+    ? { kind: "unknown" }
+    : { kind: "not_train" };
+}
+
+export type TrainEjectionV1 =
+  | "drift"
+  | "protected"
+  | "submodule"
+  | "singleton_red";
+
+/** The one-member overlay rule at T: included, ejected, or unknown. */
+async function patchFact(
+  deps: RepairCycleDepsV1,
+  config: RepositoryConfigV1,
+  member: DeliveryTrainMemberV1,
+  tip: GitSha,
+): Promise<"included" | "unknown" | TrainEjectionV1> {
+  const read = trainPort(deps)?.readMemberPatch;
+  if (read === undefined) return "unknown";
+  const patch = await settled(read({
+    reviewedBase: member.reviewedBase,
+    head: member.head,
+    base: tip,
+  }));
+  if (patch === null || !patch.ok) return "unknown";
+  const overlay = computeTrainOverlayV1({
+    base: tip,
+    tree: patch.value.tree,
+    protectedPaths: config.protectedPaths,
+    candidates: [{ member, changes: patch.value.changes }],
+  });
+  switch (overlay.results[0]?.disposition) {
+    case "included":
+      return "included";
+    case "ejected:drift":
+      return "drift";
+    case "ejected:protected":
+      return "protected";
+    case "ejected:submodule":
+      return "submodule";
+    default:
+      return "unknown";
+  }
+}
+
+type SingletonFact =
+  | { readonly kind: "absent" | "present"; readonly trainId: DeliveryTrainId }
+  | { readonly kind: "red" }
+  | { readonly kind: "unknown" };
+
+/** The singleton train `(T, [m])`: absent, present, red (ejects), unknown. */
+async function singletonFact(
+  deps: RepairCycleDepsV1,
+  record: WorkRecordV1,
+  config: RepositoryConfigV1,
+  member: DeliveryTrainMemberV1,
+  tip: GitSha,
+): Promise<SingletonFact> {
+  let trainId: DeliveryTrainId;
+  try {
+    trainId = await deliveryTrainIdV1(deliveryTrainManifestV1({
+      repository: {
+        owner: record.repository.owner,
+        name: record.repository.name,
+      },
+      branch: config.baseBranch,
+      base: tip,
+      members: [member],
+    }));
+  } catch {
+    return { kind: "unknown" };
+  }
+  const ref = await deps.github.readRef(deliveryTrainRefV1(trainId));
+  if (!ref.ok) return { kind: "unknown" };
+  if (ref.value === null) return { kind: "absent", trainId };
+  const read = trainPort(deps)?.readTrainCi;
+  const ci = read === undefined ? null : await settled(read(ref.value.sha));
+  if (ci === null || !ci.ok) return { kind: "unknown" };
+  if (ci.value.state !== "red") return { kind: "present", trainId };
+  const base = await deps.github.readChecks(tip);
+  const baseRed = base.ok
+    ? failedChecks(base.value.checks).map((check) => check.name)
+    : null;
+  if (trainEjectedMembersV1([{ member, ci: ci.value }], baseRed).length > 0) {
+    return { kind: "red" };
+  }
+  // Red before its rerun or on checks red on T too: no ejection, but an
+  // unread T after the rerun proves nothing either way.
+  return ci.value.rerun && baseRed === null
+    ? { kind: "unknown" }
+    : { kind: "present", trainId };
+}
+
+export type TrainMemberFactV1 =
+  | { readonly kind: "member"; readonly trainId: DeliveryTrainId | null }
+  | { readonly kind: "ejected"; readonly reason: TrainEjectionV1 }
+  | { readonly kind: "unknown"; readonly what: string };
+
+/**
+ * One admissible member at T: ejected (drift, protected path, submodule,
+ * red singleton), a member (with its singleton train's id when that ref
+ * exists), or unknown.
+ */
+export async function trainMemberFact(
+  deps: RepairCycleDepsV1,
+  record: WorkRecordV1,
+  config: RepositoryConfigV1,
+  member: DeliveryTrainMemberV1,
+  tip: GitSha,
+): Promise<TrainMemberFactV1> {
+  const patch = await patchFact(deps, config, member, tip);
+  if (patch !== "included" && patch !== "unknown") {
+    return { kind: "ejected", reason: patch };
+  }
+  const singleton = await singletonFact(deps, record, config, member, tip);
+  if (singleton.kind === "red") {
+    return { kind: "ejected", reason: "singleton_red" };
+  }
+  if (patch === "unknown") return { kind: "unknown", what: "member patch" };
+  if (singleton.kind === "unknown") {
+    return { kind: "unknown", what: "singleton train" };
+  }
+  return {
+    kind: "member",
+    trainId: singleton.kind === "present" ? singleton.trainId : null,
+  };
+}
