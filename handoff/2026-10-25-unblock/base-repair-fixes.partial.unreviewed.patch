+/**
+ * A base-repair task whose red is gone costs no implementation (review
+ * finding of 2026-10-25). The REAL repair loop admits the launcher's own
+ * issue text (`baseRepairIssue`) from intake; before its first
+ * implementation is charged, the runtime re-checks that the marker's tip is
+ * still the base tip and still fails a check the issue lists. A moved tip,
+ * a listed check gone green and one whose job never started park the task
+ * as a stale source with nothing reserved and no model start; an unavailable
+ * read defers with nothing written; a tip that still fails, and an issue
+ * that only quotes the marker, start as before.
+ */
+import assert from "node:assert/strict";
+import type { GitSha } from "../../src/contracts/brands.ts";
+import {
+  type GitHubCheckV1,
+  type GitHubIssueV1,
+  portError,
+  portOk,
+} from "../../src/contracts/ports.ts";
+import {
+  BASE_REPAIR_AUTHOR,
+  BASE_REPAIR_STALE_DETAIL,
+  listedBaseRepairChecks,
+} from "../../src/repair/base-repair.ts";
+import { baseRepairIssue } from "../../ops/hosted-autonomy-base-repair.ts";
+import { SHA1, SHA2, T0 } from "../state/helpers.ts";
+import { check } from "./ci-first-rig.ts";
+import { makeRig } from "./loop-rig.ts";
+
+const ISSUE = 5;
+
+interface AdmissionCase {
+  /** The tip the marker names (the base tip is SHA1). */
+  marked?: GitSha;
+  /** The failing checks the launcher lists (default `deno`). */
+  listed?: string[];
+  author?: string;
+  /** The listed checks' runs on the tip; null: the read is unavailable. */
+  tipChecks: GitHubCheckV1[] | null;
+}
+
+async function admit(prefix: string, options: AdmissionCase) {
+  const { title, body } = baseRepairIssue(
+    "development",
+    options.marked ?? SHA1,
+    options.listed ?? ["deno"],
+  );
+  const issue: GitHubIssueV1 = {
+    number: ISSUE,
+    title,
+    body,
+    state: "open",
+    author: options.author ?? BASE_REPAIR_AUTHOR,
+    labels: [],
+    createdAt: T0 - 300,
+    updatedAt: T0 - 300,
+    closedAt: null,
+  };
+  const rig = await makeRig(`base-repair-admit-${prefix}`, {
+    summaries: false,
+    github: { openIssues: [issue], baseSha: SHA1 },
+  });
+  rig.github.readIssue = (number: number) =>
+    Promise.resolve(portOk(number === ISSUE ? issue : null));
+  const tipReads: { head: GitSha; names: string[] }[] = [];
+  const read = rig.github.readChecks.bind(rig.github);
+  rig.github.readChecks = (head: GitSha, names?: ReadonlySet<string>) => {
+    if (head !== SHA1) return read(head);
+    tipReads.push({ head, names: [...(names ?? [])] });
+    return Promise.resolve(
+      options.tipChecks === null
+        ? portError("unavailable", "check read failed")
+        : portOk({ head, checks: options.tipChecks }),
+    );
+  };
+  try {
+    const outcome = await rig.run();
+    const state = await rig.snapshot();
+    const work = state.work.find((record) =>
+      record.related.issueNumber === ISSUE
+    );
+    assert.ok(work !== undefined, "intake admitted the issue");
+    return {
+      outcome,
+      work,
+      state,
+      tipReads,
+      requests: rig.model.requests,
+    };
+  } finally {
+    await rig.ctx.cleanup();
+  }
+}
+
+Deno.test("base repair admission: the launcher's issue lists its checks in the shape the runtime reads", () => {
+  const { body } = baseRepairIssue("main", SHA1, ["validate", "deno"]);
+  assert.deepEqual(listedBaseRepairChecks(body), ["deno", "validate"]);
+  assert.deepEqual(listedBaseRepairChecks("no list here"), []);
+});
+
+Deno.test("base repair admission: a tip that still fails a listed check starts the implementation", async () => {
+  const { work, tipReads, requests } = await admit("red", {
+    tipChecks: [check("deno", SHA1, "failure")],
+  });
+  assert.equal(requests.length >= 1, true, "one implementation started");
+  assert.equal(requests[0].issue?.number, ISSUE);
+  assert.notEqual(work.blocker?.kind, "stale_source");
+  assert.deepEqual(tipReads[0], { head: SHA1, names: ["deno"] });
+});
+
+Deno.test("base repair admission: a moved tip, a green listed check and a never-started one park it uncharged", async () => {
+  const cases: [string, AdmissionCase, number][] = [
+    ["moved", { marked: SHA2, tipChecks: [check("deno", SHA1, "failure")] }, 0],
+    ["green", { tipChecks: [check("deno", SHA1, "success")] }, 1],
+    ["absent", { tipChecks: [check("lint", SHA1, "failure")] }, 1],
+    [
+      "never-started",
+      {
+        tipChecks: [{ ...check("deno", SHA1, "failure"), neverStarted: true }],
+      },
+      1,
+    ],
+  ];
+  for (const [label, options, checkReads] of cases) {
+    const { work, state, tipReads, requests } = await admit(label, options);
+    assert.equal(requests.length, 0, `${label}: no model start`);
+    assert.equal(work.nextStep, "blocked", label);
+    assert.deepEqual(
+      work.blocker && {
+        kind: work.blocker.kind,
+        message: work.blocker.message,
+      },
+      { kind: "stale_source", message: BASE_REPAIR_STALE_DETAIL },
+      label,
+    );
+    assert.equal(
+      state.reservations.filter((row) => row.taskId === work.id).length,
+      0,
+      `${label}: nothing reserved`,
+    );
+    assert.equal(work.counters.attempts, 0, label);
+    // A moved tip is decided before any check read.
+    assert.equal(tipReads.length, checkReads, label);
+  }
+});
+
+Deno.test("base repair admission: an unavailable check read defers with nothing written", async () => {
+  const { work, state, requests } = await admit("unavailable", {
+    tipChecks: null,
+  });
+  assert.equal(requests.length, 0);
+  assert.equal(work.nextStep, "work");
+  assert.equal(work.blocker, null);
+  assert.equal(work.counters.attempts, 0);
+  assert.equal(
+    state.reservations.filter((row) => row.taskId === work.id).length,
+    0,
+  );
+});
+
+Deno.test("base repair admission: a check listed under the untrusted stand-in name cannot be disproved", async () => {
+  const { tipReads, requests } = await admit("untrusted", {
+    listed: ["a`b"],
+    tipChecks: [check("deno", SHA1, "success")],
+  });
+  assert.equal(requests.length >= 1, true, "the task on its tip starts");
+  assert.equal(tipReads.length, 0, "no read could find that check");
+  // Moved, it is still stale.
+  const moved = await admit("untrusted-moved", {
+    listed: ["a`b"],
+    marked: SHA2,
+    tipChecks: [],
+  });
+  assert.equal(moved.requests.length, 0);
+  assert.equal(moved.work.blocker?.kind, "stale_source");
+});
+
+Deno.test("base repair admission: an issue only another author marks is an ordinary task", async () => {
+  const { tipReads, requests } = await admit("other-author", {
+    author: "someone",
+    tipChecks: [check("deno", SHA1, "success")],
+  });
+  assert.equal(requests.length >= 1, true);
+  assert.equal(tipReads.length, 0, "no tip check read for an ordinary task");
+});
