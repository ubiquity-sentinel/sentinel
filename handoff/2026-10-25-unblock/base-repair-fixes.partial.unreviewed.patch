diff --git a/tests/host/hosted-autonomy-base-repair-bounds_test.ts b/tests/host/hosted-autonomy-base-repair-bounds_test.ts
new file mode 100644
index 0000000000..32af517b31
--- /dev/null
+++ b/tests/host/hosted-autonomy-base-repair-bounds_test.ts
@@ -0,0 +1,155 @@
+/**
+ * The base-repair pass's bounds (review findings of 2026-10-25): the self
+ * scope is never read, the pass budget stops it before any create (between
+ * listing pages too), a create GitHub does not confirm is `file_failed`, a
+ * held tip without a failing check run says so (`no_tip_check`, a red
+ * commit status is not judged), and the same-tip proof reads only down to
+ * the tip's committer date less the margin, never the App's whole history.
+ */
+import assert from "node:assert/strict";
+import {
+  BASE_REPAIR_HORIZON_MARGIN_MS,
+  BASE_REPAIR_PASS_BUDGET_MS,
+} from "../../ops/hosted-autonomy-base-repair.ts";
+import { HOSTED_AUTONOMY_SELF_SCOPE } from "../../ops/hosted-autonomy-policy.ts";
+import { NOW, TIP } from "./hosted-autonomy-spent-fixtures.ts";
+import {
+  appIssue,
+  HEAD,
+  held,
+  MARKER,
+  pass,
+  TAG,
+  TIP_COMMITTED_AT,
+} from "./hosted-autonomy-base-repair-fixtures.ts";
+
+const RED = { [TIP]: ["validate"], [HEAD]: ["validate"] };
+
+Deno.test("base repair bounds: a held record of the self scope is never read and files nothing", async () => {
+  const self = {
+    ...held(618),
+    repository: { ...HOSTED_AUTONOMY_SELF_SCOPE },
+  };
+  const { actions, reads, calls, filed } = await pass({
+    failed: RED,
+    work: [self],
+  });
+  assert.deepEqual(actions, []);
+  assert.deepEqual(reads, [], "no check read");
+  assert.deepEqual(calls, [], "no listing, commit read or create");
+  assert.equal(filed.length, 0);
+});
+
+Deno.test("base repair bounds: a clock past the budget stops the pass with no create", async () => {
+  // The budget runs out while the held heads are read, before any listing.
+  let now = NOW;
+  const atHead = await pass({
+    failed: RED,
+    now: () => now,
+    onCall: (call) => {
+      if (call === `failedChecks:${HEAD}`) {
+        now = NOW + BASE_REPAIR_PASS_BUDGET_MS;
+      }
+    },
+  });
+  assert.deepEqual(atHead.actions, [`${TAG}:deadline`]);
+  assert.equal(atHead.listings, 0);
+  assert.equal(atHead.filed.length, 0);
+  // It runs out between the open listing and the same-tip listing's first
+  // page: that listing refuses and the pass stops, with no create.
+  now = NOW;
+  const atListing = await pass({
+    failed: RED,
+    now: () => now,
+    onCall: (call) => {
+      if (call.startsWith("committedAt:")) {
+        now = NOW + BASE_REPAIR_PASS_BUDGET_MS;
+      }
+    },
+  });
+  assert.deepEqual(atListing.actions, [`${TAG}:deadline`]);
+  assert.ok(!atListing.calls.includes("create"), atListing.calls.join());
+  // It runs out once the same-tip listing has answered: still no create.
+  let armed = false;
+  let late = 0;
+  const atCreate = await pass({
+    failed: RED,
+    // The listing's own budget read is the first after it is called.
+    now: () => armed && late++ >= 1 ? NOW + BASE_REPAIR_PASS_BUDGET_MS : NOW,
+    onCall: (call) => {
+      if (call.startsWith("since:")) armed = true;
+    },
+  });
+  assert.deepEqual(atCreate.actions, [`${TAG}:deadline`]);
+  assert.ok(atCreate.calls.some((call) => call.startsWith("since:")));
+  assert.equal(atCreate.filed.length, 0);
+});
+
+Deno.test("base repair bounds: a create GitHub does not confirm is file_failed", async () => {
+  const { actions, filed } = await pass({ failed: RED, created: null });
+  assert.deepEqual(actions, [`${TAG}:file_failed`]);
+  assert.equal(filed.length, 1, "the create was sent once");
+});
+
+Deno.test("base repair bounds: the same-tip proof reads down to the tip's committer date less the margin", async () => {
+  const { actions, calls } = await pass({ failed: RED });
+  assert.deepEqual(actions, [`${TAG}:filed=#4242`]);
+  assert.deepEqual(calls, [
+    "open",
+    `committedAt:${TIP}`,
+    `since:${TIP_COMMITTED_AT - BASE_REPAIR_HORIZON_MARGIN_MS}`,
+    "create",
+  ]);
+  // A closed issue for this tip inside the horizon is found there.
+  const closed = await pass({
+    failed: RED,
+    issues: [
+      appIssue(9, MARKER, {
+        state: "closed",
+        createdAt: TIP_COMMITTED_AT - BASE_REPAIR_HORIZON_MARGIN_MS,
+      }),
+    ],
+  });
+  assert.deepEqual(closed.actions, [`${TAG}:filed_before=#9`]);
+});
+
+Deno.test("base repair bounds: an unreadable or future committer date proves no horizon and files nothing", async () => {
+  const unread = await pass({ failed: RED, committedAt: null });
+  assert.deepEqual(unread.actions, [`${TAG}:issues_unreadable`]);
+  assert.equal(unread.filed.length, 0);
+  const ahead = await pass({
+    failed: RED,
+    committedAt: NOW + BASE_REPAIR_HORIZON_MARGIN_MS + 1,
+  });
+  assert.deepEqual(ahead.actions, [`${TAG}:horizon_unproven`]);
+  assert.ok(!ahead.calls.some((call) => call.startsWith("since:")));
+  assert.equal(ahead.filed.length, 0);
+  // A committer date within the margin ahead of the clock still bounds it.
+  const skewed = await pass({
+    failed: RED,
+    committedAt: NOW + BASE_REPAIR_HORIZON_MARGIN_MS,
+  });
+  assert.deepEqual(skewed.actions, [`${TAG}:filed=#4242`]);
+});
+
+Deno.test("base repair bounds: a held tip without a failing check run files nothing and says so", async () => {
+  // The runtime may hold on a red commit status, which this read does not
+  // judge (only check runs, with the never-started rule): it is reported.
+  const { actions, reads, listings } = await pass({
+    failed: { [TIP]: [], [HEAD]: ["validate"] },
+  });
+  assert.deepEqual(actions, [`${TAG}:no_tip_check`]);
+  assert.deepEqual(reads.map((read) => read.commit), [TIP]);
+  assert.equal(listings, 0);
+});
+
+Deno.test("base repair bounds: a surface that throws is unexpected_error and stops nothing else", async () => {
+  const { actions, filed } = await pass({
+    failed: RED,
+    onCall: (call) => {
+      if (call === "open") throw new Error("synthetic");
+    },
+  });
+  assert.deepEqual(actions, [`${TAG}:unexpected_error`]);
+  assert.equal(filed.length, 0);
+});
