+/**
+ * A fake base-repair issue capability (`HostedBaseRepairIssuesV1`) over a
+ * list of App-created items, for the base-repair pass suites. The listings
+ * answer like the real ones: the open listing every open item, the
+ * same-tip listing every item created at or after the horizon, and each
+ * refuses (null) once `inBudget` is false.
+ */
+import type { WorkRecordV1 } from "../../src/contracts/work-record.ts";
+import { baseRepairMarker } from "../../src/repair/base-repair.ts";
+import { runHostedBaseRepairPass } from "../../ops/hosted-autonomy-base-repair.ts";
+import type {
+  HostedAppIssueV1,
+  HostedAutonomyGitHubV1,
+  HostedBaseRepairIssuesV1,
+} from "../../ops/hosted-autonomy-types.ts";
+import {
+  liveRecord,
+  liveRig,
+  liveSnapshot,
+  liveSurface,
+  NOW,
+  TIP,
+} from "./hosted-autonomy-spent-fixtures.ts";
+
+export const TAG = "base-repair:ubiquity/ai.ubq.fi";
+export const HEAD = "1".repeat(40);
+export const OLD_TIP = "2".repeat(40);
+export const MARKER = baseRepairMarker("development", TIP);
+
+/** The CI-first gate's red-base hold, as a live poll re-arms it. */
+export const HELD = {
+  reason: "backoff",
+  since: NOW - 60_000,
+  until: NOW + 1_740_000,
+};
+
+/** A record of ai.ubq.fi issue `issue` (the live #618 row, re-identified). */
+export function record(
+  issue: number,
+  overrides: Record<string, unknown> = {},
+): WorkRecordV1 {
+  const template = liveRecord(618);
+  return liveRecord(618, {
+    id: `issue-ubiquity-ai.ubq.fi-${issue}`,
+    source: { ...template.source, id: String(issue) },
+    related: { ...template.related, issueNumber: issue },
+    ...overrides,
+  });
+}
+
+/** The live #618 target, published at `head` on `base`. */
+export function target(head: string, base: string) {
+  const { branch, pr } = liveRecord(618).target;
+  return { base, branch, checkpoint: null, head, pr };
+}
+
+/** A record held by its red base on `base` with published `head`. */
+export function held(issue: number, head = HEAD, base = TIP): WorkRecordV1 {
+  return record(issue, {
+    nextStep: "work",
+    blocker: null,
+    wait: HELD,
+    target: target(head, base),
+  });
+}
+
+/** The fake tip's committer date: an hour before the pass clock. */
+export const TIP_COMMITTED_AT = NOW - 3_600_000;
+
+/** One App-created item, open and created half an hour before the pass. */
+export function appIssue(
+  number: number,
+  firstLine: string,
+  overrides: Partial<HostedAppIssueV1> = {},
+): HostedAppIssueV1 {
+  return {
+    number,
+    state: "open",
+    pullRequest: false,
+    createdAt: NOW - 1_800_000,
+    firstLine,
+    ...overrides,
+  };
+}
+
+export interface FakeBaseRepairIssuesOptionsV1 {
+  /** Every App-created item; null makes both listings unreadable. */
+  issues?: readonly HostedAppIssueV1[] | null;
+  /** The tip's committer date (default `TIP_COMMITTED_AT`); null: unread. */
+  committedAt?: number | null;
+  /** The create's answer (default 4242). */
+  created?: number | null;
+  /** Called before each answer (a test's clock advance). */
+  onCall?: (call: string) => void;
+}
+
+export function fakeBaseRepairIssues(
+  options: FakeBaseRepairIssuesOptionsV1 = {},
+) {
+  const filed: { title: string; body: string }[] = [];
+  const calls: string[] = [];
+  const all = options.issues === undefined ? [] : options.issues;
+  const note = (call: string) => {
+    calls.push(call);
+    options.onCall?.(call);
+  };
+  const issues: HostedBaseRepairIssuesV1 = {
+    committedAt: (commit) => {
+      note(`committedAt:${commit}`);
+      return Promise.resolve(
+        options.committedAt === undefined
+          ? TIP_COMMITTED_AT
+          : options.committedAt,
+      );
+    },
+    listAppAuthoredSince: (sinceMs, inBudget) => {
+      note(`since:${sinceMs}`);
+      if (!inBudget() || all === null) return Promise.resolve(null);
+      return Promise.resolve(
+        all.filter((issue) => issue.createdAt >= sinceMs)
+          .sort((a, b) => b.createdAt - a.createdAt),
+      );
+    },
+    listOpenAppAuthored: (inBudget) => {
+      note("open");
+      if (!inBudget() || all === null) return Promise.resolve(null);
+      return Promise.resolve(all.filter((issue) => issue.state === "open"));
+    },
+    create: (input) => {
+      note("create");
+      filed.push(input);
+      return Promise.resolve(
+        options.created === undefined ? 4242 : options.created,
+      );
+    },
+  };
+  return { issues, filed, calls };
+}
+
+export interface PassOptionsV1 extends FakeBaseRepairIssuesOptionsV1 {
+  /** Failed check names by commit (absent: none failed). */
+  failed: Record<string, string[] | null>;
+  work?: WorkRecordV1[];
+  filing?: boolean;
+  /** The pass clock (default: always `NOW`). */
+  now?: () => number;
+}
+
+/** The REAL pass over the fake surface and a real-Git state rig. */
+export async function pass(options: PassOptionsV1) {
+  const { surface: base } = liveSurface({ tip: TIP });
+  const fake = fakeBaseRepairIssues(options);
+  const reads: { commit: string; conclusions: readonly string[] }[] = [];
+  const surface: HostedAutonomyGitHubV1 = {
+    ...base,
+    failedChecks: (commit, conclusions) => {
+      reads.push({ commit, conclusions });
+      options.onCall?.(`failedChecks:${commit}`);
+      return Promise.resolve(
+        commit in options.failed ? options.failed[commit] : [],
+      );
+    },
+    baseRepairIssues: fake.issues,
+  };
+  const work = options.work ?? [held(618)];
+  const rig = await liveRig("base-repair", liveSnapshot(work, []), surface);
+  try {
+    const actions = await runHostedBaseRepairPass(
+      {
+        state: rig.state,
+        githubFor: rig.githubFor,
+        clock: { now: options.now ?? (() => NOW) },
+      },
+      undefined,
+      // The lane ships with filing off; the pass is exercised with it on.
+      { filing: options.filing ?? true },
+    );
+    return {
+      actions,
+      filed: fake.filed,
+      reads,
+      calls: fake.calls,
+      listings: fake.calls.filter((call) =>
+        call === "open" || call.startsWith("since:")
+      ).length,
+      writes: rig.writes,
+    };
+  } finally {
+    await Deno.remove(rig.tmp, { recursive: true });
+  }
+}
