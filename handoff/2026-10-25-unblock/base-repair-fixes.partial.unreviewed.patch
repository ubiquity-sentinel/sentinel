+Deno.test("base repair: an incident, a mismatched issue and a missing config keep base_red", async () => {
+  const at = () =>
+    Promise.resolve(portOk({ ref: "refs/heads/development", sha: SHA1 }));
+  // An incident record that names an issue is never the issue's task: no
+  // read at all.
+  const incident = directDeps(null, at);
+  const record = {
+    ...incident.record,
+    source: { kind: "incident" as const, id: "inc-a", revision: SHA1 },
+    related: { incidentId: "inc-a", issueNumber: 1 },
+  };
+  assert.equal(await isBaseRepairTask(incident.deps, record), false);
+  assert.deepEqual(await ownBaseRed(incident.deps, record, ATTRIBUTION), {
+    kind: "base_red",
+  });
+  assert.deepEqual(incident.calls, []);
+  // An answer for another issue number is not this task's issue.
+  const mismatched = directDeps(portOk(issue({ number: 2 })), at);
+  assert.equal(
+    await isBaseRepairTask(mismatched.deps, mismatched.record),
+    false,
+  );
+  assert.deepEqual(
+    await ownBaseRed(mismatched.deps, mismatched.record, ATTRIBUTION),
+    { kind: "base_red" },
+  );
+  // A record no config covers proves no tip: it keeps base_red.
+  const unconfigured = directDeps(null, at);
+  const deps = { ...unconfigured.deps, configs: [] };
+  assert.deepEqual(
+    await ownBaseRed(deps, unconfigured.record, ATTRIBUTION),
+    { kind: "base_red" },
+  );
+  assert.deepEqual(unconfigured.calls, ["issue"], "no tip read");
+});
+
