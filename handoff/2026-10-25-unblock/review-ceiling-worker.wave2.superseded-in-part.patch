+    reviewRoundsLeft(withReviews([receipt("clean", SHA2)]), record, CUT),
+    1,
+  );
+  assert.equal(
+    reviewRoundsLeft(withReviews([receipt("clean", SHA3, REPO)]), record, CUT),
+    1,
+  );
+  // A completed review of that head spent the round, whatever it found.
+  for (const verdict of ["clean", "p1", "unaccepted"] as const) {
+    const done = withReviews([receipt(verdict)]);
+    assert.equal(legacyFinalRoundRetryOpen(done, record, CUT), false, verdict);
+    assert.equal(reviewRoundsLeft(done, record, CUT), 0, verdict);
+    assert.equal(reviewRoundCeiling(done, record, CUT), MAX_REVIEW_ROUNDS);
+  }
+  // Without the snapshot's receipts nothing is proven: it fails closed.
+  assert.equal(
+    reviewRoundsLeft({ reservations: [...old, fix, final] }, record, CUT),
+    0,
+  );
+  // The re-request spends the round, verdict or not.
+  const twice = legacy(645, 8);
+  const again = charge(twice, 8, "review_request", CUT + 9);
+  const both = { reservations: [...old, fix, final, again], reviews: [] };
+  assert.equal(legacyFinalRoundRetryOpen(both, twice, CUT), false);
+  assert.equal(reviewRoundsLeft(both, twice, CUT), 0);
+  // A post-cutoff review no CI fix armed first (the old runtime's, between
+  // the pin commit and the install) never had a final round to re-request.
+  const lateFix = charge(record, 4, "retry", CUT + 6);
+  const unarmed = { reservations: [...old, lateFix, final], reviews: [] };
+  assert.equal(legacyFinalRoundRetryOpen(unarmed, record, CUT), false);
+  assert.equal(reviewRoundsLeft(unarmed, record, CUT), 0);
+  // No cutoff: nothing is legacy.
+  assert.equal(reviewRoundsLeft(noVerdict, record, null), 0);
+  // An ordinary record never gets it: every admission spends its round.
+  const ordinary = { reservations: reviewCharges("issue-1", 3), reviews: [] };
+  assert.equal(legacyFinalRoundRetryOpen(ordinary, task(3), CUT), false);
+  assert.equal(reviewRoundsLeft(ordinary, task(3), CUT), 0);
+});
