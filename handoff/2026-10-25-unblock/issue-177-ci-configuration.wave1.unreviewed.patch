diff --git a/tests/github/check-events_test.ts b/tests/github/check-events_test.ts
new file mode 100644
index 0000000000..821f730854
--- /dev/null
+++ b/tests/github/check-events_test.ts
@@ -0,0 +1,127 @@
+// `readChecks` with workflow-run events (sentinel issue #177): each GitHub
+// Actions check run is stamped with the event of the workflow run whose check
+// suite it belongs to, through one bounded `/actions/runs?head_sha=` listing
+// of the same commit. Unproven, ambiguous or unreadable events stay absent and
+// never fail the check read; without the option nothing more is requested.
+// All fixtures are synthetic.
+import assert from "node:assert/strict";
+import {
+  checkRunWire,
+  checksPageWire,
+  commitStatusWire,
+  httpRespond,
+  makePort,
+  SHA1,
+  SHA2,
+  statusesPageWire,
+} from "./helpers.ts";
+
+const REPO_PATH = "/repos/ubiquity-sentinel/sentinel";
+const CHECK_RUNS =
+  `${REPO_PATH}/commits/${SHA1}/check-runs?per_page=100&page=1`;
+const STATUSES = `${REPO_PATH}/commits/${SHA1}/statuses?per_page=100&page=1`;
+const RUNS = `${REPO_PATH}/actions/runs?head_sha=${SHA1}&per_page=100&page=1`;
+
+function checkRuns() {
+  return checksPageWire([
+    checkRunWire({ name: "rust-native", check_suite: { id: 11 } }),
+    checkRunWire({ name: "validate", check_suite: { id: 12 } }),
+    checkRunWire({ name: "ambiguous", check_suite: { id: 13 } }),
+    checkRunWire({ name: "other-head", check_suite: { id: 14 } }),
+    checkRunWire({ name: "odd-event", check_suite: { id: 15 } }),
+    checkRunWire({ name: "no-suite" }),
+  ]);
+}
+
+function workflowRuns(runs: Record<string, unknown>[]) {
+  return { total_count: runs.length, workflow_runs: runs };
+}
+
+function run(suite: number, event: unknown, head: string = SHA1) {
+  return { id: suite * 10, check_suite_id: suite, event, head_sha: head };
+}
+
+Deno.test("readChecks events: each Actions run carries its proven workflow event", async () => {
+  const { port, transport } = makePort({
+    script: [
+      httpRespond("GET", CHECK_RUNS, 200, checkRuns()),
+      httpRespond(
+        "GET",
+        RUNS,
+        200,
+        workflowRuns([
+          run(11, "pull_request"),
+          run(12, "push"),
+          run(13, "push"),
+          run(13, "workflow_dispatch"),
+          run(14, "push", SHA2),
+          run(15, "Pull Request"),
+        ]),
+      ),
+      httpRespond(
+        "GET",
+        STATUSES,
+        200,
+        statusesPageWire([commitStatusWire({ context: "legacy-ci" })]),
+      ),
+    ],
+  });
+  const result = await port.readChecks(SHA1, undefined, { events: true });
+  assert.ok(result.ok, JSON.stringify(result));
+  const events = Object.fromEntries(
+    result.value.checks.map((check) => [check.name, check.event ?? null]),
+  );
+  assert.deepEqual(events, {
+    "rust-native": "pull_request",
+    validate: "push",
+    // Two runs claim suite 13 with different events: unproven.
+    ambiguous: null,
+    // A run listed for another commit is not evidence for this head.
+    "other-head": null,
+    // Not a webhook event name: never carried.
+    "odd-event": null,
+    "no-suite": null,
+    // A commit status has no workflow run.
+    "legacy-ci": null,
+  });
+  assert.equal(
+    transport.requests.filter((request) => request.url.includes(RUNS)).length,
+    1,
+  );
+});
+
+Deno.test("readChecks events: without the option no workflow run is read", async () => {
+  const { port, transport } = makePort({
+    script: [
+      httpRespond("GET", CHECK_RUNS, 200, checkRuns()),
+      httpRespond("GET", STATUSES, 200, statusesPageWire([])),
+    ],
+  });
+  const result = await port.readChecks(SHA1);
+  assert.ok(result.ok, JSON.stringify(result));
+  assert.ok(result.value.checks.every((check) => check.event === undefined));
+  assert.ok(
+    transport.requests.every((request) => !request.url.includes("/actions/")),
+  );
+});
+
+for (
+  const [label, status, body] of [
+    ["forbidden", 403, { message: "Resource not accessible by integration" }],
+    ["malformed", 200, { total_count: 1, workflow_runs: "not a list" }],
+  ] as const
+) {
+  Deno.test(`readChecks events: a ${label} run listing leaves every event absent and the read intact`, async () => {
+    const { port } = makePort({
+      script: [
+        httpRespond("GET", CHECK_RUNS, 200, checkRuns()),
+        httpRespond("GET", RUNS, status, body),
+        httpRespond("GET", STATUSES, 200, statusesPageWire([])),
+      ],
+    });
+    const result = await port.readChecks(SHA1, undefined, { events: true });
+    assert.ok(result.ok, JSON.stringify(result));
+    assert.equal(result.value.checks.length, 6);
+    assert.ok(result.value.checks.every((check) => check.event === undefined));
+  });
+}
