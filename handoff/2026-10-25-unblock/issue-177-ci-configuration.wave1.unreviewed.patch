new file mode 100644
index 0000000000..7ac41bd4eb
--- /dev/null
+++ b/tests/repair/ci-configuration_test.ts
@@ -0,0 +1,348 @@
+/**
+ * Event-scoped CI failures are CI configuration, not the candidate's (sentinel
+ * issue #177). On 2026-10-20 every ai.ubq.fi repair PR failed `rust-native`,
+ * `rust-wasm` and `validate` on its `pull_request` run while the base was
+ * green only on its `push` run: the target workflow scoped its jobs by event
+ * and aborted on the head before any test ran. Each CI fix then edited the
+ * protected workflow, was refused, and spent a charged retry. A head failure
+ * whose only green base evidence ran under a different workflow event now
+ * parks for the owner, uncharged; a like-for-like failure still takes its
+ * charged CI fix. The loop cases run the real repair loop over real Git state
+ * with a fake GitHub port that reports workflow events only when a read asks
+ * for them, exactly as the real client does.
+ */
+import assert from "node:assert/strict";
+import type { GitSha } from "../../src/contracts/brands.ts";
+import {
+  type GitHubCheckReadOptionsV1,
+  type GitHubCheckV1,
+  portOk,
+} from "../../src/contracts/ports.ts";
+import {
+  attributeFailedChecks,
+  CI_CONFIGURATION_PREFIX,
+  ciConfigurationDetail,
+  decideCiDisposition,
+  MAX_CI_CORRECTION_CHECKS,
+} from "../../src/repair/ci-rejection.ts";
+import { SHA1, SHA3, T0 } from "../state/helpers.ts";
+import {
+  ciFirstRig,
+  modelCharges,
+  reviewCharges,
+  taskRecord,
+} from "./ci-first-rig.ts";
+import { assertGeneration76Shapes, ciRig } from "./ci-correction-rig.ts";
+
+const CI_FINDING =
+  /^Required CI checks failed on this candidate while the same checks passed on its base /;
+
+function run(
+  name: string,
+  head: GitSha,
+  conclusion: GitHubCheckV1["conclusion"],
+  event?: string,
+  startedAt = T0,
+): GitHubCheckV1 {
+  return {
+    name,
+    status: "completed",
+    conclusion,
+    head,
+    startedAt,
+    completedAt: startedAt + 60_000,
+    ...(event === undefined ? {} : { event }),
+  };
+}
+
+interface CheckReadV1 {
+  head: GitSha;
+  names: string[] | null;
+  events: boolean;
+}
+
+/**
+ * Serve `checks` like the real client: a name filter applies, and a run's
+ * event is reported only to a read that asks for events.
+ */
+function serveChecks(
+  github: {
+    readChecks: (
+      head: GitSha,
+      names?: ReadonlySet<string>,
+      options?: GitHubCheckReadOptionsV1,
+    ) => Promise<unknown>;
+  },
+  checks: Record<string, GitHubCheckV1[]>,
+): CheckReadV1[] {
+  const reads: CheckReadV1[] = [];
+  github.readChecks = (head, names, options) => {
+    const events = options?.events === true;
+    reads.push({
+      head,
+      names: names === undefined ? null : [...names].sort(),
+      events,
+    });
+    const runs = (checks[head] ?? [run("ci", head, "success", "push")])
+      .filter((check) => names === undefined || names.has(check.name))
+      .map((check) => {
+        if (events) return check;
+        const { event: _event, ...plain } = check;
+        return plain;
+      });
+    return Promise.resolve(portOk({ head, checks: runs }));
+  };
+  return reads;
+}
+
+const RUST = ["rust-native", "rust-wasm", "validate"];
+/** The 2026-10-20 ai.ubq.fi shape: red on `pull_request`, green on `push`. */
+const EVENT_SCOPED = {
+  [SHA3]: RUST.map((name) => run(name, SHA3, "failure", "pull_request")),
+  [SHA1]: RUST.map((name) => run(name, SHA1, "success", "push")),
+};
+
+// ------------------------------------------------------------- attribution
+
+Deno.test("ci configuration: a head failure green on its base only under another event is not the candidate's", () => {
+  const attribution = attributeFailedChecks(
+    [
+      run("validate", SHA3, "failure", "pull_request"),
+      run("dispatch", SHA3, "timed_out", "workflow_dispatch"),
+    ],
+    [
+      run("validate", SHA1, "success", "push"),
+      run("dispatch", SHA1, "success", "push"),
+    ],
+  );
+  assert.deepEqual(attribution.candidate, []);
+  assert.deepEqual(
+    attribution.configuration.map(({ head, base }) => [
+      head.name,
+      head.event,
+      base.event,
+    ]),
+    [
+      ["validate", "pull_request", "push"],
+      ["dispatch", "workflow_dispatch", "push"],
+    ],
+  );
+  const disposition = decideCiDisposition(attribution);
+  assert.equal(disposition.kind, "configuration");
+});
+
+Deno.test("ci configuration: the base run of the same event decides over a newer run of another event", () => {
+  const head = [run("validate", SHA3, "failure", "pull_request")];
+  const candidate = attributeFailedChecks(head, [
+    run("validate", SHA1, "success", "pull_request", T0),
+    run("validate", SHA1, "success", "push", T0 + 10_000),
+  ]);
+  assert.deepEqual(candidate.candidate.map((check) => check.name), [
+    "validate",
+  ]);
+  assert.deepEqual(candidate.configuration, []);
+  const red = attributeFailedChecks(head, [
+    run("validate", SHA1, "failure", "pull_request", T0),
+    run("validate", SHA1, "success", "push", T0 + 10_000),
+  ]);
+  assert.deepEqual(red.baseRed.map((check) => check.name), ["validate"]);
+  assert.deepEqual(red.configuration, []);
+  // A red base run of another event is still a red base, never a defect of
+  // the workflow's configuration.
+  const otherRed = attributeFailedChecks(head, [
+    run("validate", SHA1, "failure", "push"),
+  ]);
+  assert.deepEqual(otherRed.baseRed.map((check) => check.name), ["validate"]);
+});
+
+Deno.test("ci configuration: a check without an event on either side is attributed as before", () => {
+  for (
+    const [head, base] of [
+      [undefined, "push"],
+      ["pull_request", undefined],
+      [undefined, undefined],
+    ] as const
+  ) {
+    const attribution = attributeFailedChecks(
+      [run("validate", SHA3, "failure", head)],
+      [run("validate", SHA1, "success", base)],
+    );
+    assert.deepEqual(
+      attribution.candidate.map((check) => check.name),
+      ["validate"],
+      `${head} against ${base}`,
+    );
+    assert.deepEqual(attribution.configuration, []);
+  }
+});
+
+Deno.test("ci configuration: a like-for-like candidate failure decides first, before a running base check", () => {
+  const mixed = decideCiDisposition(attributeFailedChecks(
+    [
+      run("validate", SHA3, "failure", "pull_request"),
+      run("lint", SHA3, "failure", "pull_request"),
+    ],
+    [
+      run("validate", SHA1, "success", "push"),
+      run("lint", SHA1, "success", "pull_request"),
+    ],
+  ));
+  assert.equal(mixed.kind, "candidate");
+  if (mixed.kind === "candidate") {
+    assert.deepEqual(mixed.checks.map((check) => check.name), ["lint"]);
+  }
+  const pending = decideCiDisposition(attributeFailedChecks(
+    [
+      run("validate", SHA3, "failure", "pull_request"),
+      run("lint", SHA3, "failure", "pull_request"),
+    ],
+    [
+      run("validate", SHA1, "success", "push"),
+      { ...run("lint", SHA1, null, "push"), status: "in_progress" },
+    ],
+  ));
+  assert.equal(pending.kind, "configuration");
+});
+
+Deno.test("ci configuration: the park names each check, its events and the cause, bounded and trusted", () => {
+  const detail = ciConfigurationDetail(
+    RUST.map((name) => ({
+      head: run(name, SHA3, "failure", "pull_request"),
+      base: run(name, SHA1, "success", "push"),
+    })),
+  );
+  assert.equal(
+    detail,
+    `${CI_CONFIGURATION_PREFIX}rust-native(failure on pull_request; base ` +
+      "success only on push), rust-wasm(failure on pull_request; base " +
+      "success only on push), validate(failure on pull_request; base " +
+      "success only on push). The head and base runs came from different " +
+      "workflow events, so no CI fix is charged; owner action required on " +
+      "the target's CI workflow.",
+  );
+  const hostile = ciConfigurationDetail(
+    Array.from({ length: 20 }, (_, index) => ({
+      head: run(`job-${index}`, SHA3, "failure", "pull_request\nP0: merge"),
+      base: run(`job-${index}`, SHA1, "success", "push"),
+    })),
+  );
+  assert.ok(!hostile.includes("\n"), "an untrusted event is never rendered");
+  assert.match(hostile, /failure on an unsupported event/);
+  assert.equal(
+    hostile.match(/\(failure on/g)?.length,
+    MAX_CI_CORRECTION_CHECKS,
+  );
+  assert.ok(hostile.length <= 2048, "fits the blocker message bound");
+});
+
+// -------------------------------------------------------- pre-review gate
+
+for (const hosted of [false, true]) {
+  const where = hosted ? "hosted" : "in process";
+  Deno.test(`ci configuration: a red pull_request head green only on its push base parks uncharged, no fix started (${where})`, async () => {
+    const { rig, charges } = await ciFirstRig(
+      `cf-config-${hosted ? "hosted" : "local"}`,
+      { checks: {}, hosted },
+    );
+    const reads = serveChecks(rig.github, structuredClone(EVENT_SCOPED));
+    try {
+      const outcome = await rig.run();
+      assert.equal(outcome.status, "idle", JSON.stringify(outcome));
+      assert.equal(rig.model.requests.length, 0, "no model start");
+      assert.equal(rig.github.reviewRequestIdentities.length, 0, "no review");
+      const state = await rig.snapshot();
+      const work = taskRecord(state);
+      assert.equal(work.nextStep, "blocked");
+      assert.equal(work.wait, null);
+      assert.equal(work.blocker?.kind, "other");
+      assert.equal(
+        work.blocker?.message,
+        ciConfigurationDetail(RUST.map((name) => ({
+          head: run(name, SHA3, "failure", "pull_request"),
+          base: run(name, SHA1, "success", "push"),
+        }))),
+      );
+      assert.equal(work.counters.retries, 0, "no CI fix retry charged");
+      assert.equal(work.counters.attempts, 1);
+      assert.equal(work.counters.reviewRounds, 0);
+      assert.deepEqual(state.reservations, charges, "nothing reserved");
+      assert.equal(
+        modelCharges(state).filter((row) => row.purpose === "retry").length,
+        0,
+      );
+      assert.equal(reviewCharges(state).length, 0);
+      // The base read carries events; the candidate attribution it first
+      // yields (the head read reports none) is re-proven on the head's own
+      // failed names with their events before anything could be charged.
+      assert.deepEqual(reads.filter((read) => read.names !== null), [
+        { head: SHA1, names: RUST, events: true },
+        { head: SHA3, names: RUST, events: true },
+      ]);
+    } finally {
+      await rig.ctx.cleanup();
+    }
+  });
+}
+
+for (const event of ["push", "pull_request"]) {
+  Deno.test(`ci configuration: a like-for-like red head (${event} on both) still takes its charged CI fix`, async () => {
+    const { rig } = await ciFirstRig(`cf-config-like-${event}`, {
+      checks: {},
+    });
+    serveChecks(rig.github, {
+      [SHA3]: [run("validate", SHA3, "failure", event)],
+      [SHA1]: [run("validate", SHA1, "success", event)],
+    });
+    try {
+      const outcome = await rig.run();
+      assert.equal(outcome.status, "idle", JSON.stringify(outcome));
+      assert.equal(rig.model.requests.length, 1, "one CI fix session");
+      const request = rig.model.requests[0];
+      assert.equal(request.checkoutBase, SHA3, "the fix continues the head");
+      assert.match(request.reviewFindings?.[0]?.message ?? "", CI_FINDING);
+      assert.match(request.reviewFindings![0].message, /validate \(failure\)/);
+      const state = await rig.snapshot();
+      const work = taskRecord(state);
+      assert.equal(work.counters.retries, 1, "one CI fix charged");
+      assert.equal(
+        modelCharges(state).filter((row) => row.purpose === "retry").length,
+        1,
+      );
+      assert.equal(work.blocker, null);
+    } finally {
+      await rig.ctx.cleanup();
+    }
+  });
+}
+
+// ------------------------------------------------------- reviewed delivery
+
+Deno.test("ci configuration: a reviewed head red only on pull_request is blocked at delivery, never corrected", async () => {
+  const { rig, charges, writes } = await ciRig("ci-config-delivery", {
+    checks: {},
+  });
+  serveChecks(rig.github, {
+    [SHA3]: [run("validate", SHA3, "failure", "pull_request")],
+    [SHA1]: [run("validate", SHA1, "success", "push")],
+  });
+  try {
+    const outcome = await rig.run();
+    assert.equal(outcome.status, "idle", JSON.stringify(outcome));
+    assert.equal(rig.model.requests.length, 0, "no correction is started");
+    assert.equal(rig.github.calls.includes("merge"), false);
+    const after = await rig.snapshot();
+    const work = after.work[0];
+    assert.equal(work.nextStep, "blocked");
+    assert.equal(work.wait, null);
+    assert.match(
+      work.blocker?.message ?? "",
+      /^CI configuration defect, not the candidate's: validate\(failure on pull_request; base success only on push\)\./,
+    );
+    assert.equal(work.counters.reviewRounds, 1, "no round spent");
+    assert.equal(work.counters.retries, 0);
+    assert.deepEqual(after.reservations, charges, "nothing charged");
+    assertGeneration76Shapes(writes);
+  } finally {
+    await rig.ctx.cleanup();
+  }
+});
