index 0000000000..2adfb3f581
--- /dev/null
+++ b/src/github/client-check-events.ts
@@ -0,0 +1,70 @@
+/**
+ * Workflow-run events of one commit's check runs (sentinel issue #177).
+ *
+ * GitHub's check-run listing names each run's check suite but not the event
+ * that started it. The Actions workflow-run listing of the same commit
+ * (`/actions/runs?head_sha=`) names each run's `event` and `check_suite_id`,
+ * so joining the two by suite tells a `push` run from a `pull_request` or
+ * `workflow_dispatch` run of the same job name. Everything here is pure and
+ * lenient: an entry that does not prove its suite, its event or the exact
+ * head is skipped, and a suite two runs claim with different events is
+ * dropped, so an event is stamped only where it is unambiguous and otherwise
+ * stays absent (unknown).
+ */
+import type { GitSha } from "../contracts/brands.ts";
+import {
+  GITHUB_CHECK_EVENT_PATTERN,
+  type GitHubCheckV1,
+} from "../contracts/ports.ts";
+
+function positiveId(value: unknown): number | null {
+  return typeof value === "number" && Number.isSafeInteger(value) && value > 0
+    ? value
+    : null;
+}
+
+function fields(item: unknown): Record<string, unknown> | null {
+  return typeof item === "object" && item !== null && !Array.isArray(item)
+    ? item as Record<string, unknown>
+    : null;
+}
+
+/** The check suite one raw check-run entry names (`check_suite.id`), or null. */
+export function checkRunSuite(item: unknown): number | null {
+  const suite = fields(fields(item)?.check_suite);
+  return suite === null ? null : positiveId(suite.id);
+}
+
+/** Suite id to event over raw workflow-run entries of exactly `head`. */
+export function workflowRunEvents(
+  items: readonly unknown[],
+  head: GitSha,
+): Map<number, string> {
+  const events = new Map<number, string>();
+  const ambiguous = new Set<number>();
+  for (const item of items) {
+    const run = fields(item);
+    if (run === null || run.head_sha !== head) continue;
+    const suite = positiveId(run.check_suite_id);
+    const event = run.event;
+    if (
+      suite === null || typeof event !== "string" ||
+      !GITHUB_CHECK_EVENT_PATTERN.test(event)
+    ) continue;
+    const known = events.get(suite);
+    if (known !== undefined && known !== event) ambiguous.add(suite);
+    events.set(suite, event);
+  }
+  for (const suite of ambiguous) events.delete(suite);
+  return events;
+}
+
+/** `check` carrying the event its suite proves, or `check` unchanged. */
+export function withRunEvent(
+  check: GitHubCheckV1,
+  suite: number | null,
+  events: ReadonlyMap<number, string>,
+): GitHubCheckV1 {
+  const event = suite === null ? undefined : events.get(suite);
+  return event === undefined ? check : { ...check, event };
+}
