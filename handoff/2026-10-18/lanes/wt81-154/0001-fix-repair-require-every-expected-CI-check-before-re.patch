+  // Once verify-artifact exists the same marker merges H1 at exactly T.
+  rig.github.checksByHead.set(H1, liveGapChecks("complete", H1, T0));
+  rig.clock.advance(60_000);
+  await runOnce(rig);
+  [record] = (await rig.snapshot()).work;
