diff --git a/src/github/client-ci-evidence-log.ts b/src/github/client-ci-evidence-log.ts
new file mode 100644
index 0000000000..731936f3af
--- /dev/null
+++ b/src/github/client-ci-evidence-log.ts
@@ -0,0 +1,159 @@
+/**
+ * Bounded streaming read of one signed Actions job log for CI failure
+ * evidence. The signed URL was validated against the fixed results host
+ * (`trustedActionsLogUrl`) and is fetched with no credential, only a `range`
+ * header. The log is read in explicit `bytes=start-end` chunks (the results
+ * host honors explicit ranges and ignores suffix ranges) and fed to the
+ * streaming scanner, so a large log never has to fit one response: the first
+ * `MAX_CI_LOG_SCAN_BYTES` are scanned, then only the last
+ * `CI_LOG_TAIL_BYTES`, with the gap marked. A host that ignores Range is used
+ * when its whole body fits both the transport's body bound and the scan
+ * bound, and refused as `oversize` when not.
+ * A fired deadline, a refused request or a failed transfer keeps what was
+ * already scanned and reports why it stopped.
+ */
+import {
+  type DeadlineV1,
+  HTTP_BODY_BOUND_ERROR,
+  type HttpResponseV1,
+  type HttpTransportV1,
+} from "./http.ts";
+import {
+  CiLogScanner,
+  type CiScannedLogV1,
+} from "../repair/ci-evidence-excerpt.ts";
+import {
+  CI_LOG_CHUNK_BYTES,
+  CI_LOG_TAIL_BYTES,
+  type CiEvidenceReasonV1,
+  MAX_CI_LOG_SCAN_BYTES,
+} from "../repair/ci-evidence-types.ts";
+
+export interface SignedLogReadV1 {
+  log: CiScannedLogV1 | null;
+  /** Only the start and the end of the log were read. */
+  truncated: boolean;
+  reason: CiEvidenceReasonV1 | null;
+}
+
+const CONTENT_RANGE = /^bytes (\d+)-(\d+)\/(\d+|\*)$/;
+
+class LogReadStop extends Error {
+  constructor(readonly reason: CiEvidenceReasonV1) {
+    super(reason);
+  }
+}
+
+function bodyBytes(response: HttpResponseV1): Uint8Array {
+  return response.bodyBytes ?? new TextEncoder().encode(response.bodyText);
+}
+
+function signedStatusReason(status: number): CiEvidenceReasonV1 {
+  if (status === 403 || status === 410) return "expired";
+  if (status === 404) return "not_found";
+  if (status === 429) return "rate_limited";
+  return "unavailable";
+}
+
+export async function readSignedCiLog(input: {
+  http: HttpTransportV1;
+  url: string;
+  deadline: DeadlineV1;
+  /** Counts one request against the collection's bound; false refuses it. */
+  takeRequest: () => boolean;
+}): Promise<SignedLogReadV1> {
+  const scanner = new CiLogScanner();
+  let offset = 0;
+  let truncated = false;
+  const fetchRange = async (start: number, end: number) => {
+    if (input.deadline.fired()) throw new LogReadStop("timeout");
+    if (!input.takeRequest()) throw new LogReadStop("request_bound");
+    const call = Promise.resolve().then(() =>
+      input.http({
+        method: "GET",
+        url: input.url,
+        headers: new Map([["range", `bytes=${start}-${end}`]]),
+        body: null,
+        redirect: "error",
+        responseType: "bytes",
+      })
+    );
+    call.catch(() => {});
+    return await input.deadline.race(call);
+  };
+  const ranged = (response: HttpResponseV1, start: number, end: number) => {
+    if (response.status !== 206) {
+      throw new LogReadStop(signedStatusReason(response.status));
+    }
+    const match = CONTENT_RANGE.exec(
+      response.headers.get("content-range") ?? "",
+    );
+    const bytes = bodyBytes(response);
+    if (match === null) throw new LogReadStop("malformed");
+    const first = Number(match[1]);
+    const last = Number(match[2]);
+    if (
+      first !== start || last < first || last > end ||
+      bytes.length !== last - first + 1
+    ) throw new LogReadStop("malformed");
+    return {
+      bytes,
+      next: last + 1,
+      total: match[3] === "*" ? null : Number(match[3]),
+    };
+  };
+  const done = (reason: CiEvidenceReasonV1 | null = null) => ({
+    log: scanner.finish(),
+    truncated,
+    reason,
+  });
+  try {
+    for (;;) {
+      const end = offset + CI_LOG_CHUNK_BYTES - 1;
+      const response = await fetchRange(offset, end);
+      if (response.status === 200 && offset === 0) {
+        const bytes = bodyBytes(response);
+        if (bytes.length > MAX_CI_LOG_SCAN_BYTES) {
+          return { log: null, truncated: false, reason: "oversize" };
+        }
+        scanner.pushBytes(bytes);
+        return done();
+      }
+      if (response.status === 416 && offset === 0) return done();
+      const chunk = ranged(response, offset, end);
+      scanner.pushBytes(chunk.bytes);
+      offset = chunk.next;
+      if (chunk.total !== null && offset >= chunk.total) return done();
+      if (chunk.total === null && chunk.bytes.length < CI_LOG_CHUNK_BYTES) {
+        return done();
+      }
+      if (offset < MAX_CI_LOG_SCAN_BYTES) continue;
+      truncated = true;
+      if (chunk.total === null) return done("oversize");
+      const tailStart = Math.max(offset, chunk.total - CI_LOG_TAIL_BYTES);
+      if (tailStart > offset) scanner.gap(tailStart - offset);
+      const tail = ranged(
+        await fetchRange(tailStart, chunk.total - 1),
+        tailStart,
+        chunk.total - 1,
+      );
+      scanner.pushBytes(tail.bytes);
+      return done();
+    }
+  } catch (error) {
+    // A host that ignores Range and sends more than the transport's body
+    // bound fails in the transport itself: that is an oversized log too.
+    const reason = input.deadline.fired()
+      ? "timeout"
+      : error instanceof LogReadStop
+      ? error.reason
+      : error instanceof Error && error.message === HTTP_BODY_BOUND_ERROR
+      ? "oversize"
+      : "unavailable";
+    return {
+      log: offset > 0 ? scanner.finish() : null,
+      truncated,
+      reason,
+    };
+  }
+}
diff --git a/src/github/client-ci-evidence-shape.ts b/src/github/client-ci-evidence-shape.ts
new file mode 100644
index 0000000000..623ab2874a
--- /dev/null
+++ b/src/github/client-ci-evidence-shape.ts
@@ -0,0 +1,107 @@
+/**
+ * Mapping of GitHub CI wire values to sanitized, bounded CI failure evidence
+ * fields (generation 81). Every string that leaves here was cleaned,
+ * repository-relative, redacted and capped; it is still untrusted text that
+ * only the fenced evidence section carries.
+ */
+import type { AnnotationWireV1 } from "./client-ci-evidence-wire.ts";
+import {
+  capChars,
+  cleanLogLine,
+  sanitizeEvidenceLine,
+  sanitizeEvidenceText,
+} from "../repair/ci-evidence-sanitize.ts";
+import {
+  type CiAnnotationV1,
+  type CiCheckEvidenceV1,
+  type CiEvidenceReasonV1,
+  MAX_CI_ANNOTATIONS,
+  MAX_CI_OUTPUT_CHARS,
+} from "../repair/ci-evidence-types.ts";
+
+const NAME_CHARS = 200;
+const LEVEL_ORDER = ["failure", "warning", "notice"];
+
+/** One untrusted name or label: one line, sanitized, at most 200 chars. */
+export function evidenceText(text: string): string {
+  return capChars(sanitizeEvidenceLine(cleanLogLine(text)), NAME_CHARS);
+}
+
+export function statusReason(
+  status: number,
+  actions: boolean,
+): CiEvidenceReasonV1 {
+  if (status === 401 || status === 403) {
+    return actions ? "forbidden_actions_read" : "forbidden";
+  }
+  if (status === 404) return "not_found";
+  if (status === 410) return "expired";
+  if (status === 429) return "rate_limited";
+  return "unavailable";
+}
+
+export function annotation(note: AnnotationWireV1): CiAnnotationV1 {
+  return {
+    path: evidenceText(note.path),
+    startLine: note.startLine,
+    endLine: note.endLine,
+    level: evidenceText(note.level),
+    title: evidenceText(note.title),
+    message: sanitizeEvidenceText(note.message, 400).replace(/\n/g, " "),
+  };
+}
+
+export function baseCheck(
+  checkName: string,
+  conclusion: string,
+  app: string | null,
+): CiCheckEvidenceV1 {
+  return {
+    name: evidenceText(checkName),
+    conclusion: evidenceText(conclusion),
+    app: app === null ? null : evidenceText(app),
+    workflow: null,
+    job: null,
+    failingSteps: [],
+    classification: "candidate",
+    classificationReason: "",
+    annotations: [],
+    excerpt: null,
+    excerptLines: null,
+    hints: [],
+    output: null,
+    unavailable: null,
+    truncatedScan: false,
+  };
+}
+
+export function output(
+  title: string,
+  summary: string,
+  text: string,
+): CiCheckEvidenceV1["output"] {
+  const cleanTitle = evidenceText(title);
+  const cleanSummary = sanitizeEvidenceText(summary, MAX_CI_OUTPUT_CHARS / 2);
+  const cleanText = sanitizeEvidenceText(
+    text,
+    Math.max(0, MAX_CI_OUTPUT_CHARS - cleanTitle.length - cleanSummary.length),
+  );
+  return { title: cleanTitle, summary: cleanSummary, text: cleanText };
+}
+
+/** At most `MAX_CI_ANNOTATIONS`, failures first, otherwise in API order. */
+export function failuresFirst(
+  notes: readonly AnnotationWireV1[],
+): CiAnnotationV1[] {
+  const rank = (level: string) => {
+    const index = LEVEL_ORDER.indexOf(level);
+    return index < 0 ? LEVEL_ORDER.length : index;
+  };
+  return notes
+    .map((note, index) => ({ note, index }))
+    .sort((a, b) =>
+      rank(a.note.level) - rank(b.note.level) || a.index - b.index
+    )
+    .slice(0, MAX_CI_ANNOTATIONS)
+    .map(({ note }) => annotation(note));
+}
diff --git a/src/github/client-ci-evidence-wire.ts b/src/github/client-ci-evidence-wire.ts
new file mode 100644
index 0000000000..228c92162d
--- /dev/null
+++ b/src/github/client-ci-evidence-wire.ts
@@ -0,0 +1,220 @@
+/**
+ * Strict parsers for the GitHub responses the CI failure evidence reader
+ * uses: check runs, commit statuses, Actions jobs and runs, and check-run
+ * annotations. Each throws on a shape it cannot trust; the reader maps that
+ * to the `malformed` reason. String values are bounded here and sanitized by
+ * the reader before they reach any prompt. Separate from `wire.ts` on
+ * purpose: the merge gate's check parser is not changed by this lane.
+ */
+const MAX_WIRE_TEXT = 70_000;
+const MAX_WIRE_NAME = 1_024;
+const MAX_PAGE_ITEMS = 100;
+const MAX_JOB_STEPS = 200;
+
+type Row = Record<string, unknown>;
+
+class CiEvidenceWireError extends Error {
+  constructor() {
+    super("CI evidence wire value is malformed");
+  }
+}
+
+function row(value: unknown): Row {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    throw new CiEvidenceWireError();
+  }
+  return value as Row;
+}
+
+function id(value: unknown): number {
+  if (typeof value !== "number" || !Number.isSafeInteger(value) || value <= 0) {
+    throw new CiEvidenceWireError();
+  }
+  return value;
+}
+
+function text(value: unknown, max = MAX_WIRE_NAME): string {
+  if (typeof value !== "string") throw new CiEvidenceWireError();
+  return value.length > max ? value.slice(0, max) : value;
+}
+
+function optionalText(value: unknown, max = MAX_WIRE_NAME): string {
+  return value === null || value === undefined ? "" : text(value, max);
+}
+
+function nullableText(value: unknown): string | null {
+  return value === null || value === undefined ? null : text(value);
+}
+
+function sha(value: unknown): string {
+  const parsed = text(value);
+  if (!/^[0-9a-f]{40}$/.test(parsed)) throw new CiEvidenceWireError();
+  return parsed;
+}
+
+function instant(value: unknown): number | null {
+  if (value === null || value === undefined) return null;
+  const parsed = Date.parse(text(value));
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+function line(value: unknown): number | null {
+  return typeof value === "number" && Number.isSafeInteger(value) && value > 0
+    ? value
+    : null;
+}
+
+function list(value: unknown, max: number): unknown[] {
+  if (!Array.isArray(value) || value.length > max) {
+    throw new CiEvidenceWireError();
+  }
+  return value;
+}
+
+export interface CheckRunWireV1 {
+  id: number;
+  name: string;
+  status: string;
+  conclusion: string | null;
+  headSha: string;
+  app: string | null;
+  startedAt: number | null;
+  output: { title: string; summary: string; text: string };
+}
+
+export function parseCheckRunsPageWire(
+  body: unknown,
+): { total: number; runs: CheckRunWireV1[] } {
+  const page = row(body);
+  const total = page.total_count;
+  if (typeof total !== "number" || !Number.isSafeInteger(total) || total < 0) {
+    throw new CiEvidenceWireError();
+  }
+  const runs = list(page.check_runs, MAX_PAGE_ITEMS).map((item) => {
+    const run = row(item);
+    const output = run.output === null || run.output === undefined
+      ? {}
+      : row(run.output);
+    const app = run.app === null || run.app === undefined ? null : row(run.app);
+    return {
+      id: id(run.id),
+      name: text(run.name),
+      status: text(run.status),
+      conclusion: nullableText(run.conclusion),
+      headSha: sha(run.head_sha),
+      app: app === null ? null : nullableText(app.slug),
+      startedAt: instant(run.started_at),
+      output: {
+        title: optionalText(output.title),
+        summary: optionalText(output.summary, MAX_WIRE_TEXT),
+        text: optionalText(output.text, MAX_WIRE_TEXT),
+      },
+    };
+  });
+  return { total, runs };
+}
+
+export interface StatusWireV1 {
+  context: string;
+  state: string;
+  description: string;
+}
+
+export function parseStatusesWire(body: unknown): StatusWireV1[] {
+  return list(body, MAX_PAGE_ITEMS).map((item) => {
+    const status = row(item);
+    return {
+      context: text(status.context),
+      state: text(status.state),
+      description: optionalText(status.description),
+    };
+  });
+}
+
+export interface JobStepWireV1 {
+  number: number;
+  name: string;
+  status: string;
+  conclusion: string | null;
+}
+
+export interface JobWireV1 {
+  id: number;
+  runId: number;
+  headSha: string;
+  name: string;
+  workflowName: string | null;
+  status: string;
+  conclusion: string | null;
+  steps: JobStepWireV1[];
+}
+
+export function parseJobWire(body: unknown): JobWireV1 {
+  const job = row(body);
+  const steps = job.steps === null || job.steps === undefined
+    ? []
+    : list(job.steps, MAX_JOB_STEPS);
+  return {
+    id: id(job.id),
+    runId: id(job.run_id),
+    headSha: sha(job.head_sha),
+    name: text(job.name),
+    workflowName: nullableText(job.workflow_name),
+    status: text(job.status),
+    conclusion: nullableText(job.conclusion),
+    steps: steps.map((item) => {
+      const step = row(item);
+      const number = step.number;
+      if (
+        typeof number !== "number" || !Number.isSafeInteger(number) ||
+        number < 0
+      ) throw new CiEvidenceWireError();
+      return {
+        number,
+        name: text(step.name),
+        status: text(step.status),
+        conclusion: nullableText(step.conclusion),
+      };
+    }),
+  };
+}
+
+export interface RunWireV1 {
+  id: number;
+  name: string | null;
+  path: string | null;
+  headSha: string;
+}
+
+export function parseRunWire(body: unknown): RunWireV1 {
+  const run = row(body);
+  return {
+    id: id(run.id),
+    name: nullableText(run.name),
+    path: nullableText(run.path),
+    headSha: sha(run.head_sha),
+  };
+}
+
+export interface AnnotationWireV1 {
+  path: string;
+  startLine: number | null;
+  endLine: number | null;
+  level: string;
+  title: string;
+  message: string;
+}
+
+export function parseAnnotationsWire(body: unknown): AnnotationWireV1[] {
+  return list(body, MAX_PAGE_ITEMS).map((item) => {
+    const note = row(item);
+    return {
+      path: optionalText(note.path),
+      startLine: line(note.start_line),
+      endLine: line(note.end_line),
+      level: optionalText(note.annotation_level),
+      title: optionalText(note.title),
+      message: optionalText(note.message, MAX_WIRE_TEXT),
+    };
+  });
+}
diff --git a/src/github/client-ci-evidence.ts b/src/github/client-ci-evidence.ts
new file mode 100644
index 0000000000..01c37541a9
--- /dev/null
+++ b/src/github/client-ci-evidence.ts
@@ -0,0 +1,488 @@
+/**
+ * Trusted, read-only collector of CI failure evidence for one candidate head
+ * of the client's own target repository (generation 81).
+ *
+ * Every API path is `/repos/{target}/...` through `sendCore`, so the durable
+ * cooldown gate, the authorization header and the per-request deadline apply
+ * exactly as for every other read, and a matrix cell's gate records nothing.
+ * Per failing check: identity (name, conclusion, app), and for an Actions job
+ * the workflow (name and file path), the job and its failing steps, the
+ * check-run annotations and a bounded excerpt of the job log, read through the
+ * signed-log redirect with the fixed trusted host check and no credential.
+ * Another app's check run contributes its output and annotations; a commit
+ * status its description. Requests, bytes and time are bounded, the method
+ * never throws, and any failure degrades to a reason code with whatever was
+ * already collected.
+ */
+import { isGitSha } from "../contracts/brands.ts";
+import type { HttpResponseV1 } from "./http.ts";
+import { createDeadline, type DeadlineV1 } from "./http.ts";
+import { GitHubClientNativeCi } from "./client-native-ci.ts";
+import { repoPath } from "./client-response.ts";
+import { trustedActionsLogUrl } from "./client-hosted-log-wire.ts";
+import {
+  type CheckRunWireV1,
+  type JobWireV1,
+  parseAnnotationsWire,
+  parseCheckRunsPageWire,
+  parseJobWire,
+  parseRunWire,
+  parseStatusesWire,
+  type RunWireV1,
+} from "./client-ci-evidence-wire.ts";
+import {
+  baseCheck,
+  evidenceText,
+  failuresFirst,
+  output,
+  statusReason,
+} from "./client-ci-evidence-shape.ts";
+import {
+  readSignedCiLog,
+  type SignedLogReadV1,
+} from "./client-ci-evidence-log.ts";
+import { excerptFromLog } from "../repair/ci-evidence-excerpt.ts";
+import { classifyCheck, extractHints } from "../repair/ci-evidence-classify.ts";
+import { ciExcerptShare } from "../repair/ci-evidence-render.ts";
+import {
+  type CiAnnotationV1,
+  type CiCheckEvidenceV1,
+  type CiEvidenceReaderV1,
+  type CiEvidenceReadInputV1,
+  type CiEvidenceReasonV1,
+  type CiEvidenceV1,
+  type CiFailingStepV1,
+  emptyCiEvidence,
+  MAX_CI_EVIDENCE_CHECKS,
+  MAX_CI_EVIDENCE_COLLECTION_MS,
+  MAX_CI_EVIDENCE_REQUESTS,
+  MAX_CI_FAILING_STEPS,
+  MAX_CI_LOG_CHECKS,
+} from "../repair/ci-evidence-types.ts";
+
+const CHECK_PAGES = 3;
+const PAGE_SIZE = 100;
+const ANNOTATION_PAGE = 50;
+const ACTIONS_APP = "github-actions";
+/** Failing check-run conclusions, most relevant first. */
+const FAILING = [
+  "failure",
+  "timed_out",
+  "startup_failure",
+  "cancelled",
+  "action_required",
+  "stale",
+];
+const FAILING_STEP = ["failure", "timed_out", "cancelled", "startup_failure"];
+
+type Got =
+  | { ok: true; response: HttpResponseV1 }
+  | { ok: false; reason: CiEvidenceReasonV1 };
+
+interface CollectionV1 {
+  head: string;
+  deadline: DeadlineV1;
+  requests: number;
+  runs: Map<number, RunWireV1 | null>;
+  /** A rate limit stops every later API read of this collection. */
+  stopped: CiEvidenceReasonV1 | null;
+}
+
+export abstract class GitHubClientCiEvidence extends GitHubClientNativeCi
+  implements CiEvidenceReaderV1 {
+  async readCiFailureEvidence(
+    input: CiEvidenceReadInputV1,
+  ): Promise<CiEvidenceV1> {
+    if (!isGitSha(input.head) || !isGitSha(input.base)) {
+      return emptyCiEvidence(input.head, input.base, "malformed");
+    }
+    const bound = Number.isFinite(input.deadlineMs)
+      ? Math.max(1, Math.min(input.deadlineMs, MAX_CI_EVIDENCE_COLLECTION_MS))
+      : 1;
+    const collection: CollectionV1 = {
+      head: input.head,
+      deadline: createDeadline(bound),
+      requests: 0,
+      runs: new Map(),
+      stopped: null,
+    };
+    const evidence = emptyCiEvidence(input.head, input.base, null);
+    try {
+      await this.collectCiEvidence(input, collection, evidence);
+    } catch {
+      evidence.unavailable = collection.deadline.fired()
+        ? "timeout"
+        : "unavailable";
+    } finally {
+      collection.deadline.dispose();
+    }
+    return evidence;
+  }
+
+  private async collectCiEvidence(
+    input: CiEvidenceReadInputV1,
+    collection: CollectionV1,
+    evidence: CiEvidenceV1,
+  ): Promise<void> {
+    const runs: CheckRunWireV1[] = [];
+    for (let page = 1; page <= CHECK_PAGES; page++) {
+      const got = await this.ciGet(
+        collection,
+        `/commits/${input.head}/check-runs`,
+        { per_page: String(PAGE_SIZE), page: String(page), filter: "latest" },
+      );
+      const body = this.ciBody(got, false);
+      if (!body.ok) {
+        evidence.unavailable = body.reason;
+        return;
+      }
+      const parsed = parseCheckRunsPageWire(body.value);
+      runs.push(...parsed.runs.filter((run) => run.headSha === input.head));
+      if (parsed.runs.length < PAGE_SIZE || runs.length >= parsed.total) break;
+    }
+    const latest = new Map<string, CheckRunWireV1>();
+    for (const run of runs) {
+      const previous = latest.get(run.name);
+      if (
+        previous === undefined ||
+        (run.startedAt ?? -1) > (previous.startedAt ?? -1)
+      ) latest.set(run.name, run);
+    }
+    const prefer = input.prefer ?? (() => false);
+    const rank = (run: CheckRunWireV1) =>
+      (prefer(run.name) ? 0 : 100) + FAILING.indexOf(run.conclusion ?? "");
+    const failing = [...latest.values()]
+      .filter((run) =>
+        run.status === "completed" && FAILING.includes(run.conclusion ?? "")
+      )
+      .sort((a, b) => rank(a) - rank(b));
+    const statuses = await this.ciFailingStatuses(collection, input.head);
+    const total = failing.length + statuses.length;
+    const selected = failing.slice(0, MAX_CI_EVIDENCE_CHECKS);
+    const statusRoom = MAX_CI_EVIDENCE_CHECKS - selected.length;
+    const shownStatuses = statuses.slice(0, Math.max(0, statusRoom));
+    evidence.omittedChecks = total - selected.length - shownStatuses.length;
+    const count = selected.length + shownStatuses.length;
+    if (count === 0) {
+      evidence.unavailable = "no_failing_checks";
+      return;
+    }
+    let logs = 0;
+    for (const run of selected) {
+      if (collection.deadline.fired() || collection.stopped !== null) {
+        // Out of time or rate limited: the checks not reached are counted,
+        // never invented.
+        evidence.unavailable = collection.stopped ?? "timeout";
+        evidence.omittedChecks += count - evidence.checks.length;
+        return;
+      }
+      const actions = run.app === ACTIONS_APP;
+      const withLog = actions && logs < MAX_CI_LOG_CHECKS;
+      if (withLog) logs++;
+      evidence.checks.push(
+        actions
+          ? await this.ciActionsCheck(collection, run, count, withLog)
+          : await this.ciExternalCheck(collection, run),
+      );
+    }
+    for (const status of shownStatuses) {
+      const check = baseCheck(status.context, status.state, null);
+      check.output = output("", status.description, "");
+      const label = classifyCheck({
+        conclusion: status.state,
+        external: true,
+        failingSteps: null,
+        log: null,
+      });
+      check.classification = label.classification;
+      check.classificationReason = label.reason;
+      evidence.checks.push(check);
+    }
+    if (collection.stopped !== null) evidence.unavailable = collection.stopped;
+  }
+
+  private async ciFailingStatuses(
+    collection: CollectionV1,
+    head: string,
+  ) {
+    // Best effort: a credential without commit-status read just has none.
+    const got = await this.ciGet(collection, `/commits/${head}/statuses`, {
+      per_page: String(PAGE_SIZE),
+    });
+    const body = this.ciBody(got, false);
+    if (!body.ok) return [];
+    try {
+      const seen = new Set<string>();
+      return parseStatusesWire(body.value).filter((status) => {
+        // Newest first: only each context's latest state counts.
+        if (seen.has(status.context)) return false;
+        seen.add(status.context);
+        return status.state === "failure" || status.state === "error";
+      });
+    } catch {
+      return [];
+    }
+  }
+
+  private async ciActionsCheck(
+    collection: CollectionV1,
+    run: CheckRunWireV1,
+    count: number,
+    withLog: boolean,
+  ): Promise<CiCheckEvidenceV1> {
+    const check = baseCheck(run.name, run.conclusion ?? "", run.app);
+    let job: JobWireV1 | null = null;
+    let failingSteps: CiFailingStepV1[] | null = null;
+    const jobBody = this.ciBody(
+      await this.ciGet(collection, `/actions/jobs/${run.id}`),
+      true,
+    );
+    if (!jobBody.ok) {
+      check.unavailable = jobBody.reason;
+    } else {
+      const parsed = this.ciParse(() => parseJobWire(jobBody.value));
+      if (parsed === null) check.unavailable = "malformed";
+      else if (parsed.id !== run.id || parsed.headSha !== collection.head) {
+        check.unavailable = "head_mismatch";
+      } else {
+        job = parsed;
+        check.job = { id: parsed.id, name: evidenceText(parsed.name) };
+        failingSteps = parsed.steps
+          .filter((step) => FAILING_STEP.includes(step.conclusion ?? ""))
+          .slice(0, MAX_CI_FAILING_STEPS)
+          .map((step) => ({
+            number: step.number,
+            name: evidenceText(step.name),
+            conclusion: evidenceText(step.conclusion ?? ""),
+          }));
+        check.failingSteps = failingSteps;
+        const workflow = withLog
+          ? await this.ciRun(collection, parsed.runId)
+          : null;
+        const workflowName = workflow?.name ?? parsed.workflowName;
+        if (workflowName !== null) {
+          check.workflow = {
+            name: evidenceText(workflowName),
+            path: workflow?.path === null || workflow?.path === undefined
+              ? null
+              : evidenceText(workflow.path),
+          };
+        }
+      }
+    }
+    check.annotations = await this.ciAnnotations(collection, run.id);
+    let log = null;
+    if (withLog && job !== null) {
+      const read = await this.ciJobLog(collection, job.id);
+      log = read.log;
+      check.truncatedScan = read.truncated;
+      if (read.reason !== null) check.unavailable = read.reason;
+      if (log !== null) {
+        check.hints = extractHints(log.steps);
+        const excerpt = excerptFromLog(log, ciExcerptShare(check, count));
+        if (excerpt !== null) {
+          check.excerpt = excerpt.text;
+          check.excerptLines = { kept: excerpt.kept, total: excerpt.total };
+        }
+      }
+    }
+    const label = classifyCheck({
+      conclusion: run.conclusion ?? "",
+      external: false,
+      failingSteps,
+      log,
+    });
+    check.classification = label.classification;
+    check.classificationReason = label.reason;
+    return check;
+  }
+
+  private async ciExternalCheck(
+    collection: CollectionV1,
+    run: CheckRunWireV1,
+  ): Promise<CiCheckEvidenceV1> {
+    const check = baseCheck(run.name, run.conclusion ?? "", run.app);
+    check.output = output(
+      run.output.title,
+      run.output.summary,
+      run.output.text,
+    );
+    check.annotations = await this.ciAnnotations(collection, run.id);
+    const label = classifyCheck({
+      conclusion: run.conclusion ?? "",
+      external: true,
+      failingSteps: null,
+      log: null,
+    });
+    check.classification = label.classification;
+    check.classificationReason = label.reason;
+    return check;
+  }
+
+  private async ciRun(
+    collection: CollectionV1,
+    runId: number,
+  ): Promise<RunWireV1 | null> {
+    if (collection.runs.has(runId)) return collection.runs.get(runId) ?? null;
+    const body = this.ciBody(
+      await this.ciGet(collection, `/actions/runs/${runId}`),
+      true,
+    );
+    const run = body.ok ? this.ciParse(() => parseRunWire(body.value)) : null;
+    const trusted = run !== null && run.id === runId &&
+        run.headSha === collection.head
+      ? run
+      : null;
+    collection.runs.set(runId, trusted);
+    return trusted;
+  }
+
+  private async ciAnnotations(
+    collection: CollectionV1,
+    checkRunId: number,
+  ): Promise<CiAnnotationV1[]> {
+    const body = this.ciBody(
+      await this.ciGet(collection, `/check-runs/${checkRunId}/annotations`, {
+        per_page: String(ANNOTATION_PAGE),
+      }),
+      false,
+    );
+    if (!body.ok) return [];
+    return failuresFirst(
+      this.ciParse(() => parseAnnotationsWire(body.value)) ?? [],
+    );
+  }
+
+  private async ciJobLog(
+    collection: CollectionV1,
+    jobId: number,
+  ): Promise<SignedLogReadV1> {
+    const got = await this.ciGet(
+      collection,
+      `/actions/jobs/${jobId}/logs`,
+      {},
+      "manual",
+    );
+    if (!got.ok) {
+      return {
+        log: null,
+        truncated: false,
+        reason: got.reason === "forbidden"
+          ? "forbidden_actions_read"
+          : got.reason,
+      };
+    }
+    const status = got.response.status;
+    if (status !== 302) {
+      return {
+        log: null,
+        truncated: false,
+        reason: status >= 300 && status < 400
+          ? "untrusted_redirect"
+          : status === 200
+          ? "malformed"
+          : statusReason(status, true),
+      };
+    }
+    const location = got.response.headers.get("location");
+    const signed = location === null ? null : trustedActionsLogUrl(location);
+    if (signed === null) {
+      return {
+        log: null,
+        truncated: false,
+        reason: "untrusted_redirect",
+      };
+    }
+    return await readSignedCiLog({
+      http: this.options.http,
+      url: signed,
+      deadline: collection.deadline,
+      takeRequest: () => {
+        if (collection.requests >= MAX_CI_EVIDENCE_REQUESTS) return false;
+        collection.requests++;
+        return true;
+      },
+    });
+  }
+
+  private ciParse<T>(parse: () => T): T | null {
+    try {
+      return parse();
+    } catch {
+      return null;
+    }
+  }
+
+  /** One JSON 200 body, or the reason it is not available. */
+  private ciBody(
+    got: Got,
+    actions: boolean,
+  ): { ok: true; value: unknown } | { ok: false; reason: CiEvidenceReasonV1 } {
+    if (!got.ok) {
+      return {
+        ok: false,
+        reason: actions && got.reason === "forbidden"
+          ? "forbidden_actions_read"
+          : got.reason,
+      };
+    }
+    if (got.response.status !== 200) {
+      return { ok: false, reason: statusReason(got.response.status, actions) };
+    }
+    try {
+      return { ok: true, value: JSON.parse(got.response.bodyText) };
+    } catch {
+      return { ok: false, reason: "malformed" };
+    }
+  }
+
+  /** One repository-scoped, gated, credentialed GET within the bounds. */
+  private async ciGet(
+    collection: CollectionV1,
+    path: string,
+    query: Record<string, string> = {},
+    redirect?: "manual",
+  ): Promise<Got> {
+    if (collection.deadline.fired()) return { ok: false, reason: "timeout" };
+    if (collection.stopped !== null) {
+      return { ok: false, reason: collection.stopped };
+    }
+    if (collection.requests >= MAX_CI_EVIDENCE_REQUESTS) {
+      return { ok: false, reason: "request_bound" };
+    }
+    collection.requests++;
+    const queryText = new URLSearchParams(query).toString();
+    const raw = await this.sendCore(
+      "GET",
+      `${this.apiBaseUrl}/repos/${repoPath(this.repository)}${path}${
+        queryText.length === 0 ? "" : `?${queryText}`
+      }`,
+      null,
+      redirect,
+      collection.deadline,
+    );
+    if (raw.status === "response") {
+      // An unclassified 429 is still a rate limit: nothing more is asked.
+      if (raw.response.status === 429) collection.stopped = "rate_limited";
+      return { ok: true, response: raw.response };
+    }
+    if (collection.deadline.fired() || raw.status === "lost") {
+      return {
+        ok: false,
+        reason: collection.deadline.fired() ? "timeout" : "unavailable",
+      };
+    }
+    const kind = raw.error.kind;
+    if (kind === "rate_limited") collection.stopped = "rate_limited";
+    return {
+      ok: false,
+      reason: kind === "rate_limited"
+        ? "rate_limited"
+        : kind === "auth_failed"
+        ? "forbidden"
+        : kind === "not_found"
+        ? "not_found"
+        : "unavailable",
+    };
+  }
+}
