+  return {
+    coverage,
+    read: (start, end) =>
+      run("journalctl", ["--unit=ai-ubq-fi.service", `--since=@${start / 1000}`, `--until=@${end / 1000}`, "--output=json", "--no-pager"], root),
+  };
+}
+const MAX_JOURNAL_BYTES = 1024 * 1024;
+const MAX_ENTRIES = 8192;
+type Event = {
+  id: string;
+  at: number;
+  accepted: boolean;
+  status: number;
