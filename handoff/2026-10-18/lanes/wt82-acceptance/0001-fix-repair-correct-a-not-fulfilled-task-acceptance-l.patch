+        assert.equal(
+          record.blocker?.message,
+          TASK_ACCEPTANCE_OWNER_GATE_DETAIL,
+        );
+        const rig = await r80Rig(r80, "park", state.snapshot, state.now);
+        try {
+          const outcome = await rig.run();
