+      purpose: "continuation",
+      head: BASE,
+      attempt: 100 + pad,
+    }));
+  }
+  const attempts = Math.max(
+    1,
+    ...reservations.filter((row) =>
+      row.purpose === "implementation" || row.purpose === "retry"
+    ).map((row) => row.attempt),
+  );
