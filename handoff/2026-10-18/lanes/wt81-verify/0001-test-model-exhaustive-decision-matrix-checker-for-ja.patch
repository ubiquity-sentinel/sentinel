+      case "impl_ambiguous":
+      case "impl_reserved":
+        return {
+          kind: "implementation",
+          key: operationKey,
+          startedAt: NOW - 9 * DAY,
+          branch,
+          expectedHead: null,
+          observedBase: BASE,
+          pr: null,
+          requestId: implChargeId,
+          resultId: null,
+        };
+      case "preservation":
+        return {
+          kind: "candidate_preservation",
+          key: operationKey,
+          startedAt: NOW - 9 * DAY,
+          branch: ref,
+          expectedHead: candidateHead,
+          observedBase: BASE,
+          pr: null,
+          requestId: implChargeId,
+          resultId: null,
+        };
