+
+/** The live 1127 cell and its completed-past-bound result (live facts). */
+async function overrunCell(): Promise<{
+  cell: MatrixCellPlanV1;
+  result: MatrixCellResultV1;
+}> {
+  const record = LIVE.work.find((row) => row.id === OVER)!;
