+          kind: "review_request",
+          key: reviewOperationKey(pr, head ?? HEAD, shape.rounds + 1),
+          startedAt: NOW - 2 * DAY,
+          branch,
+          expectedHead: head ?? HEAD,
+          observedBase: BASE,
+          pr,
+          requestId: reviewChargeId,
+          resultId: null,
